---
// The <head> items seo-checklist requires on every page: title, description, canonical, hreflang,
// Open Graph, Twitter and JSON-LD. Pages hand BaseLayout the data; nothing else writes these tags.
// No robots meta: the site is kept out of search engines by public/_headers and robots.txt only.
import type { LocaleLink } from '../../lib/i18n/alternates';
import type { Locale } from '../../lib/i18n/locales';
import { localeFromPath, normalizePath } from '../../lib/i18n/paths';
import { hreflangAlternates } from '../../lib/seo/hreflang';
import { serializeJsonLd, type JsonLdGraph } from '../../lib/seo/jsonld/shared';
import { canonicalUrl, pageTitle, siteName } from '../../lib/seo/meta';
import { DEFAULT_OG_IMAGE, type OgImage } from '../../lib/seo/og';

export interface Props {
  // The page topic; the site name is appended unless titleSuffix is false (the home page)
  title: string;
  titleSuffix?: boolean;
  description: string;
  // Falls back to the site-wide default (content-model.md `ogImage`)
  image?: OgImage;
  type?: 'website' | 'article';
  jsonLd?: JsonLdGraph;
  // This page's locale versions (pageLocales() in src/lib/i18n/routes.ts, computed by BaseLayout)
  locales: readonly LocaleLink[];
}

const { title, titleSuffix = true, description, image: pageImage, type = 'website', jsonLd, locales } = Astro.props;
if (!Astro.site) throw new Error('astro.config.mjs must set site for canonical and og:url');
const site = Astro.site;
// canonical URLs have no .html, /index or trailing slash; the locale comes from the URL prefix (ADR 0002)
const pathname = normalizePath(Astro.url.pathname);
const locale = localeFromPath(pathname);
const fullTitle = titleSuffix ? pageTitle(title, locale) : title;
const canonical = canonicalUrl(pathname, site);
// og:locale is language_TERRITORY (ADR 0002); the current site writes none to follow
const OG_LOCALES: Record<Locale, string> = { 'zh-TW': 'zh_TW', en: 'en_US', vi: 'vi_VN' };
const ogLocale = OG_LOCALES[locale];
// The default image is the company logo, named in the page's language
const image = pageImage ?? { ...DEFAULT_OG_IMAGE, alt: siteName(locale) };
const imageUrl = new URL(image.src, site).href;
const alternates = hreflangAlternates(locales, site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content={siteName(locale)} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={image.alt} />
{jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
