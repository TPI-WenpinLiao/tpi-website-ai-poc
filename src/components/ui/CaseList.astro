---
// Cases as rows (#187, design-principles.md「案例列」and the「成果」layout): one row a case, the client
// first in the bold serif, the work, its result when the fact library has one (numbers in bold, the
// condition tight under it), an award on the row of the case that won it, and the link, its label
// naming the client. Rows are set apart by space, no frames or equal cards; the first can be larger,
// with a fragment of the work beside it (the `fragment` slot of the first row, or each row's own
// `fragment` given as a UiFragment props object).
// A result without a fact is left out, never written in. `more` is the link to the full list.
// `image` is a tall decorative picture beside the rows from --bp-lg-up (docs/design/image-prompts.md);
// with it a row's fragment goes under the row's text instead of beside it.
import UiFragment from './UiFragment.astro';
import Link from './Link.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Fragment {
  title: string;
  tabs?: readonly string[] | undefined;
  rows: readonly { label: string; value?: string | undefined; state?: 'on' | 'off' | 'down' | 'next' | undefined }[];
  note?: string | undefined;
}

interface Item {
  // The client or, in the results layout, the work's name
  title?: string | undefined;
  // A line under the title (the model behind the work)
  sub?: string | undefined;
  work?: string | undefined;
  result?: string | undefined;
  award?: string | undefined;
  link?: { label: string; href: string } | undefined;
  fragment?: Fragment | undefined;
}

interface Props {
  items: readonly Item[];
  level?: 3 | 4;
  more?: { label: string; href: string } | undefined;
  // The 示意 mark of the fragments, in the page's language
  mark: string;
  // The first row larger (cases); the results layout keeps every row the same
  lead?: boolean;
  image?: ImageMetadata | undefined;
}

const { items, level = 3, more, mark, lead = true, image } = Astro.props;
const Heading = `h${level}` as const;
// Numbers in a result stand out; the text is the fact as it is
const emphasize = (text: string) =>
  text.split(/(\d[\d,.]*\s?%?)/).map((part, i) => (i % 2 === 1 ? { strong: true, part } : { strong: false, part }));
---

<div class:list={['case-list', { 'with-image': image }]}>
  {image && <Image class="picture" src={image} widths={[480, 960]} sizes="(width >= 64rem) 24rem, 100vw" alt="" loading="lazy" />}
  <ol class="rows">
    {
      items.map((c, i) => (
        <li class:list={['row', { lead: lead && i === 0, 'has-fragment': c.fragment }]}>
          <div class="text">
            {c.title && <Heading class="title serif">{c.title}</Heading>}
            {c.sub && <p class="sub">{c.sub}</p>}
            {c.work && <p class="work">{c.work}</p>}
            {c.result && (
              <p class="result">
                {emphasize(c.result).map((p) => (p.strong ? <strong>{p.part}</strong> : p.part))}
              </p>
            )}
            {c.award && <p class="award">{c.award}</p>}
            {c.link && (
              <Link href={c.link.href} variant="standalone">
                {c.link.label}
              </Link>
            )}
          </div>
          {c.fragment && (
            <div class="fragment">
              <UiFragment {...c.fragment} mark={mark} />
            </div>
          )}
        </li>
      ))
    }
  </ol>
  {
    more && (
      <div class="more">
        <Link href={more.href} variant="standalone">
          {more.label}
        </Link>
      </div>
    )
  }
</div>

<style>
  @import '../../styles/media.css';

  .case-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-10);
  }

  .rows {
    display: grid;
    gap: var(--space-12);
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-inline-size: var(--reading-max-width);
  }

  .title {
    margin: 0;
    font-size: var(--font-size-text);
    line-height: var(--line-height-snug);
  }

  .sub,
  .award {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .work,
  .result {
    margin: 0;
  }

  .lead .result {
    font-size: var(--font-size-text);
  }

  .picture {
    display: none;
  }

  @media (--bp-lg-up) {
    /* The picture holds the right-hand columns while the rows run down the left */
    .with-image {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--grid-gutter);
      align-items: start;
    }

    .with-image > .rows,
    .with-image > .more {
      grid-column: 1 / 8;
    }

    .with-image > .more {
      grid-row: 2;
      margin-block-start: var(--space-10);
    }

    .with-image > .picture {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-8));
      display: block;
      grid-row: 1 / span 2;
      grid-column: 9 / -1;
      inline-size: 100%;
      block-size: auto;
    }

    .with-image .rows {
      grid-row: 1;
    }

    .row.has-fragment:not(.with-image *) {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      gap: var(--grid-gutter);
    }

    .has-fragment:not(.with-image *) .text {
      grid-column: 1 / 7;
    }

    .has-fragment:not(.with-image *) .fragment {
      grid-column: 8 / -1;
    }
  }
</style>
