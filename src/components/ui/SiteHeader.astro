---
// Site header (M3-04, #17): brand, the first-level menu, search, locale and the 聯絡我們 button,
// all from docs/ia/navigation.csv (src/lib/ia/navigation.ts). Sticky on the white paper of the page
// (ribbon-route, #167). The symbol logo keeps the bar's measured widths (docs/design/nav-fit.md);
// the footer shows the full logo.
// While a purple band (any data-surface="dark" section: OrientAI, contact, ContactCta) or the
// footer is under the header's bottom edge, the header switches to the dark surface too (#179): the
// script sets its data-surface, so every token below it, the focus ring included, follows; the logo
// swaps to the white symbol. Over the footer (data-depth="deep") it also takes the footer's
// near-black --color-bg-deep, so it doesn't draw a purple bar on it (#212). The dropdowns, search box and 選單 sheet stay light panels (data-surface="light").
// From 64rem a page's InPageNav stuck under the header switches with it, as one bar.
// `surface` fixes the header to one surface instead, for the /design-system previews.
// Menus are native <details> disclosures sharing one `name`, so opening one closes the others
// without client JS. A small script closes the open menu on a click outside it, and on Esc (focus
// goes back to its summary). The rest of the keyboard model is M4-04's.
// The search button opens a search box in the same group (M6-02, #34): a GET form to the locale's
// /search page, where SearchResults loads Pagefind; the header itself loads nothing for search, the
// script only moves focus into the field when the box opens.
// The language menu lists the page's locale versions (`locales`, from PageLayout; pageLocales()
// for a static page), the same entries as LocaleSwitcher and hreflang (ADR 0002): locales without
// a built page or home are left out, so it doesn't render while zh-TW is the only one. Every other
// link goes to the page in the current locale.
// Below 64rem the menu collapses behind one 選單 disclosure that lists every group.
// The first focusable element is the 跳到主要內容 link to `skipTo` (the page's <main id>); pages
// showing more than one header, like /design-system, pass skipTo={false} on the extra ones.
// While the 選單 sheet is open the page behind it does not scroll (CSS :has, no client JS).
// `open` draws one menu open (a first-level label, 'search' or 'mobile'), for the /design-system
// page only, like `surface`.
import { contactAction, localizedNav, localNode, nodeHref, type NavItem } from '../../lib/ia/navigation';
import type { LocaleLink } from '../../lib/i18n/alternates';
import { LOCALE_NAMES } from '../../lib/i18n/locales';
import { localeFromPath, normalizePath } from '../../lib/i18n/paths';
import { pageLocales } from '../../lib/i18n/routes';
import { strings } from '../../data/strings';
import Button from './Button.astro';
import FormField from './FormField.astro';
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-symbol-color.svg';
import logoWhite from '../../assets/brand/logo-symbol-white.svg';

interface Props {
  // Accessible name of the <nav>; must be unique when several headers share a page
  navLabel?: string;
  // Fragment of the page's main content, or false for no skip link
  skipTo?: `#${string}` | false;
  open?: string;
  locales?: readonly LocaleLink[];
  // Fixed surface; omitted, the header follows the bands under it
  surface?: 'light' | 'dark';
  // On the home page's grid (--grid-margin, up to --layout-max-width) instead of the content width
  wide?: boolean;
}

const path = normalizePath(Astro.url.pathname);
const currentLocale = localeFromPath(path);
const t = strings(currentLocale);
const { navLabel = t.mainNav, skipTo = '#main', open, locales = pageLocales(path), surface, wide = false } = Astro.props;
// Rendered height in px; matches --logo-height (2rem)
const LOGO_HEIGHT = 32;
// One exclusive group per header; /design-system shows several headers, each with its own navLabel
const menuGroup = `site-menu-${navLabel}`;
const header = localizedNav('header', currentLocale);
// The link to the page being shown (docs/ia/navigation.md「無障礙」)
const current = (href: string | undefined) => (href === path ? 'page' : undefined);
const contactLabel = contactAction(currentLocale);
const search = localNode('search', currentLocale);
// The search field's id, unique per header like menuGroup (navLabel may hold spaces and CJK)
const searchId = `site-search-${Array.from(navLabel, (c) => c.codePointAt(0)?.toString(36)).join('')}`;
// The 產品 menu is the mega menu: its overview link on top, then one column per family with its
// products below the family link
const groups = (item: NavItem) => item.children.filter((c) => c.children.length > 0);
const isMega = (item: NavItem) => groups(item).length > 0;
---

<header class="site-header" data-surface={surface ?? 'light'} data-follow-surface={surface ? undefined : ''}>
  {skipTo && <a class="skip" href={skipTo}>{t.skipToMain}</a>}
  <div class:list={['bar', { wide }]}>
    <a class="brand" href={nodeHref('home', currentLocale)}>
      <Image class="logo on-light" src={logo} alt={t.homeLogoAlt} height={LOGO_HEIGHT} loading="eager" layout="none" />
      <Image class="logo on-dark" src={logoWhite} alt={t.homeLogoAlt} height={LOGO_HEIGHT} loading="eager" layout="none" />
    </a>

    <nav class="desktop-nav" aria-label={navLabel}>
      <ul class="top">
        {
          header.map((item) => (
            <li class:list={{ mega: isMega(item) }}>
              <details name={menuGroup} open={open === item.label}>
                <summary>
                  {item.label}
                  <span class="caret" aria-hidden="true" />
                </summary>
                <div class="menu" data-surface="light">
                  {isMega(item) ? (
                    <>
                      <ul class="overview">
                        {item.children
                          .filter((c) => c.children.length === 0)
                          .map((c) => (
                            <li>
                              <a class="menu-link" href={c.href} aria-current={current(c.href)}>
                                {c.label}
                              </a>
                            </li>
                          ))}
                      </ul>
                      <ul class="columns" style={`--mega-columns: ${groups(item).length}`}>
                        {groups(item).map((g) => (
                          <li>
                            {g.href ? (
                              <a class="menu-link group" href={g.href} aria-current={current(g.href)}>
                                {g.label}
                              </a>
                            ) : (
                              <span class="menu-link group">{g.label}</span>
                            )}
                            <ul>
                              {g.children.map((p) => (
                                <li>
                                  <a class="menu-link" href={p.href} aria-current={current(p.href)}>
                                    {p.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <ul>
                      {item.children.map((c) => (
                        <li>
                          <a class="menu-link" href={c.href} aria-current={current(c.href)}>
                            {c.label}
                            {c.external && <span class="sr-only">{t.externalSite}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <details class="search" name={menuGroup} open={open === 'search'}>
        <summary class="icon">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6"></circle><path d="m15 15 5 5"></path></svg>
          <span class="sr-only">{search.title}</span>
        </summary>
        <form class="menu search-box" data-surface="light" role="search" action={nodeHref('search', currentLocale)}>
          <FormField kind="text" id={searchId} name="q" label={t.utility.searchLabel} />
          <Button type="submit">{t.utility.searchSubmit}</Button>
        </form>
      </details>
      {
        locales.length > 1 && (
          <details class="locale" name={menuGroup} open={open === 'locale'}>
            <summary>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="8.5" />
                <path d="M3.5 12h17M12 3.5c2.5 2.6 2.5 14.4 0 17M12 3.5c-2.5 2.6-2.5 14.4 0 17" />
              </svg>
              <span class="sr-only">{t.languagePrefix}</span>
              {LOCALE_NAMES[currentLocale]}
            </summary>
            <ul class="menu" data-surface="light">
              {locales.map((l) => (
                <li>
                  <a class="menu-link" href={l.href} lang={l.locale} hreflang={l.locale} aria-current={l.current ? 'page' : undefined}>
                    {LOCALE_NAMES[l.locale]}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      <div class="cta">
        <Button href={nodeHref('contact', currentLocale)} size="sm">{contactLabel}</Button>
      </div>
      <details class="mobile" name={menuGroup} open={open === 'mobile'}>
        <summary class="icon">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <span class="sr-only">{t.menu}</span>
        </summary>
        <nav class="sheet" data-surface="light" aria-label={`${navLabel}${t.mobileNavSuffix}`}>
          {
            header.map((item) => (
              <div>
                <p class="sheet-title">{item.label}</p>
                <ul>
                  {/* A column heading with no page (#138) lists its links in its place */}
                  {item.children.flatMap((c) => (c.href ? [c] : c.children)).map((c) => (
                    <li>
                      <a class="menu-link" href={c.href} aria-current={current(c.href)}>
                        {c.label}
                        {c.external && <span class="sr-only">{t.externalSite}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          {
            locales.length > 1 && (
              <div>
                <p class="sheet-title">{t.language}</p>
                <ul>
                  {locales.map((l) => (
                    <li>
                      <a class="menu-link" href={l.href} lang={l.locale} hreflang={l.locale} aria-current={l.current ? 'page' : undefined}>
                        {LOCALE_NAMES[l.locale]}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <Button href={nodeHref('contact', currentLocale)}>{contactLabel}</Button>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Keyboard and pointer behavior of the header menus (docs/ia/navigation.md「無障礙」): a click
  // outside, Esc, or focus moving out closes a menu; the 選單 sheet makes the rest of the page inert
  // while open. The /design-system previews are inert and drawn open on purpose, so they are left
  // alone.
  const live = (d: Element) => !d.closest('[inert]');
  const openMenus = () => [...document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]')].filter(live);

  document.addEventListener('click', (e) => {
    for (const menu of openMenus()) if (!(e.target instanceof Node && menu.contains(e.target))) menu.open = false;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const menu of openMenus()) {
      const hadFocus = menu.contains(document.activeElement);
      menu.open = false;
      if (hadFocus) menu.querySelector('summary')?.focus();
    }
  });

  // Tabbing out of a dropdown closes it. Focus that goes nowhere (a click on the page) is left to
  // the click handler, so clicking inside an open menu keeps it open.
  document.addEventListener('focusout', (e) => {
    const menu = e.target instanceof Element ? e.target.closest<HTMLDetailsElement>('.site-header details[open]:not(.mobile)') : null;
    if (menu && live(menu) && e.relatedTarget instanceof Node && !menu.contains(e.relatedTarget)) menu.open = false;
  });

  // The search box: focus goes to its field when it opens
  for (const box of [...document.querySelectorAll<HTMLDetailsElement>('.site-header details.search')].filter(live)) {
    box.addEventListener('toggle', () => {
      if (box.open) box.querySelector('input')?.focus();
    });
  }

  // The header takes the surface of the band under its bottom edge (#179). The observer's root is
  // that one-pixel line of the viewport; while any data-surface="dark" section crosses it, the header
  // is dark. Rebuilt on resize: the header's height and the viewport's change the line.
  // From 64rem a page's InPageNav (stick="header", after the header in PageLayout) is stuck right
  // under the header, so the two read as one bar: the line moves to the bar's bottom edge and the
  // nav switches with the header. The bands all come after the nav, so by the time one reaches that
  // line the nav is stuck. Below 64rem the nav scrolls with the page and stays light.
  const wide = matchMedia('(width >= 64rem)');
  for (const header of [...document.querySelectorAll<HTMLElement>('.site-header[data-follow-surface]')].filter(live)) {
    const nav = header.parentElement?.querySelector<HTMLElement>(':scope > .in-page-nav.header') ?? null;
    let observer: IntersectionObserver | undefined;
    const watch = () => {
      observer?.disconnect();
      const bar = wide.matches ? nav : null;
      const line = header.offsetHeight + (bar?.offsetHeight ?? 0);
      const under = new Set<Element>();
      observer = new IntersectionObserver(
        (entries) => {
          // Decided on the band's own box, not on isIntersecting: the root margin is in px from
          // the viewport's height, so between a resize and the rebuild (a full-page screenshot, a
          // phone's address bar) the root is no longer the one-pixel line
          for (const e of entries) {
            const box = e.boundingClientRect;
            if (box.top < line && box.bottom > line - 1) under.add(e.target);
            else under.delete(e.target);
          }
          const surface = under.size > 0 ? 'dark' : 'light';
          const deep = [...under].some((band) => band instanceof HTMLElement && band.dataset.depth === 'deep');
          header.dataset.surface = surface;
          header.toggleAttribute('data-depth', deep);
          if (nav) {
            nav.dataset.surface = bar ? surface : 'light';
            nav.toggleAttribute('data-depth', Boolean(bar) && deep);
          }
        },
        { rootMargin: `${1 - line}px 0px ${line - innerHeight}px 0px` },
      );
      // Every band, inert ones too: the 選單 sheet makes the page inert while open, and a resize
      // then must not drop the bands for good. Not the nav: it is dark itself while it follows the
      // header, and would keep both dark after a resize (#179 review)
      for (const band of document.querySelectorAll('[data-surface="dark"]')) {
        if (band !== nav && !band.closest('.site-header')) observer.observe(band);
      }
    };
    let queued = false;
    addEventListener('resize', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        watch();
      });
    });
    watch();
  }

  // Everything on the page outside `sheet`: the siblings of the sheet and of each of its ancestors
  function outside(sheet: Element): Element[] {
    const out: Element[] = [];
    for (let el: Element | null = sheet; el?.parentElement; el = el.parentElement) {
      for (const sibling of el.parentElement.children) if (sibling !== el && !sibling.hasAttribute('inert')) out.push(sibling);
      if (el.parentElement === document.body) break;
    }
    return out;
  }

  // The 選單 sheet: while it is open the rest of the page can't be focused or read out, and focus
  // starts on its first link; once closed, focus goes back to its button
  for (const mobile of [...document.querySelectorAll<HTMLDetailsElement>('.site-header details.mobile')].filter(live)) {
    let background: Element[] = [];
    mobile.addEventListener('toggle', () => {
      if (mobile.open) {
        background = outside(mobile);
        for (const el of background) el.setAttribute('inert', '');
        mobile.querySelector<HTMLElement>('.sheet a')?.focus();
      } else {
        for (const el of background) el.removeAttribute('inert');
        background = [];
        const focus = document.activeElement;
        if (!focus || focus === document.body || mobile.contains(focus)) mobile.querySelector('summary')?.focus();
      }
    });
    // The sheet only shows below --bp-lg-up (64rem): widening the window closes it, so the page
    // doesn't stay inert behind a hidden sheet
    matchMedia('(width >= 64rem)').addEventListener('change', (e) => {
      if (e.matches) mobile.open = false;
    });
  }
</script>

<style>
  @import '../../styles/media.css';

  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-overlay);
    background: var(--color-bg);
    color: var(--color-text);
    /* The switch to and from the purple band (#179); a cut under reduced motion */
    transition-property: background-color, color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-standard);
    /* Makes the header the containing block of fixed descendants (the mobile sheet) */
    contain: layout;
    /* Closed menus still have boxes; at the edge of a phone screen they would widen the page.
       Clip, not hidden: no scroll container, and the menus still open downwards. */
    overflow-x: clip;
  }

  /* Over the footer: its near-black, not the purple of the bands (#212) */
  .site-header[data-depth] {
    background: var(--color-bg-deep);
  }


  /* Off screen until focused, then shown over the bar's start */
  .skip {
    position: absolute;
    inset-block-start: calc(var(--header-height) * -1);
    inset-inline-start: var(--space-gutter);
    z-index: var(--z-raised);
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-action);
    color: var(--color-action-text);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .skip:focus {
    inset-block-start: var(--space-2);
  }

  /* The open 選單 sheet covers the page: keep the page behind it from scrolling. Only below 64rem,
     where the sheet shows: rotating a tablet past it hides the sheet but leaves <details> open */
  @media (--bp-lg-down) {
    /* global-ok: scroll locking has to be set on <html>, outside the header */
    :global(html:has(.site-header .mobile[open])) {
      overflow: hidden;
    }
  }

  /* --bar-inset: the bar's side margin; the menus, the search box and the phone sheet hang from the
     bar at the same inset, so they line up with the logo (#238) */
  .bar {
    --bar-inset: var(--space-gutter);

    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    box-sizing: content-box;
    max-inline-size: var(--content-max-width);
    min-block-size: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--bar-inset);
  }

  /* The home page's grid: its margin is inside the width, so the logo sits on the hero's left edge */
  .bar.wide {
    --bar-inset: var(--grid-margin);

    box-sizing: border-box;
    max-inline-size: var(--layout-max-width);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    min-block-size: var(--touch-target);
  }

  /* The symbol only: the bar has no room to spare for the full logo's two lines of text; the footer
     shows the full logo. Color on the paper, white on the purple band. */
  .logo {
    display: block;
    inline-size: auto;
    block-size: var(--logo-height);
  }

  .site-header[data-surface='light'] .on-dark,
  .site-header[data-surface='dark'] .on-light {
    display: none;
  }

  /* First-level menu: desktop only. Not named .primary: Button's variant class would match it */
  .desktop-nav {
    display: none;
  }

  .top {
    display: flex;
    gap: var(--space-1);
  }

  summary {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    list-style: none;
    transition-property: background-color, color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-standard);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  details[open] > summary {
    background: var(--color-bg-muted);
  }

  .caret {
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-block-end: var(--border-width-strong) solid currentcolor;
    border-inline-end: var(--border-width-strong) solid currentcolor;
    transform: translateY(calc(var(--space-1) * -0.5)) rotate(calc(var(--quarter-turn) / 2));
    transition-property: transform;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-standard);
  }

  details[open] .caret {
    transform: translateY(calc(var(--space-1) * 0.5)) rotate(calc(var(--quarter-turn) * -1.5));
  }

  /* Dropdowns hang from their item; the mega menu spans the bar */
  details {
    position: relative;
  }

  .mega,
  .mega details {
    position: static;
  }

  .menu {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-start: 0;
    min-inline-size: calc(var(--space-24) * 2.5);
    padding: var(--space-3);
    border: var(--border-width) solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    box-shadow: var(--shadow-lg);
  }

  .mega .menu {
    inset-inline: var(--bar-inset);
    padding: var(--space-6);
  }

  .overview {
    margin-block-end: var(--space-4);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(var(--mega-columns), minmax(0, 1fr));
    gap: var(--space-6);
  }

  .menu-link {
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-snug);
    text-decoration: none;
  }

  /* Only links: a column heading with no page (#138) is a span */
  a.menu-link:hover {
    background: var(--color-bg-muted);
    color: var(--color-text);
  }

  .menu-link[aria-current] {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  /* Family links head their column in bold, no rule under them (#187) */
  .group {
    margin-block-end: var(--space-2);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  .tools {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-inline-start: auto;
  }

  .icon {
    display: grid;
    place-items: center;
    inline-size: var(--touch-target);
    min-block-size: var(--touch-target);
    padding: 0;
    border-radius: var(--radius-md);
    color: var(--color-text);
  }

  .icon:hover {
    background: var(--color-bg-muted);
  }

  svg {
    inline-size: var(--icon-size);
    block-size: var(--icon-size);
    fill: none;
    stroke: currentcolor;
    stroke-width: var(--icon-stroke);
    stroke-linecap: round;
  }

  .locale .menu {
    inset-inline: auto 0;
  }

  /* The search box spans the bar on phones (the button sits near the middle of it), and hangs
     from the button's right edge from --bp-sm-up */
  .search {
    position: static;
  }

  .search-box {
    inset-inline: var(--bar-inset);
    display: grid;
    gap: var(--space-4);
    align-items: end;
    padding: var(--space-5);
  }

  /* Phones: logo, search and the menu button; 聯絡我們 and the locale move into the sheet. The
     mobile disclosure is static so the sheet positions against the header, not the button */
  .mobile {
    position: static;
  }

  .cta,
  .locale {
    display: none;
  }

  /* The header's layout containment makes it the containing block of fixed descendants, so the sheet
     hangs from the header's bottom edge and fills the rest of the viewport */
  .sheet {
    position: fixed;
    inset: 100% 0 auto;
    block-size: calc(100dvh - var(--header-height));
    display: flex;
    flex-direction: column;
