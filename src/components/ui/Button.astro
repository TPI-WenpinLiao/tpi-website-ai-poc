---
// Button or button-styled link. With href it renders <a> (navigation); without, <button> (action).
// A link can't be disabled, so `disabled` only exists on the button variant.
import type { HTMLAttributes } from 'astro/types';

type Common = {
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'sm' | 'md';
};

type Props = Common &
  (
    | ({ href: string; type?: never } & Omit<HTMLAttributes<'a'>, 'href' | 'type'>)
    | ({ href?: undefined; type?: 'button' | 'submit' | 'reset'; disabled?: boolean } & Omit<
        HTMLAttributes<'button'>,
        'type' | 'disabled'
      >)
  );

const { variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props;
const classes = ['btn', variant, size, className];
---

{
  'href' in rest && rest.href !== undefined ? (
    <a class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-6);
    border: var(--border-width-strong) solid transparent;
    border-radius: var(--radius-pill);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .sm {
    min-height: var(--space-10);
    padding: var(--space-1) var(--space-4);
    font-size: var(--font-size-sm);
  }

  .primary {
    background: var(--color-action);
    color: var(--color-action-text);
  }

  .primary:hover {
    background: var(--color-action-hover);
  }

  .secondary {
    border-color: var(--color-action);
    background: var(--color-bg);
    color: var(--color-action);
  }

  .secondary:hover {
    background: var(--color-action-subtle-hover);
  }

  .text {
    padding-inline: var(--space-2);
    background: transparent;
    color: var(--color-action);
  }

  .text:hover {
    text-decoration: underline;
  }

  .btn:disabled {
    border-color: transparent;
    background: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    cursor: not-allowed;
  }
</style>
