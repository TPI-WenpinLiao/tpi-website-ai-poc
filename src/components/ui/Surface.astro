---
// Page section that sets the surface its content renders on. "light" is the white paper every page
// is on (ribbon-route, #167); tone="dark" is the purple brand band (contact, OrientAI). Every
// semantic color token switches with data-surface, so components inside need no variants.
// `fill` paints the light paper one step darker: "subtle" (grey) and "brand" (pale purple) mark a
// change of question group down the page, instead of rules or frames (design-principles.md「內頁共用
// 的規則」, #187). The `backdrop` slot takes a Backdrop image.
// Two sections in a row on the same tone and fill read as one band, so the second drops its top
// padding: the gap between them is one --space-section, not two. A change of tone or fill keeps both.
// trim="end" cuts the bottom padding to --space-16, for a compact title block (PageHero
// size="compact") that leads straight into its page's text.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'section'> & {
  tone?: 'light' | 'dark';
  fill?: 'subtle' | 'brand';
  width?: 'content' | 'reading';
  trim?: 'end';
};

const { tone = 'light', fill, width = 'content', trim, class: className, ...rest } = Astro.props;
---

<section class:list={['surface', className]} data-surface={tone} data-fill={fill ?? 'none'} {...rest}>
  {
    Astro.slots.has('backdrop') && (
      <div class="backdrop-layer">
        <slot name="backdrop" />
      </div>
    )
  }
  <div class:list={['inner', width, { 'trim-end': trim === 'end' }]}>
    <slot />
  </div>
</section>

<style>
  .surface {
    position: relative;
    isolation: isolate;
    background: var(--color-bg);
    color: var(--color-text);
  }

  [data-fill='subtle'] {
    background: var(--color-bg-subtle);
  }

  [data-fill='brand'] {
    background: var(--color-bg-brand-subtle);
  }

  .backdrop-layer {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter);
  }

  /* The width tokens are the content width; gutters are added outside them */
  .inner {
    box-sizing: content-box;
  }

  .content {
    max-width: var(--content-max-width);
  }

  .reading {
    max-width: var(--reading-max-width);
  }

  .surface[data-surface='light'][data-fill='none'] + .surface[data-surface='light'][data-fill='none'] > .inner,
  .surface[data-surface='light'][data-fill='subtle'] + .surface[data-surface='light'][data-fill='subtle'] > .inner,
  .surface[data-surface='light'][data-fill='brand'] + .surface[data-surface='light'][data-fill='brand'] > .inner,
  .surface[data-surface='dark'] + .surface[data-surface='dark'] > .inner {
    padding-block-start: 0;
  }

  .trim-end {
    padding-block-end: var(--space-16);
  }
</style>
