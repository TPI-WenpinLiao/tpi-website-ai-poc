---
// Page section that sets the surface its content renders on. tone="dark" is the scene surface for
// narrative pages (and the 3D scroll scene); "light" is for reading. Every semantic color token
// switches with data-surface, so components inside need no variants.
// pattern="grid" draws the coordinate grid that fades out from the top. The `backdrop` slot takes a
// Backdrop image, drawn under the grid.
// Two sections in a row on the same tone read as one band, so the second drops its top padding:
// the gap between them is one --space-section, not two. A change of tone keeps both paddings.
// trim="end" cuts the bottom padding to --space-16, for a compact title block (PageHero
// size="compact") that leads straight into its page's text.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'section'> & {
  tone?: 'light' | 'dark';
  pattern?: 'none' | 'grid';
  width?: 'content' | 'reading';
  trim?: 'end';
};

const { tone = 'light', pattern = 'none', width = 'content', trim, class: className, ...rest } = Astro.props;
---

<section class:list={['surface', pattern, className]} data-surface={tone} {...rest}>
  {
    Astro.slots.has('backdrop') && (
      <div class="backdrop-layer">
        <slot name="backdrop" />
      </div>
    )
  }
  <div class:list={['inner', width, { 'trim-end': trim === 'end' }]}>
    <slot />
  </div>
</section>

<style>
  .surface {
    position: relative;
    isolation: isolate;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .backdrop-layer {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .grid::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--color-grid-line) var(--border-width), transparent var(--border-width)),
      linear-gradient(to right, var(--color-grid-line) var(--border-width), transparent var(--border-width));
    background-size: var(--grid-size) var(--grid-size);
    mask-image: radial-gradient(ellipse at top, black 30%, transparent 80%);
    pointer-events: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter);
  }

  /* The width tokens are the content width; gutters are added outside them */
  .inner {
    box-sizing: content-box;
  }

  .content {
    max-width: var(--content-max-width);
  }

  .reading {
    max-width: var(--reading-max-width);
  }

  .surface[data-surface='light'] + .surface[data-surface='light'] > .inner,
  .surface[data-surface='dark'] + .surface[data-surface='dark'] > .inner {
    padding-block-start: 0;
  }

  .trim-end {
    padding-block-end: var(--space-16);
  }
</style>
