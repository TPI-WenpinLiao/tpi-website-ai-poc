---
// Page section that sets the surface its content renders on. tone="dark" is the scene surface for
// narrative pages (and the 3D scroll scene); "light" is for reading. Every semantic color token
// switches with data-surface, so components inside need no variants.
// pattern="grid" draws the coordinate grid that fades out from the top.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'section'> & {
  tone?: 'light' | 'dark';
  pattern?: 'none' | 'grid';
  width?: 'content' | 'reading';
};

const { tone = 'light', pattern = 'none', width = 'content', class: className, ...rest } = Astro.props;
---

<section class:list={['surface', pattern, className]} data-surface={tone} {...rest}>
  <div class:list={['inner', width]}>
    <slot />
  </div>
</section>

<style>
  .surface {
    position: relative;
    isolation: isolate;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .grid::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--color-grid-line) var(--border-width), transparent var(--border-width)),
      linear-gradient(to right, var(--color-grid-line) var(--border-width), transparent var(--border-width));
    background-size: var(--grid-size) var(--grid-size);
    mask-image: radial-gradient(ellipse at top, black 30%, transparent 80%);
    pointer-events: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter);
  }

  .content {
    max-width: var(--content-max-width);
  }

  .reading {
    max-width: var(--reading-max-width);
  }
</style>
