---
// Text link. `inline` sits in running text (always underlined so it doesn't rely on color alone);
// `standalone` is a call-to-action line with an arrow that slides on hover. `external` marks links
// that leave the site. Colors follow the surrounding data-surface.
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'>, 'href'> & {
  href: string;
  variant?: 'inline' | 'standalone';
  external?: boolean;
};

const { variant = 'inline', external = false, class: className, ...rest } = Astro.props;
---

<a class:list={['link', variant, className]} {...rest}
  ><slot />{variant === 'standalone' && !external && <span class="icon" aria-hidden="true">→</span>}{
    external && (
      <>
        <span class="icon" aria-hidden="true">↗</span>
        <span class="sr-only">（外部網站）</span>
      </>
    )
  }</a
>

<style>
  .link {
    color: var(--color-link);
    text-underline-offset: var(--underline-offset);
  }

  .link:hover {
    color: var(--color-link-hover);
  }

  .inline {
    text-decoration: underline;
  }

  .standalone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-target);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .standalone:hover {
    text-decoration: underline;
  }

  .icon {
    display: inline-block;
    margin-inline-start: var(--space-1);
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .standalone:hover .icon {
    transform: translateX(var(--space-1));
  }
</style>
