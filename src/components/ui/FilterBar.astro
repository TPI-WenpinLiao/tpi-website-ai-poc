---
// Filter row above a listing: blog categories (each its own page, so they are links), news types or
// industries. An item with href is a link and the current one carries aria-current; an item
// without href is a static label until the in-page filter exists (M6). Scrolls sideways inside the
// row on narrow screens, never the page.
// data-preview-state on an item draws its hover or focus state, for /design-system only.
interface Props {
  label: string;
  items: { label: string; href?: string; current?: boolean; 'data-preview-state'?: 'hover' | 'focus' }[];
}

const { label, items } = Astro.props;
---

<nav class="filter-bar" aria-label={label}>
  <ul>
    {
      items.map((item) =>
        item.href ? (
          <li>
            <a class="chip" href={item.href} aria-current={item.current ? 'page' : undefined} data-preview-state={item['data-preview-state']}>
              {item.label}
            </a>
          </li>
        ) : (
          <li>
            <span class="chip">{item.label}</span>
          </li>
        ),
      )
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0 0 var(--space-1);
    overflow-x: auto;
    list-style: none;
    scrollbar-width: thin;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  a.chip:is(:hover, [data-preview-state='hover']) {
    border-color: var(--color-border-brand);
    color: var(--color-text);
  }

  /* shared-ok: the selected state of FilterBar and Pagination; a base.css class would lose to
     each control's scoped colors and border */
  .chip[aria-current='page'] {
    border-color: transparent;
    background: var(--color-action);
    color: var(--color-action-text);
    font-weight: var(--font-weight-semibold);
  }
</style>
