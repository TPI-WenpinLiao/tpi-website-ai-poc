---
// A row of labels (Tag) that wraps: an article's tags, an advisor's expertise. `label` names the list
// for screen readers when the row has no heading of its own.
import Tag from './Tag.astro';

interface Props {
  items: readonly string[];
  tone?: 'neutral' | 'brand' | 'node';
  label?: string;
}

const { items, tone = 'neutral', label } = Astro.props;
---

<ul class="tag-list" aria-label={label}>
  {
    items.map((item) => (
      <li>
        <Tag tone={tone}>{item}</Tag>
      </li>
    ))
  }
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
