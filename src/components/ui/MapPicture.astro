---
// A static picture of the ribbon world with HTML labels naming its blocks (#187): the offering and
// hub heroes (design-principles.md「offering」「hub」第一屏). `picture` is the name in
// src/lib/scene/ribbon/pictures.json; `labels` maps its anchors (core, legacy, product, greenswift,
// model, service, ai0–ai2) to the words, which come from the page's facts. A label whose block falls outside
// the picture is left out. The picture only backs the copy up, so its alt is empty; the labels are
// hidden from screen readers too, as the text beside the picture says the same.
// `priority` is for the LCP image (a hero).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { labelsOn, where, type PictureName } from '../../lib/scene/ribbon/labels';

interface Props {
  image: ImageMetadata;
  picture: PictureName;
  labels?: Partial<Record<string, string>> | undefined;
  priority?: boolean;
}

const { image, picture, labels = {}, priority = false } = Astro.props;
const placed = labelsOn(where(picture), Object.keys(labels), (name) => labels[name]);
---

<figure class="map-picture">
  <Image class="image" src={image} widths={[640, 960, 1280]} sizes="(width >= 64rem) 36rem, 100vw" alt="" priority={priority} />
  {
    placed.map((l) => (
      <span class:list={['label', l.edge]} style={l.style} aria-hidden="true">
        {l.label}
      </span>
    ))
  }
</figure>

<style>
  /* Each label sets its block's position inline (labels.ts); 0 until it does */
  .map-picture {
    --x: 0;
    --y: 0;
    position: relative;
    margin: 0;
  }

  .image {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* Hangs above its block, in the ink of the page: the same label as the home page's map */
  .label {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    padding: 0 var(--space-2);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - var(--space-2)));
  }

  .start {
    transform: translate(0, calc(-100% - var(--space-2)));
  }

  .end {
    transform: translate(-100%, calc(-100% - var(--space-2)));
  }
</style>
