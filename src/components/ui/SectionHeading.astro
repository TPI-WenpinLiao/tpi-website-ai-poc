---
// Heading block that opens a page section: the heading and optional lead text, nothing above it (no
// index, eyebrow or rule; design-principles.md「內頁共用的規則」, #187). The heading says the answer
// to the section's question. The level is set by the caller so headings never skip a level
// (seo-checklist); `size="display"` is for the one statement section per page, `size="sm"` for a
// heading inside a panel (a form's error summary). The description is body copy in the full text
// colour, not muted (design-principles.md P4, #208).
// `weight="secondary"` is for the minor sections (related posts, sub-pages, related offerings): the
// heading drops to --font-size-text, so it weighs less than the cases and facts above it.
// The `action` slot puts links for the whole section (所有成功案例, 部落格) on the heading's row,
// at its end on wide screens and below it when the row is too narrow.
interface Props {
  title: string;
  level?: 2 | 3;
  description?: string | undefined;
  size?: 'default' | 'display' | 'sm';
  weight?: 'primary' | 'secondary';
  align?: 'start' | 'center';
}

const { title, level = 2, description, size = 'default', weight = 'primary', align = 'start' } = Astro.props;
const Heading = `h${level}` as const;
const hasAction = Astro.slots.has('action');
---

<header class:list={['section-heading', align, { 'has-action': hasAction }]}>
  <div class="copy">
    <Heading class:list={['title', `level-${level}`, size, weight]}>{title}</Heading>
    {description && <p class="description text-phrase">{description}</p>}
  </div>
  {
    hasAction && (
      <div class="action">
        <slot name="action" />
      </div>
    )
  }
</header>

<style>
  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--reading-max-width);
  }

  .center .copy {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .has-action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: end;
    justify-content: space-between;
  }

  .action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .title {
    margin: 0;
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
  }

  .level-2 {
    font-size: var(--font-size-h2);
  }

  .level-3 {
    font-size: var(--font-size-h3);
  }

  .display {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
  }

  .sm,
  .secondary {
    font-size: var(--font-size-text);
    line-height: var(--line-height-snug);
  }

  .description {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-lg);
  }
</style>
