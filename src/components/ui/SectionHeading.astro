---
// Heading block that opens a page section: optional index ("01") and mono eyebrow on an energy
// line, the heading, optional lead text. The level is set by the caller so headings never skip a
// level (seo-checklist); `size="display"` is for the one statement section per page.
interface Props {
  title: string;
  level?: 2 | 3;
  index?: string;
  eyebrow?: string;
  description?: string;
  size?: 'default' | 'display';
  align?: 'start' | 'center';
}

const { title, level = 2, index, eyebrow, description, size = 'default', align = 'start' } = Astro.props;
const Heading = `h${level}` as const;
---

<header class:list={['section-heading', align]}>
  {
    (index || eyebrow) && (
      <p class="eyebrow">
        {index && <span class="index">{index}</span>}
        {eyebrow && <span>{eyebrow}</span>}
      </p>
    )
  }
  <Heading class:list={['title', `level-${level}`, size]}>{title}</Heading>
  {description && <p class="description text-phrase">{description}</p>}
</header>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--reading-max-width);
  }

  .center {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
  }

  .eyebrow::after {
    content: '';
    inline-size: var(--space-12);
    block-size: var(--border-width);
    background: var(--gradient-energy);
  }

  .index {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-semibold);
  }

  .title {
    margin: 0;
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
  }

  .level-2 {
    font-size: var(--font-size-h2);
  }

  .level-3 {
    font-size: var(--font-size-h3);
  }

  .display {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
  }

  .description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }
</style>
