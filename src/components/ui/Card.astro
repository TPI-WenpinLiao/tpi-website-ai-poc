---
// Link card for listings (products, case studies, articles): a glass panel that tilts toward the
// viewer, lights an energy-gradient rim and glows on hover. The whole card is clickable through the
// title link's ::after, so there is exactly one link per card and its name is the title.
// Image alt is required; pass alt="" only when the image is purely decorative.
// Without href the card is a static panel (offering features and use cases): no link, no hover or
// focus state; links in the meta slot (a Tag) stay their own.
// size="sm" is the short card for title-only lists laid out two to a row on phones (home services).
// data-preview-state="hover" | "focus" draws that state statically, for the /design-system page only.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  href?: string;
  level?: 2 | 3 | 4;
  index?: string;
  eyebrow?: string;
  description?: string;
  image?: { src: ImageMetadata; alt: string };
  size?: 'md' | 'sm';
  'data-preview-state'?: 'hover' | 'focus';
}

const {
  title,
  href,
  level = 3,
  index,
  eyebrow,
  description,
  image,
  size = 'md',
  'data-preview-state': previewState,
} = Astro.props;
const Heading = `h${level}` as const;
---

<article class:list={['card', size, { linked: href }]} data-preview-state={previewState}>
  {image && <Image class="media" src={image.src} alt={image.alt} widths={[400, 800]} sizes="(width >= 64rem) 22rem, 100vw" />}
  <div class="body">
    {
      (index || eyebrow) && (
        <p class="eyebrow">
          {index && <span class="index">{index}</span>}
          {eyebrow}
        </p>
      )
    }
    <Heading class="title">{href ? <a href={href}>{title}</a> : title}</Heading>
    {description && <p class="description text-phrase">{description}</p>}
    {
      Astro.slots.has('meta') && (
        <div class="meta">
          <slot name="meta" />
        </div>
      )
    }
  </div>
</article>

<style>
  @import '../../styles/media.css';

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    overflow: hidden;
    border: var(--border-width) solid var(--glass-border);
    border-radius: var(--radius-xl);
    background: var(--glass-bg);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(var(--glass-blur));
    transform: perspective(var(--perspective));
    transition:
      transform var(--duration-slow) var(--ease-out-expo),
      box-shadow var(--duration-slow) var(--ease-out-expo);
  }

  /* Energy-gradient rim, masked down to the border ring; shown on hover and focus */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    padding: var(--border-width);
    border-radius: inherit;
    background: var(--gradient-energy);
    mask:
      linear-gradient(black, black) content-box exclude,
      linear-gradient(black, black);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-standard);
    pointer-events: none;
  }

  /* :has(:focus-visible), not :focus-within, so a mouse click on the title draws no ring */
  .linked:is(:hover, [data-preview-state='hover']),
  .linked:is(:has(.title a:focus-visible), [data-preview-state='focus']) {
    box-shadow: var(--shadow-md), var(--glow-brand);
    transform: perspective(var(--perspective)) rotateX(var(--tilt)) translateY(var(--lift));
  }

  .linked:is(:hover, [data-preview-state='hover'])::before,
  .linked:is(:has(.title a:focus-visible), [data-preview-state='focus'])::before {
    opacity: 1;
  }

  .linked:is(:has(.title a:focus-visible), [data-preview-state='focus']) {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .media {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-bg-muted);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .eyebrow {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
  }

  .index {
    color: var(--color-text-accent);
  }

  .title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
    letter-spacing: var(--letter-spacing-tight);
  }

  .sm .body {
    padding: var(--space-4);
  }

  /* Phones fit two short cards per row, so the longest service name (9 characters) keeps to one line */
  .sm .title {
    font-size: var(--font-size-sm);
  }

  @media (--bp-sm-up) {
    .sm .title {
      font-size: var(--font-size-base);
    }
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Stretch the title link over the card; the card draws the focus ring instead */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .linked:is(:hover, [data-preview-state='hover']) .title a {
    color: var(--color-link);
  }

  .description {
    margin: 0;
    color: var(--color-text-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }
</style>
