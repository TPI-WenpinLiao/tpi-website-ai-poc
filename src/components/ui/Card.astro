---
// Link card for listings (articles, news, case studies): a panel one step darker than the paper, no
// frame, glass, shadow or tilt (design-principles.md「和新寫法衝突的共用元件」, #187); on hover only the
// title changes color and gets an underline. The whole card is clickable through the title link's
// ::after, so there is exactly one link per card and its name is the title.
// `category` (a blog category, news type, industry) is a plain line in the meta row, not an eyebrow.
// Offering and hub pages don't use cards: cases go in CaseList, related pages in IndexList.
// Image alt is required; pass alt="" only when the image is purely decorative.
// Without href the card is a static panel (offering features and use cases): no link, no hover or
// focus state; links in the meta slot (a Tag) stay their own.
// size="sm" is the short card for title-only lists laid out two to a row on phones (home services).
// A linked card only repeats another page's title and summary, so the site search leaves it out
// (data-pagefind-ignore); static panels are the page's own content and stay in the index.
// data-preview-state="hover" | "focus" draws that state statically, for the /design-system page only.
// `layout` says where the card sits, for the image's sizes: "grid" (default) in a three-column
// CardGrid at the content width, "full" across the content width (the listing's featured card),
// "reading-pair" in a two-column CardGrid at the reading width (content pages' section items).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Image widths per layout (#242). Gaps are --space-6. The content box is --content-max-width
// (72rem) from 76rem and the wide 90rem from --bp-xl-up, --reading-max-width (46rem) from 49rem;
// narrower, it is 100vw less two gutters of 0.5rem + 2vw (--space-gutter) = 96vw - 1rem. So in that
// range three columns are (96vw - 1rem - 3rem) / 3, two are (96vw - 1rem - 1.5rem) / 2.
// CardGrid: three columns from --bp-lg-up, two from --bp-sm-up, else one.
const SIZES = {
  grid: '(width >= 100rem) 29rem, (width >= 76rem) 23rem, (width >= 64rem) calc(32vw - 1.33rem), (width >= 40rem) calc(48vw - 1.25rem), calc(96vw - 1rem)',
  full: '(width >= 100rem) 90rem, (width >= 76rem) 72rem, calc(96vw - 1rem)',
  'reading-pair': '(width >= 49rem) 22.25rem, (width >= 40rem) calc(48vw - 1.25rem), calc(96vw - 1rem)',
} as const;

interface Props {
  title: string;
  href?: string;
  level?: 2 | 3 | 4;
  category?: string | undefined;
  description?: string;
  image?: { src: ImageMetadata; alt: string };
  size?: 'md' | 'sm';
  // YYYY-MM-DD publish date (posts, news), shown as 2026/09/11 in the meta row before the slot
  date?: string | undefined;
  layout?: keyof typeof SIZES;
  'data-preview-state'?: 'hover' | 'focus';
}

const {
  title,
  href,
  level = 3,
  category,
  description,
  image,
  size = 'md',
  date,
  layout = 'grid',
  'data-preview-state': previewState,
} = Astro.props;
const Heading = `h${level}` as const;
---

<article class:list={['card', size, { linked: href }]} data-pagefind-ignore={href ? '' : undefined} data-preview-state={previewState}>
  {image && <Image class="media" src={image.src} alt={image.alt} widths={[400, 800]} sizes={SIZES[layout]} />}
  <div class="body">
    <Heading class="title">{href ? <a href={href}>{title}</a> : title}</Heading>
    {description && <p class="description text-phrase">{description}</p>}
    {
      (date || category || Astro.slots.has('meta')) && (
        <div class="meta">
          {date && <time datetime={date}>{date.replaceAll('-', '/')}</time>}
          {category && <span>{category}</span>}
          <slot name="meta" />
        </div>
      )
    }
  </div>
</article>

<style>
  @import '../../styles/media.css';

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    overflow: hidden;
    background: var(--color-bg-subtle);
  }

  /* :has(:focus-visible), not :focus-within, so a mouse click on the title draws no ring */
  .linked:is(:has(.title a:focus-visible), [data-preview-state='focus']) {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .media {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-bg-muted);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
    letter-spacing: var(--letter-spacing-tight);
  }

  .sm .body {
    padding: var(--space-4);
  }

  /* Phones fit two short cards per row, so the longest service name (9 characters) keeps to one line */
  .sm .title {
    font-size: var(--font-size-sm);
  }

  @media (--bp-sm-up) {
    .sm .title {
      font-size: var(--font-size-base);
    }
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Stretch the title link over the card; the card draws the focus ring instead */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .linked:is(:hover, [data-preview-state='hover']) .title a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .description {
    margin: 0;
    color: var(--color-text);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }
</style>
