---
// Opening scene of a page: dark surface with the coordinate grid, mono eyebrow, the page's single
// h1 at display size, lead text, actions, and a `visual` slot. The visual is where the 3D scroll
// scene mounts (M3-07); until it loads it must show a static fallback, which is also the LCP
// candidate, so never fade the hero in. Breadcrumbs go in the `breadcrumb` slot: their own row at
// the top of the hero, outside the copy, at every width.
// The `backdrop` slot takes a full-bleed Backdrop (fade="hero", priority) behind the copy: the copy
// keeps to the start side on desktop (--hero-copy-share, clear of the image's --hero-image-share)
// and to the lower half on narrow screens, where the scrim is. On narrow screens the hero runs
// breadcrumb row → visual area → copy; the visual area is an empty element marked
// data-hero-visual, which the 3D runtime measures to frame the scene (ADR 0003).
// size="compact" is the reading pages' title block (article, content, listing, utility): the h1 at
// --font-size-h2, so long article titles stay a few lines, and --space-16 below it (Surface
// trim="end"; the next section on the same tone drops its top padding).
// Headings break Chinese only at spaces and punctuation (BaseLayout). A title with neither, such as
// 以頂尖科技為企業賦能, marks where it may break with U+200B (zero-width space): '以頂尖科技\u200b為企業賦能'.
import Surface from './Surface.astro';

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  tone?: 'light' | 'dark';
  size?: 'display' | 'compact';
}

const { title, eyebrow, description, tone = 'dark', size = 'display' } = Astro.props;
const hasVisual = Astro.slots.has('visual');
const hasBackdrop = Astro.slots.has('backdrop');
const hasCrumbs = Astro.slots.has('breadcrumb');
// Below a breadcrumb row the narrow backdrop image moves down by the row's height (Backdrop)
const imageDrop = hasCrumbs ? '--hero-image-drop: var(--hero-crumb-space)' : undefined;
---

<Surface tone={tone} pattern="grid" class="page-hero" style={imageDrop} trim={size === 'compact' ? 'end' : undefined}>
  {
    hasBackdrop && (
      <Fragment slot="backdrop">
        <slot name="backdrop" />
      </Fragment>
    )
  }
  <div class:list={['hero-body', { 'size-compact': size === 'compact', 'has-backdrop': hasBackdrop, 'has-crumbs': hasCrumbs }]}>
    {
      hasCrumbs && (
        <div class="crumbs">
          <slot name="breadcrumb" />
        </div>
      )
    }
    {hasBackdrop && <div class="hero-visual" data-hero-visual aria-hidden="true" />}
    <div class:list={['layout', { split: hasVisual, 'has-backdrop': hasBackdrop }]}>
      <div class="copy">
        {eyebrow && <p class="eyebrow signal-dot">{eyebrow}</p>}
        <h1>{title}</h1>
        {description && <p class="description text-phrase">{description}</p>}
        {
          Astro.slots.has('actions') && (
            <div class="actions">
              <slot name="actions" />
            </div>
          )
        }
      </div>
      {
        hasVisual && (
          <div class="visual">
            <slot name="visual" />
          </div>
        )
      }
    </div>
  </div>
</Surface>

<style>
  @import '../../styles/media.css';

  .layout {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-text-brand);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    text-wrap: balance;
  }

  .description {
    max-width: var(--reading-max-width);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xl);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .size-compact h1 {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  /* A compact hero's description can be a long summary: it breaks like body text, not as a phrase */
  .size-compact .description {
    font-size: var(--font-size-lg);
    word-break: normal;
  }

  /* The breadcrumb row sits --space-6 below the hero's top edge instead of the section padding */
  .has-crumbs {
    margin-block-start: calc(var(--space-6) - var(--space-section));
  }

  /* Narrow screens: the visual area (the 4:5 backdrop image's subject, or the 3D scene) runs from
     the top of the hero, or from the breadcrumb row, down to the copy. It takes over the section's
     top padding, so without a breadcrumb the copy starts where it did with plain padding. */
  .hero-body.has-backdrop:not(.has-crumbs) {
    margin-block-start: calc(var(--space-section) * -1);
  }

  .hero-visual {
    block-size: calc(var(--space-section) + var(--hero-narrow-offset));
  }

  .has-backdrop .copy {
    max-inline-size: calc(var(--content-max-width) * var(--hero-copy-share));
  }

  .visual {
    display: grid;
    place-items: center;
  }

  @media (--bp-lg-up) {
    .hero-body.has-backdrop:not(.has-crumbs) {
      margin-block-start: 0;
    }

    .hero-visual {
      display: none;
    }

    /* The copy centers in the hero's height; the breadcrumb row above takes no part */
    .layout.has-backdrop {
      min-block-size: var(--hero-min-height);
      align-content: center;
    }

    .split {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>
