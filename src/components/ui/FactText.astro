---
// A fact text as it reads on the page (#200): split into items one per line (factList,
// site-research 第 2 條), it is a list, led by its first line when that ends in a colon, the short
// items in two columns (design-principles.md「內頁共用的規則」375 寬), a list of longer items in one
// column on narrow screens (`long`, lists.ts; design-principles.md「斷行」, #225); otherwise a paragraph keeping its
// line breaks. Its quantities are bold, list items too, names' numbers not (emphasis.ts, #210;
// design-principles.md「內頁共用的規則」事實); `emphasis="none"` leaves it plain. `inline` leaves a
// one-paragraph text bare, for a table cell that already keeps line breaks (SpecTable).
// PageSections and SpecTable use it, so a fact reads the same in every layout.
import { factList } from '../../lib/content/lists';
import { quantities, type Part } from '../../lib/content/emphasis';

interface Props {
  text: string;
  emphasis?: 'quantities' | 'none';
  inline?: boolean;
}

const { text, emphasis = 'quantities', inline = false } = Astro.props;
const list = factList(text);
const partsOf = (t: string): Part[] => (emphasis === 'quantities' ? quantities(t) : [{ part: t, strong: false }]);
const parts = partsOf(text);
---

{
  list ? (
    <>
      {list.lead && <p class="lead">{partsOf(list.lead).map((p) => (p.strong ? <strong>{p.part}</strong> : p.part))}</p>}
      <ul class:list={['fact-list', { long: list.long }]}>
        {list.items.map((item) => (
          <li>{partsOf(item).map((p) => (p.strong ? <strong>{p.part}</strong> : p.part))}</li>
        ))}
      </ul>
    </>
  ) : inline ? (
    parts.map((p) => (p.strong ? <strong>{p.part}</strong> : p.part))
  ) : (
    <p class="text">{parts.map((p) => (p.strong ? <strong>{p.part}</strong> : p.part))}</p>
  )
}

<style>
  @import '../../styles/media.css';

  .text {
    max-inline-size: var(--reading-max-width);
    margin: 0;
    white-space: pre-line;
  }

  .lead {
    margin: 0 0 var(--space-2);
  }

  .fact-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1) var(--grid-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (--bp-md-down) {
    .long {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
