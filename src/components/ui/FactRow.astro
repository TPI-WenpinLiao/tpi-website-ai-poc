---
// A claim and the facts that back it (#167): the heading, a short answer and an optional link on
// the start side (columns 1–5; `links` when there are two, #202), the facts as a list set apart by space on the end side (7–12), side
// by side on the 12-column grid from --bp-lg-up, stacked below. No rules or numbers (#187). This is
// the「主張與原文」layout of design-principles.md「內頁的版型」: at most twice a page, never twice in a
// row on a page laid out by sections; the offering and hub templates fall back to it for pages
// without `sections`. Put the facts in the default slot as <li> elements, in the order to read them; a fact is
// plain text, or a heading and a line (hub sections, which link each to its page).
import SectionHeading from './SectionHeading.astro';
import Link from './Link.astro';

interface Props {
  title: string;
  level?: 2 | 3;
  description?: string | undefined;
  link?: { label: string; href: string } | undefined;
  links?: readonly { label: string; href: string }[] | undefined;
}

const { title, level = 2, description, link, links = link ? [link] : [] } = Astro.props;
---

<div class="fact-row">
  <div class="claim">
    <SectionHeading level={level} title={title} description={description} />
    {
      links.map((l) => (
        <Link href={l.href} variant="standalone">
          {l.label}
        </Link>
      ))
    }
  </div>
  {
    Astro.slots.has('default') && (
      <ul class="facts">
        <slot />
      </ul>
    )
  }
</div>

<style>
  @import '../../styles/media.css';

  .fact-row {
    display: grid;
    gap: var(--space-6) var(--grid-gutter);
  }

  .claim {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts > :global(li) {
    white-space: pre-line;
  }

  @media (--bp-lg-up) {
    .fact-row {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    }

    .claim {
      grid-column: 1 / 6;
    }

    .facts {
      grid-column: 7 / -1;
    }
  }
</style>
