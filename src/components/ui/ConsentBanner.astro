---
// Cookie consent (M6-04, #36, ADR 0007): a banner fixed to the bottom of the viewport and a
// preferences dialog (Dialog: native <dialog>, so showModal() traps focus and Esc closes it). Dark chrome like
// the header and footer, on every page whatever its surface. Accept and reject share one visual weight.
// PageLayout renders it, at body level, only when the build has PUBLIC_GTM_ID (src/lib/consent/page.ts):
// `config` carries the container ID, the data version and the categories' consent types to the
// script, which shows the banner while there is no stored choice, stores the visitor's choice
// (src/lib/consent/state.ts) and loads GTM once an optional category is granted (src/lib/consent/gtm.ts).
// Inside a container with a transform or its own stacking context the fixed banner would be covered.
// `id` names the dialog `${id}-dialog`: any button with data-consent-open="<that id>" (the footer's
// Cookie 設定) opens it.
// `preview` is for /design-system only, without `config`: "banner" draws the banner in the page flow
// instead of fixed to the viewport, "dialog" draws the dialog open in the flow (non-modal, wrap it in
// inert). Previews store nothing and load nothing; their buttons only close the dialog.
// `wide`: from --bp-sm-up the banner spans the home page's grid (--grid-margin, up to
// --layout-max-width) instead of the content width, so it lines up with the wide header's logo (#243).
import Button from './Button.astro';
import Dialog from './Dialog.astro';
import Link from './Link.astro';
import type { ConsentConfig } from '../../lib/consent/page';

export type ConsentCategory = {
  id: string;
  name: string;
  description: string;
  // Always on, can't be switched off (strictly necessary cookies)
  required?: boolean;
  // Initial state of an optional category
  checked?: boolean;
};

export type ConsentCopy = {
  title: string;
  description: string;
  policy: { href: string; label: string };
  acceptAll: string;
  rejectAll: string;
  settings: string;
  dialogTitle: string;
  dialogDescription: string;
  save: string;
  close: string;
  alwaysOn: string;
};

type Props = {
  id: string;
  categories: readonly ConsentCategory[];
  copy: ConsentCopy;
  config?: ConsentConfig;
  preview?: 'banner' | 'dialog';
  wide?: boolean;
};

const { id, categories, copy, config, preview, wide = false } = Astro.props;
const dialogId = `${id}-dialog`;
---

<div class="consent" data-surface="dark" data-preview={preview} data-consent-config={config && JSON.stringify(config)}>
  {
    preview !== 'dialog' && (
      <section class:list={['banner', { wide }]} aria-labelledby={`${id}-title`} hidden={config !== undefined}>
        <div class="text">
          <h2 class="title" id={`${id}-title`}>{copy.title}</h2>
          <p class="description">
            {copy.description} <Link href={copy.policy.href}>{copy.policy.label}</Link>
          </p>
        </div>
        <div class="actions">
          <div class="settings">
            <Button variant="text" size="sm" data-consent-open={dialogId}>{copy.settings}</Button>
          </div>
          <Button variant="secondary" size="sm" data-consent-action="reject">
            {copy.rejectAll}
          </Button>
          <Button variant="secondary" size="sm" data-consent-action="accept">
            {copy.acceptAll}
          </Button>
        </div>
      </section>
    )
  }
  {
    config && (
      // Room at the end of the page as tall as the fixed banner, so the last elements can be scrolled
      // clear of it (WCAG 2.4.11); the script sizes it while the banner shows
      <div class="spacer" aria-hidden="true" hidden />
    )
  }

  <Dialog id={dialogId} title={copy.dialogTitle} closeLabel={copy.close} preview={preview === 'dialog'}>
    <p class="description in-dialog">
      {copy.dialogDescription} <Link href={copy.policy.href}>{copy.policy.label}</Link>
    </p>
    <ul class="row-list">
      {
        categories.map((c) => (
          <li class="category">
            <label class="name" for={`${dialogId}-${c.id}`}>
              {c.name}
            </label>
            <p class="category-description" id={`${dialogId}-${c.id}-description`}>
              {c.description}
            </p>
            <span class="toggle">
              {c.required && <span class="always">{copy.alwaysOn}</span>}
              <input
                class="switch"
                type="checkbox"
                role="switch"
                id={`${dialogId}-${c.id}`}
                name={c.id}
                checked={c.required || c.checked}
                disabled={c.required}
                aria-describedby={`${dialogId}-${c.id}-description`}
              />
            </span>
          </li>
        ))
      }
    </ul>
    <div class="actions in-dialog">
      <Button variant="secondary" size="sm" type="submit" data-consent-action="reject">
        {copy.rejectAll}
      </Button>
      <Button variant="secondary" size="sm" type="submit" data-consent-action="accept">
        {copy.acceptAll}
      </Button>
      <Button size="sm" type="submit" data-consent-action="save">
        {copy.save}
      </Button>
    </div>
  </Dialog>
</div>

<script>
  import { consentParams, makeChoice, readChoice, revokes, wantsGtm, writeChoice, type Choice } from '../../lib/consent/state';
  import { gtmLoaded, loadGtm, updateConsent } from '../../lib/consent/gtm';
  import type { ConsentConfig } from '../../lib/consent/page';

  // Opens the preferences dialog named by data-consent-open, remembering what opened it so focus can
  // go back there. Inert /design-system previews are left alone.
  let opener: HTMLElement | null = null;
  document.addEventListener('click', (e) => {
    const button = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-consent-open]') : null;
    if (!button || button.closest('[inert]')) return;
    const dialog = document.getElementById(button.dataset.consentOpen ?? '');
    if (!(dialog instanceof HTMLDialogElement)) return;
    opener = button;
    dialog.dispatchEvent(new Event('consent:open'));
    dialog.showModal();
  });

  // localStorage can throw on access (blocked site data): then every visit asks again
  function storage(): Storage | undefined {
    try {
      return window.localStorage;
    } catch {
      return undefined;
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-consent-config]')) {
    const config = JSON.parse(root.dataset.consentConfig ?? '') as ConsentConfig;
    const { categories, version, gtmId } = config;
    const banner = root.querySelector<HTMLElement>('.banner');
    const dialog = root.querySelector('dialog');
    if (!banner || !dialog) continue;
    const switches = [...dialog.querySelectorAll<HTMLInputElement>('input[role="switch"]:not(:disabled)')];
    const optional = categories.filter((c) => !c.required).map((c) => c.id);

    let choice: Choice | null = readChoice(storage(), version, categories);
    const start = () => loadGtm(gtmId, consentParams(categories, []), consentParams(categories, choice?.granted ?? []));

    // While the banner shows, the page keeps room for it: scroll-padding makes focus scroll clear of
    // it, the spacer lets the page scroll far enough to uncover its last elements (WCAG 2.4.11)
    const spacer = root.querySelector<HTMLElement>('.spacer');
    const reserve = () => {
      const space = banner.hidden ? 0 : Math.ceil(window.innerHeight - banner.getBoundingClientRect().top);
      document.documentElement.style.scrollPaddingBlockEnd = space ? `${space}px` : '';
      if (spacer) {
        spacer.hidden = space === 0;
        spacer.style.blockSize = space ? `${space}px` : '';
      }
    };
    const resized = new ResizeObserver(reserve);
    const show = () => {
      banner.hidden = false;
      resized.observe(banner);
      window.addEventListener('resize', reserve);
      reserve();
    };
    const hide = () => {
      banner.hidden = true;
      resized.disconnect();
      window.removeEventListener('resize', reserve);
      reserve();
    };

    if (choice === null) show();
    else if (wantsGtm(categories, choice)) start();

    // The dialog shows the stored choice each time it opens (nothing granted before any choice)
    dialog.addEventListener('consent:open', () => {
      for (const s of switches) s.checked = choice?.granted.includes(s.name) ?? false;
    });

    // Focus goes back to what opened the dialog, unless that was in the banner and the banner is now
    // hidden: then to <main>, so focus isn't left on an element that is gone
    function restoreFocus() {
      const target = opener && !opener.closest('[hidden]') ? opener : document.getElementById('main');
      opener = null;
      if (!target) return;
      if (target.id === 'main' && !target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    }
    dialog.addEventListener('close', restoreFocus);

    function decide(granted: string[]) {
      const next = makeChoice(version, categories, granted);
      const previous = choice;
      choice = next;
      // When it can't be stored, writeChoice() also drops the old choice, so the reload below asks
      // again instead of reading back a consent the visitor just took back
      writeChoice(storage(), next);
      const hadFocus = banner?.contains(document.activeElement) ?? false;
      if (banner && !banner.hidden) hide();
      // Tags already running can't be stopped: reload so the page starts under the new choice
      if (gtmLoaded() && revokes(previous, next)) return location.reload();
      if (gtmLoaded()) updateConsent(consentParams(categories, next.granted));
      else if (wantsGtm(categories, next)) start();
      if (hadFocus) restoreFocus();
    }

    root.addEventListener('click', (e) => {
      const button = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-consent-action]') : null;
      const action = button?.dataset.consentAction;
      if (action === 'accept') decide(optional);
      else if (action === 'reject') decide([]);
      else if (action === 'save') decide(switches.filter((s) => s.checked).map((s) => s.name));
    });
  }
</script>

<style>
  @import '../../styles/media.css';

  .consent {
    display: contents;
    color: var(--color-text);
  }

  .banner {
    position: fixed;
    inset-inline: var(--space-2);
    inset-block-end: var(--space-2);
    z-index: var(--z-overlay);
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    box-shadow: var(--shadow-lg);
  }

  .banner[hidden],
  .spacer[hidden] {
    display: none;
  }

  [data-preview] .banner {
    position: static;
  }

  .title {
    margin: 0;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
  }

  .description {
    margin: var(--space-1) 0 0;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-base);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Narrow screens: settings on its own line, reject and accept share the row below at equal width */
  .banner .actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .settings {
    display: flex;
    grid-column: 1 / -1;
    justify-content: center;
  }

  .description.in-dialog {
    margin: 0;
  }

  .category {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .name {
    align-self: center;
    font-weight: var(--font-weight-semibold);
  }

  .category-description {
    grid-column: 1;
    margin: var(--space-1) 0 0;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-base);
  }

  .toggle {
    display: flex;
    grid-row: 1 / span 2;
    grid-column: 2;
    align-items: center;
    gap: var(--space-2);
  }

  .always {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  /* A checkbox drawn as a switch: track and thumb. The touch target is the label plus the row. */
  .switch {
    position: relative;
    flex: none;
    inline-size: var(--space-10);
    block-size: var(--space-6);
    margin: 0;
    border: var(--border-width-strong) solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    appearance: none;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .switch::before {
    position: absolute;
    inset-block: var(--border-width-strong);
    inset-inline-start: var(--border-width-strong);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: var(--color-text-muted);
    content: '';
    transition: translate var(--duration-fast) var(--ease-standard);
  }

  .switch:checked {
    border-color: var(--color-action);
    background: var(--color-action);
  }

  .switch:checked::before {
    background: var(--color-action-text);
    translate: calc(var(--space-10) - var(--space-6)) 0;
  }

  /* Required categories: on, but can't be switched off */
  .switch:disabled {
    border-color: var(--color-disabled-bg);
    background: var(--color-disabled-bg);
    cursor: not-allowed;
  }

  .switch:disabled::before {
    background: var(--color-disabled-text);
  }

  .actions.in-dialog {
    justify-content: end;
  }

  @media (--bp-sm-up) {
    .banner {
      inset-inline: var(--space-gutter);
      inset-block-end: var(--space-gutter);
    }

    /* The edges of the wide header bar's content: --grid-margin inside --layout-max-width */
    .banner.wide {
      inset-inline: var(--grid-margin);
      max-inline-size: calc(var(--layout-max-width) - 2 * var(--grid-margin));
    }

    .banner .actions {
      display: flex;
      justify-content: end;
    }

    .settings {
      display: contents;
    }
  }

  @media (--bp-lg-up) {
    .banner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-8);
      padding: var(--space-5) var(--space-6);
    }

    .banner .actions {
      flex-wrap: nowrap;
    }
  }
</style>
