---
// A page's one form (contact, document request, newsletter) on a raised panel, so it reads as the
// page's task: the form's heading, then its fields with even spacing. The form is labelled by its
// heading. Fields are FormField and FormGroup; the page lays out anything more (a two-column row).
// The submit button goes in the `actions` slot, so the spam check can sit between it and the fields.
//
// Feedback after a submit, shown in a status area under the heading (role="alert", so filling it
// is announced; tabindex="-1", so focus can move to it):
// - `errors`: an error summary in the site's index style (SectionHeading's numbered eyebrow on the
//   energy line, then one numbered row per invalid field linking to it; `id` is the control's or
//   FormGroup's id). The error color marks only the numbers, not a tinted box
// - `message`: one message for the whole form (sending failed, the spam check failed), a row of
//   the same list with an error dot
// `challenge` reserves the space of the Cloudflare Turnstile widget above the actions: the compact
// size below --bp-sm-up, where the flexible size's 300px minimum doesn't fit, flexible from there.
// `busy` marks the form as being sent (aria-busy); the page sets the button's label and disabled.
// `preview` outlines the reserved challenge space with its name, for /design-system and /templates.
//
// `form` (an id in src/lib/forms/rules.ts) makes the form send: it posts to `action` (its Pages
// Function), and the script (src/lib/forms/client.ts) validates with the same rules as the Function,
// fills the status area and the fields' error paragraphs, loads the Turnstile widget into the
// challenge space when the visitor first focuses the form, and goes to `next` after a successful
// submit. The status area's markup sits in <template>s so the script's copies keep the scoped styles.
// The site key is PUBLIC_TURNSTILE_SITE_KEY at build time, else Cloudflare's always-pass test key.
import SectionHeading from './SectionHeading.astro';
import { strings } from '../../data/strings';
import { localeFromPath } from '../../lib/i18n/paths';
import type { Messages } from '../../lib/forms/client';
import { NEXT_FIELD } from '../../lib/forms/handler';
import type { FormId } from '../../lib/forms/rules';
import { TEST_SITE_KEY } from '../../lib/forms/turnstile';

interface Props {
  // id of the heading, unique on the page
  id: string;
  title: string;
  errors?: readonly { id: string; message: string }[];
  message?: string;
  challenge?: boolean;
  busy?: boolean;
  preview?: boolean;
  // Sending: all three together
  form?: FormId;
  action?: string;
  next?: string;
}

const { id, title, errors = [], message, challenge = false, busy = false, preview = false, form, action, next } = Astro.props;
const t = strings(localeFromPath(Astro.url.pathname));
const pad = (n: number) => String(n).padStart(2, '0');
const e = t.form.errors;
// The script's messages; {label} and {max} are filled in per field
const messages = {
  required: e.required('{label}'),
  tooLong: e.tooLong('{label}', '{max}'),
  email: e.email,
  phone: e.phone,
  choose: e.choose,
  consent: e.consent,
  challenge: e.challenge,
  failed: t.form.failed,
  pending: t.form.pending,
} satisfies Messages;
const key: unknown = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const siteKey = typeof key === 'string' && key ? key : TEST_SITE_KEY;
---

<form
  class="form-panel"
  aria-labelledby={id}
  aria-busy={busy ? 'true' : undefined}
  method={form ? 'post' : undefined}
  action={form ? action : undefined}
  data-form={form}
  data-sitekey={form ? siteKey : undefined}
  data-messages={form ? JSON.stringify(messages) : undefined}
>
  <h2 id={id} class="title">{title}</h2>
  {form && next && <input type="hidden" name={NEXT_FIELD} value={next} />}
  <div class="status" id={`${id}-status`} role="alert" tabindex="-1" data-form-status>{
    errors.length > 0 ? (
      <div class="summary">
        <SectionHeading level={3} size="sm" index={pad(errors.length)} eyebrow="Errors" title={t.form.errorSummary} />
        <ol class="ruled-list">
          {errors.map((e, i) => (
            <li>
              <a class="row" href={`#${e.id}`}>
                <span class="n">{pad(i + 1)}</span>
                <span class="text">{e.message}</span>
                <span class="icon" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ) : message ? (
      <p class="row message">
        <span class="dot" aria-hidden="true" />
        <span class="text">{message}</span>
      </p>
    ) : null
  }</div>
  <slot />
  {challenge && <div class:list={['challenge', preview && 'preview']} data-form-challenge>{preview && t.form.challenge}</div>}
  <slot name="actions" />
  {
    form && (
      <>
        <template data-form-summary>
          <div class="summary">
            <SectionHeading level={3} size="sm" index="00" eyebrow="Errors" title={t.form.errorSummary} />
            <ol class="ruled-list">
              <li>
                <a class="row" href="#">
                  <span class="n" />
                  <span class="text" />
                  <span class="icon" aria-hidden="true">→</span>
                </a>
              </li>
            </ol>
          </div>
        </template>
        <template data-form-message>
          <p class="row message">
            <span class="dot" aria-hidden="true" />
            <span class="text" />
          </p>
        </template>
      </>
    )
  }
</form>

<script>
  import { enhance } from '../../lib/forms/client';

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-form]')) enhance(form);
</script>

<style>
  @import '../../styles/media.css';

  .form-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-8);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    box-shadow: var(--shadow-lg);
  }

  .title {
    margin: 0;
    font-size: var(--font-size-h3);
    line-height: var(--line-height-snug);
  }

  .status:empty {
    display: none;
  }

  .summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    min-block-size: var(--touch-target);
    padding-block: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .n {
    color: var(--color-error);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-mono);
  }

  .icon {
    color: var(--color-text-muted);
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  a.row:is(:hover, [data-preview-state='hover']) .text {
    text-decoration: underline;
  }

  a.row:is(:hover, [data-preview-state='hover']) .icon {
    color: var(--color-text);
    transform: translateX(var(--space-1));
  }

  .message {
    grid-template-columns: auto minmax(0, 1fr);
    margin: 0;
    border-block: var(--border-width) solid var(--color-border);
  }

  .dot {
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-error);
  }

  .challenge {
    min-block-size: var(--challenge-height-compact);
  }

  .challenge.preview {
    display: grid;
    place-items: center;
    border: var(--border-width) dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media (--bp-sm-up) {
    .challenge {
      min-block-size: var(--challenge-height);
    }
  }
</style>
