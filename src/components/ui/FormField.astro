---
// Labelled form control with hint and error text. Hint and error are wired to the control with
// aria-describedby; an error also sets aria-invalid. Validation itself belongs to M6-01.
// The textarea value sits inline between its tags: any whitespace there becomes the value.
import type { HTMLAttributes } from 'astro/types';

type Common = {
  id: string;
  name: string;
  label: string;
  hint?: string;
  error?: string;
  required?: boolean;
  requiredLabel?: string;
};

type Props = Common &
  (
    | { kind: 'text' | 'email' | 'tel'; autocomplete?: HTMLAttributes<'input'>['autocomplete']; value?: string }
    | { kind: 'textarea'; rows?: number; value?: string }
    | { kind: 'select'; options: { value: string; label: string }[]; placeholder?: string; value?: string }
    | { kind: 'checkbox'; checked?: boolean }
  );

const props = Astro.props;
const { id, name, label, hint, error, required = false, requiredLabel = '必填' } = props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(' ') || undefined;
const aria = { 'aria-describedby': describedBy, 'aria-invalid': error ? true : undefined };
---

<div class:list={['field', props.kind === 'checkbox' && 'checkbox', error && 'has-error']}>
  {
    props.kind === 'checkbox' ? (
      <>
        <input class="check" type="checkbox" id={id} name={name} checked={props.checked} required={required} {...aria} />
        <label for={id}>
          {label}
          {required && <span class="required">{requiredLabel}</span>}
        </label>
      </>
    ) : (
      <>
        <label for={id}>
          {label}
          {required && <span class="required">{requiredLabel}</span>}
        </label>
        {props.kind === 'textarea' ? (
          <textarea class="control" id={id} name={name} rows={props.rows ?? 5} required={required} {...aria}>{props.value}</textarea>
        ) : props.kind === 'select' ? (
          <select class="control" id={id} name={name} required={required} {...aria}>
            {props.placeholder && (
              <option value="" selected={!props.value}>
                {props.placeholder}
              </option>
            )}
            {props.options.map((o) => (
              <option value={o.value} selected={o.value === props.value}>
                {o.label}
              </option>
            ))}
          </select>
        ) : (
          <input
            class="control"
            type={props.kind}
            id={id}
            name={name}
            value={props.value}
            autocomplete={props.autocomplete}
            required={required}
            {...aria}
          />
        )}
      </>
    )
  }
  {hint && <p class="hint" id={hintId}>{hint}</p>}
  {error && <p class="error" id={errorId}>{error}</p>}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  .required {
    margin-inline-start: var(--space-2);
    color: var(--color-error);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
  }

  .control {
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  textarea.control {
    resize: vertical;
  }

  .control:hover {
    border-color: var(--color-text-muted);
  }

  .has-error .control {
    border-width: var(--border-width-strong);
    border-color: var(--color-error);
  }

  .checkbox {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: var(--space-3);
  }

  .check {
    inline-size: var(--space-5);
    block-size: var(--space-5);
    margin: var(--space-1) 0 0;
    accent-color: var(--color-action);
  }

  .checkbox .hint,
  .checkbox .error {
    grid-column: 2;
  }

  .hint,
  .error {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .hint {
    color: var(--color-text-muted);
  }

  .error {
    color: var(--color-error);
    font-weight: var(--font-weight-medium);
  }
</style>
