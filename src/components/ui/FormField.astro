---
// Labelled form control with hint and error text. Hint and error are wired to the control with
// aria-describedby; an error also sets aria-invalid. A hint with markup (a link) goes in the `hint` slot
// instead of the prop. The error paragraph is always rendered, hidden while empty, so a form's script
// (FormPanel `form`) can fill it and the scoped styles still apply; `data-label` gives the script the
// label for its messages. `maxlength` comes from the form's rules (src/lib/forms/rules.ts).
// The textarea value sits inline between its tags: any whitespace there becomes the value.
// data-preview-state="hover" | "focus" goes on the control and draws that state statically, for
// the /design-system page only.
import type { HTMLAttributes } from 'astro/types';
import { strings } from '../../data/strings';
import { localeFromPath } from '../../lib/i18n/paths';

type Common = {
  id: string;
  name: string;
  label: string;
  hint?: string;
  error?: string;
  required?: boolean;
  // Defaults to the page locale's strings.form.required
  requiredLabel?: string;
  'data-preview-state'?: 'hover' | 'focus';
};

type Props = Common &
  (
    | { kind: 'text' | 'email' | 'tel'; autocomplete?: HTMLAttributes<'input'>['autocomplete']; value?: string; maxlength?: number }
    | { kind: 'textarea'; rows?: number; value?: string; maxlength?: number }
    | { kind: 'select'; options: { value: string; label: string }[]; placeholder?: string; value?: string }
    // value is what a checked box sends; without it the browser sends "on" (enough for a consent box)
    | { kind: 'checkbox'; checked?: boolean; value?: string }
  );

const props = Astro.props;
const { id, name, label, hint, error, required = false, requiredLabel = strings(localeFromPath(Astro.url.pathname)).form.required } = props;
const hasHint = hint !== undefined || Astro.slots.has('hint');
const hintId = hasHint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, error && errorId].filter(Boolean).join(' ') || undefined;
const aria = {
  'aria-describedby': describedBy,
  'aria-invalid': error ? true : undefined,
  'data-preview-state': props['data-preview-state'],
};
---

<div class:list={['field', props.kind === 'checkbox' && 'checkbox', error && 'has-error']} data-form-field data-label={label}>
  {
    props.kind === 'checkbox' ? (
      <>
        <input class="check" type="checkbox" id={id} name={name} value={props.value} checked={props.checked} required={required} {...aria} />
        <label for={id}>
          {label}
          {required && <span class="required">{requiredLabel}</span>}
        </label>
      </>
    ) : (
      <>
        <label for={id}>
          {label}
          {required && <span class="required">{requiredLabel}</span>}
        </label>
        {props.kind === 'textarea' ? (
          <textarea class="control" id={id} name={name} rows={props.rows ?? 5} maxlength={props.maxlength} required={required} {...aria}>{props.value}</textarea>
        ) : props.kind === 'select' ? (
          <select class="control" id={id} name={name} required={required} {...aria}>
            {props.placeholder && (
              <option value="" selected={!props.value}>
                {props.placeholder}
              </option>
            )}
            {props.options.map((o) => (
              <option value={o.value} selected={o.value === props.value}>
                {o.label}
              </option>
            ))}
          </select>
        ) : (
          <input
            class="control"
            type={props.kind}
            id={id}
            name={name}
            value={props.value}
            autocomplete={props.autocomplete}
            maxlength={props.maxlength}
            required={required}
            {...aria}
          />
        )}
      </>
    )
  }
  {
    hasHint && (
      <p class="hint" id={hintId}>
        {hint}
        <slot name="hint" />
      </p>
    )
  }
  <p class="error" id={errorId} hidden={!error} data-form-error>{error}</p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  .required {
    margin-inline-start: var(--space-2);
    color: var(--color-error);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
  }

  .control {
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    /* An input is 20 characters wide and a select as wide as its longest option; a percentage
       width drops that from the parents' min-content width, so a grid parent without explicit
       columns no longer grows past a phone screen */
    inline-size: 100%;
  }

  textarea.control {
    resize: vertical;
  }

  .control:is(:hover, [data-preview-state='hover']) {
    border-color: var(--color-text-muted);
  }

  .has-error .control {
    border-width: var(--border-width-strong);
    border-color: var(--color-error);
  }

  .checkbox {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: var(--space-3);
  }

  .check {
    inline-size: var(--space-5);
    block-size: var(--space-5);
    margin: var(--space-1) 0 0;
    accent-color: var(--color-action);
  }

  .checkbox .hint,
  .checkbox .error {
    grid-column: 2;
  }

  .hint,
  .error {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .hint {
    color: var(--color-text-muted);
  }

  .error {
    color: var(--color-error);
    font-weight: var(--font-weight-medium);
  }
</style>
