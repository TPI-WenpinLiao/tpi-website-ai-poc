---
// A list of pages the section leads on to (#187, design-principles.md「內頁的版型」索引列): one row a
// page, its name in the bold serif at --font-size-text, a line and an optional small picture; no
// frame. The name is a link in the link colour, underlined, like CaseList's titles (#211); the whole
// row is clickable through it. The picture is a fixed --thumb-width, never as wide as the column, so
// a post's cover doesn't outweigh the rows above it (#211). `columns={2}` sets the rows in two
// columns on wide screens (PageSections' index sections). Related posts, sub-pages and related
// offerings use it under a SectionHeading with weight="secondary"; a family hub's product index under
// a primary one. The rows repeat other pages' titles, so the site search leaves them out.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Item {
  title: string;
  href: string;
  body?: string | undefined;
  image?: ImageMetadata | undefined;
  // YYYY-MM-DD, for posts
  date?: string | undefined;
}

interface Props {
  items: readonly Item[];
  level?: 3 | 4;
  columns?: 1 | 2;
}

const { items, level = 3, columns = 1 } = Astro.props;
const Heading = `h${level}` as const;
---

<ul class:list={['index-list', { two: columns === 2 }]} data-pagefind-ignore>
  {
    items.map((i) => (
      <li class:list={['row', { 'has-image': i.image }]}>
        {i.image && <Image class="thumb" src={i.image} widths={[120, 240]} sizes="7.5rem" alt="" />}
        <div class="text">
          <Heading class="name serif">
            <a href={i.href}>{i.title}</a>
          </Heading>
          {i.body && <p class="body">{i.body}</p>}
          {i.date && <time datetime={i.date}>{i.date.replaceAll('-', '/')}</time>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  @import '../../styles/media.css';

  .index-list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .has-image {
    grid-template-columns: var(--thumb-width) minmax(0, 1fr);
  }

  .thumb {
    display: block;
    inline-size: var(--thumb-width);
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--color-bg-muted);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .name {
    margin: 0;
    font-size: var(--font-size-text);
    line-height: var(--line-height-snug);
  }

  .name a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* The name's link covers the row */
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row:is(:hover, [data-preview-state='hover']) .name a {
    color: var(--color-link-hover);
  }

  .body,
  time {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  /* The sentence is read; the date is meta and stays muted (design-principles.md「說明句的文字色」, #208) */
  .body {
    color: var(--color-text);
  }

  time {
    color: var(--color-text-muted);
  }

  @media (--bp-lg-up) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }
  }
</style>
