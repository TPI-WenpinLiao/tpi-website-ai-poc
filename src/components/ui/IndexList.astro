---
// A list of pages the section leads on to (#187, design-principles.md「內頁的版型」索引列): one row a
// page, its name in the bold serif at --font-size-text, a line and an optional small picture; no
// frame. The whole row is clickable through the name's link; on hover only the name changes color
// and gets an underline. Related posts, sub-pages and related offerings use it, under a SectionHeading
// with weight="secondary". The rows repeat other pages' titles, so the site search leaves them out.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Item {
  title: string;
  href: string;
  body?: string | undefined;
  image?: ImageMetadata | undefined;
  // YYYY-MM-DD, for posts
  date?: string | undefined;
}

interface Props {
  items: readonly Item[];
  level?: 3 | 4;
}

const { items, level = 3 } = Astro.props;
const Heading = `h${level}` as const;
---

<ul class="index-list" data-pagefind-ignore>
  {
    items.map((i) => (
      <li class:list={['row', { 'has-image': i.image }]}>
        {i.image && <Image class="thumb" src={i.image} widths={[160, 320]} sizes="10rem" alt="" />}
        <div class="text">
          <Heading class="name serif">
            <a href={i.href}>{i.title}</a>
          </Heading>
          {i.body && <p class="body">{i.body}</p>}
          {i.date && <time datetime={i.date}>{i.date.replaceAll('-', '/')}</time>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  @import '../../styles/media.css';

  .index-list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .has-image {
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
  }

  .thumb {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--color-bg-muted);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .name {
    margin: 0;
    font-size: var(--font-size-text);
    line-height: var(--line-height-snug);
  }

  .name a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The name's link covers the row */
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row:is(:hover, [data-preview-state='hover']) .name a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .body,
  time {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  /* The sentence is read; the date is meta and stays muted (design-principles.md「說明句的文字色」, #208) */
  .body {
    color: var(--color-text);
  }

  time {
    color: var(--color-text-muted);
  }

  @media (--bp-lg-up) {
    .has-image {
      grid-template-columns: minmax(0, 1fr) minmax(0, 4fr);
    }
  }
</style>
