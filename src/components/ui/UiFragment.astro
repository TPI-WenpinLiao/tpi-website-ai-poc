---
// An interface fragment (#187): a part of a product's screen drawn in HTML, marked 示意, as the
// pictures on offering and hub pages (design-principles.md「內頁共用的規則」影像). It names only what
// the facts name: the panel, its tabs, its settings or states. Never sample data (counts, times,
// curves, client lists): that would be a fake dashboard. Every fragment on a page has the same frame.
// A row's `state`: on (set), off (not set), down (failed, in the error color) or next (what the
// panel moves on to); the fragment's lead-in moves one step when it enters (motion.md), and stays
// finished with reduced motion. The text is real text, so the facts in it can be searched and
// checked; the figure is named by its title and the 示意 mark. A state is also written out for screen
// readers (`words`, the page's strings.layout), so it isn't carried by color alone (WCAG 1.4.1).
interface Row {
  label: string;
  value?: string | undefined;
  state?: 'on' | 'off' | 'down' | 'next' | undefined;
}

interface Props {
  title: string;
  tabs?: readonly string[] | undefined;
  rows: readonly Row[];
  note?: string | undefined;
  // The page's words: the 示意 mark and the state names, in the page's language (strings.layout)
  words: { mark: string; on: string; off: string; down: string };
}

const { title, tabs = [], rows, note, words } = Astro.props;
---

<figure class="ui-fragment" data-ui>
  <div class="frame">
    <div class="bar">
      <span class="title">{title}</span>
      <span class="mark">{words.mark}</span>
    </div>
    {
      tabs.length > 0 && (
        <ul class="tabs">
          {tabs.map((tab, i) => (
            <li class:list={{ active: i === 0 }}>{tab}</li>
          ))}
        </ul>
      )
    }
    <ul class="rows">
      {
        rows.map((r) => (
          <li class:list={['row', r.state]}>
            <span class="label">{r.label}</span>
            {r.value && <span class="value">{r.value}</span>}
            {r.state && r.state !== 'next' && (
              <>
                <span class="state" aria-hidden="true" />
                <span class="sr-only">{words[r.state]}</span>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  {note && <figcaption class="note">{note}</figcaption>}
</figure>

<style>
  .ui-fragment {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  /* One frame for every fragment: the paper a step darker, the panel on white inside it */
  .frame {
    padding: var(--space-4);
    background: var(--color-bg-muted);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .mark {
    font-weight: var(--font-weight-regular);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2) 0 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }

  .tabs li {
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
  }

  .tabs .active {
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .rows {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-bg-muted);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-3);
    align-items: center;
    min-block-size: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    font-size: var(--font-size-sm);
  }

  .label {
    white-space: pre-line;
  }

  .value {
    color: var(--color-text-muted);
  }

  /* A state is a filled square: purple when set, empty when not, the error color when down */
  .state {
    inline-size: var(--space-3);
    block-size: var(--space-3);
    background: var(--color-bg-muted);
  }

  .on .state {
    background: var(--color-action);
  }

  .down .state {
    background: var(--color-error);
  }

  .down .label {
    color: var(--color-error);
  }

  .next {
    background: var(--color-bg-brand-subtle);
    color: var(--color-text-brand);
    font-weight: var(--font-weight-semibold);
  }

  /* The caption under the fragment is body copy in the full text colour (design-principles.md
     「說明句的文字色」, #208); the muted tabs and values are part of the drawn interface */
  .note {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    white-space: pre-line;
  }
</style>
