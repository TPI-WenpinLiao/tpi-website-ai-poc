---
// An interface fragment (#187): a part of a product's screen drawn in HTML, marked 示意, as the
// pictures on offering and hub pages (design-principles.md「內頁共用的規則」影像). It names only what
// the facts name: the panel, its tabs, its settings or states. Never sample data (counts, times,
// curves, client lists): that would be a fake dashboard. Every fragment on a page has the same frame.
// A fragment is a settings panel or a flow of steps (`kind`, #209), and a row's `state` is written
// out in visible words for that kind, with a square beside it as the colour cue, so a state is never
// a mark to guess (P4) nor carried by colour alone (WCAG 1.4.1):
//   settings: on 已啟用, off 未啟用, down 故障 (the error colour)
//   steps:    on 已完成, off 略過, next 下一步 (the row the flow moves on to)
// The words come from the page's strings.layout, so a content file picks a state, never its words.
// The fragment's lead-in moves one step when it enters (motion.md), and stays finished with reduced
// motion. The text is real text, so the facts in it can be searched and checked; the figure is
// named by its title and the 示意 mark.
type SettingsState = 'on' | 'off' | 'down';
type StepsState = 'on' | 'off' | 'next';

interface Row<S> {
  label: string;
  value?: string | undefined;
  state?: S | undefined;
}

type Panel =
  | { kind?: 'settings' | undefined; rows: readonly Row<SettingsState>[] }
  | { kind: 'steps'; rows: readonly Row<StepsState>[] };

type Props = Panel & {
  title: string;
  tabs?: readonly string[] | undefined;
  note?: string | undefined;
  // The page's words: the 示意 mark and the state names, in the page's language (strings.layout)
  words: { mark: string; on: string; off: string; down: string; done: string; skip: string; next: string };
};

const { title, tabs = [], rows, note, words, kind = 'settings' } = Astro.props;
const said = {
  settings: { on: words.on, off: words.off, down: words.down },
  steps: { on: words.done, off: words.skip, next: words.next },
};
const stateWord = (state: SettingsState | StepsState): string | undefined => (said[kind] as Partial<Record<string, string>>)[state];
---

<figure class="ui-fragment" data-ui>
  <div class="frame">
    <div class="bar">
      <span class="title">{title}</span>
      <span class="mark">{words.mark}</span>
    </div>
    {
      tabs.length > 0 && (
        <ul class="tabs">
          {tabs.map((tab, i) => (
            <li class:list={{ active: i === 0 }}>{tab}</li>
          ))}
        </ul>
      )
    }
    <ul class="rows">
      {
        rows.map((r) => (
          <li class:list={['row', r.state]}>
            <span class="label">{r.label}</span>
            {r.value && <span class="value">{r.value}</span>}
            {r.state && (
              <span class="state">
                <span class="square" aria-hidden="true" />
                {stateWord(r.state)}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  {note && <figcaption class="note">{note}</figcaption>}
</figure>

<style>
  .ui-fragment {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  /* One frame for every fragment: the paper a step darker, the panel on white inside it */
  .frame {
    padding: var(--space-4);
    background: var(--color-bg-muted);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .mark {
    font-weight: var(--font-weight-regular);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2) 0 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }

  .tabs li {
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
  }

  .tabs .active {
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .rows {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-bg-muted);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-3);
    align-items: center;
    min-block-size: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    font-size: var(--font-size-sm);
  }

  .label {
    white-space: pre-line;
  }

  .value {
    color: var(--color-text-muted);
  }

  /* A state is its word with a square before it: purple and the brand text when set or done,
     an outlined square and the muted text when not, the error colour when down (#209) */
  .state {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .square {
    flex: none;
    inline-size: var(--space-3);
    block-size: var(--space-3);
    border: var(--border-width) solid currentcolor;
  }

  .on .state,
  .next .state {
    color: var(--color-text-brand);
    font-weight: var(--font-weight-semibold);
  }

  .on .square {
    border-color: var(--color-action);
    background: var(--color-action);
  }

  /* The next step isn't done yet: the brand outline, not filled */
  .next .square {
    border-color: var(--color-action);
  }

  .down .state {
    color: var(--color-error);
    font-weight: var(--font-weight-semibold);
  }

  .down .square {
    background: var(--color-error);
  }

  .down .label {
    color: var(--color-error);
  }

  .next {
    background: var(--color-bg-brand-subtle);
    color: var(--color-text-brand);
    font-weight: var(--font-weight-semibold);
  }

  /* The caption under the fragment is body copy in the full text colour (design-principles.md
     「說明句的文字色」, #208); the muted tabs and values are part of the drawn interface */
  .note {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    white-space: pre-line;
  }
</style>
