---
// Label for a category or topic, in plain text on a pale fill (no mono type or glowing dot,
// design-principles.md「和新寫法衝突的共用元件」, #187). With href it links to the filtered listing.
// A link to an industry page from an offering is a text link that says where it goes, not a Tag.
// data-preview-state="hover" | "focus" draws that state statically, for the /design-system page only.
interface Props {
  href?: string;
  tone?: 'neutral' | 'brand';
  'data-preview-state'?: 'hover' | 'focus';
}

const { href, tone = 'neutral', 'data-preview-state': previewState } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class:list={['tag', 'text-phrase', tone]} href={href} data-preview-state={previewState}><slot /></Element>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-tight);
    text-decoration: none;
  }

  .neutral {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }

  .brand {
    background: var(--color-bg-brand-subtle);
    color: var(--color-text-brand);
  }

  a.tag:is(:hover, [data-preview-state='hover']) {
    text-decoration: underline;
  }
</style>
