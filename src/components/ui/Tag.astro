---
// Label for a category, topic or data point. `node` is the data-flow label: mono text with a
// glowing signal dot, for product modules and technical keywords. With href it links to the
// filtered listing.
// data-preview-state="hover" | "focus" draws that state statically, for the /design-system page only.
interface Props {
  href?: string;
  tone?: 'neutral' | 'brand' | 'node';
  'data-preview-state'?: 'hover' | 'focus';
}

const { href, tone = 'neutral', 'data-preview-state': previewState } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class:list={['tag', 'text-phrase', tone, { 'signal-dot': tone === 'node' }]} href={href} data-preview-state={previewState}><slot /></Element>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-tight);
    text-decoration: none;
  }

  .neutral {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }

  .brand {
    background: var(--color-bg-brand-subtle);
    color: var(--color-text-brand);
  }

  .node {
    border-color: var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-mono);
    text-transform: uppercase;
  }

  a.tag:is(:hover, [data-preview-state='hover']) {
    border-color: var(--color-border-brand);
    text-decoration: underline;
  }
</style>
