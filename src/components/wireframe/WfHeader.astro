---
// Wireframe header (docs/ia/navigation.md): logo, first-level items, then search, locale and the
// 聯絡我們 button. Below 64rem the first-level items collapse behind the menu button.
// Static only: dropdown states are drawn on /wireframes/navigation; behaviour is M4-04.
import { header, utility } from '../../lib/wireframe/ia';
import { zhTW, type HeaderLabels } from '../../lib/wireframe/header-labels';

interface Props {
  labels?: HeaderLabels;
  // Accessible name of the <nav>; must be unique when several headers share a page
  navLabel?: string;
  // Measurement row for nav-fit: always the desktop layout, never wraps
  fit?: boolean;
}

const { labels = zhTW, navLabel = '主選單', fit = false } = Astro.props;
const items = header.filter((h) => !labels.omit?.includes(h.key));
const home = utility.find((u) => u.key === 'home');
const contact = utility.find((u) => u.key === 'contact');
---

<header class:list={['wf-header', { fit }]} lang={labels.lang} data-nav-fit={fit ? labels.id : undefined}>
  <div class="row" data-fit-row>
    <a class="logo" href={home?.href}>TPIsoftware<span class="sr-only">（回首頁）</span></a>
    <nav class="primary" aria-label={navLabel}>
      <ul>
        {
          items.map((item) => (
            <li>
              {item.children.length > 0 ? (
                <button type="button" aria-expanded="false">
                  {labels.items[item.key] ?? item.label}
                  <span class="caret" aria-hidden="true">▾</span>
                </button>
              ) : (
                <a href={item.href}>{labels.items[item.key] ?? item.label}</a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <button type="button" class="icon" aria-label={labels.search}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="6"></circle><path d="M15 15l5 5"></path></svg>
      </button>
      <button type="button" class="locale" aria-expanded="false">
        {labels.locale}<span class="caret" aria-hidden="true">▾</span>
      </button>
      <a class="cta" href={contact?.href}>{labels.contact}</a>
      <button type="button" class="icon menu" aria-expanded="false" aria-label={labels.menu}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .wf-header {
    border-block-end: var(--wf-line-width) solid var(--wf-color-line);
    background: var(--color-bg);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
  }

  .logo {
    flex-shrink: 0;
    padding: var(--space-2) var(--wf-space-3);
    border: var(--wf-line-width) dashed var(--wf-color-line);
    border-radius: var(--wf-radius);
    color: var(--wf-color-label);
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    flex: 1;
    min-width: 0;
  }

  .primary ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wf-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary a,
  .primary button,
  .locale {
    display: inline-flex;
    align-items: center;
    gap: var(--wf-space-1);
    min-height: var(--wf-touch-target);
    padding-inline: var(--wf-space-3);
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .caret {
    font-size: var(--wf-font-size-xs);
    color: var(--wf-color-label);
  }

  .tools {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--wf-space-1);
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: var(--wf-touch-target);
    height: var(--wf-touch-target);
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .icon svg {
    width: 60%;
    height: 60%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--wf-touch-target);
    padding-inline: var(--space-4);
    border-radius: var(--wf-radius);
    background: var(--color-brand);
    color: var(--wf-color-inverse);
    white-space: nowrap;
    text-decoration: none;
  }

  .menu {
    display: none;
  }

  /* Measurement rows keep every item on one line so overflow is visible to nav-fit */
  .fit .primary ul {
    flex-wrap: nowrap;
  }

  .fit .primary {
    flex: 0 0 auto;
  }

  /* 64rem breakpoint, see tokens.css */
  @media (max-width: 63.99rem) {
    .wf-header:not(.fit) .primary,
    .wf-header:not(.fit) .locale {
      display: none;
    }

    .wf-header:not(.fit) .menu {
      display: inline-grid;
    }

    .wf-header:not(.fit) .tools {
      margin-inline-start: auto;
    }

    .wf-header:not(.fit) .cta {
      padding-inline: var(--wf-space-3);
      font-size: var(--wf-font-size-sm);
    }
  }
</style>
