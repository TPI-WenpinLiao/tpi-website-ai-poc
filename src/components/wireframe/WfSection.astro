---
// A page section in the wireframe: the h2 the real page would show, then its blocks
interface Props {
  title: string;
  note?: string;
}

const { title, note } = Astro.props;
---

<section class="wf-section">
  <h2>{title}</h2>
  {note && <p class="note">{note}</p>}
  <slot />
</section>

<style>
  .wf-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
  }

  h2 {
    margin: 0;
    font-size: var(--wf-font-size-h2);
  }

  .note {
    margin: 0;
    color: var(--wf-color-label);
    font-size: var(--wf-font-size-sm);
  }
</style>
