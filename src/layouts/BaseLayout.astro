---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'zh-TW' } = Astro.props;
// build.format 'file' makes pathname end in .html; canonical URLs have no extension or trailing slash (ADR 0002)
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '') || '/';
const canonical = new URL(pathname, Astro.site).href;
const ogLocale = lang.replace('-', '_');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="TPIsoftware 昕力資訊" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
    color: var(--color-text);
    background: var(--color-bg);
  }

  /* Semantic tokens switch on any data-surface="dark" element; give it the matching paint */
  [data-surface='dark'] {
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* One focus style for every interactive element; the offset keeps the ring on the surrounding
     surface, which is what scripts/design/contrast.mjs checks it against. */
  :focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .sr-only {
    position: absolute;
    width: var(--border-width);
    height: var(--border-width);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
