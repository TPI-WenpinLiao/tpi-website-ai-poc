---
import '../styles/tokens.css';
import '../styles/base.css';
import Seo, { type Props as SeoProps } from '../components/seo/Seo.astro';
import type { LocaleLink } from '../lib/i18n/alternates';
import { localeFromPath, normalizePath } from '../lib/i18n/paths';
import { pageLocales } from '../lib/i18n/routes';

// Every SEO prop goes to Seo (src/components/seo/Seo.astro). `locales` defaults to the static
// page's own; PageLayout passes the list it also hands the header, for pages with `translations`
type Props = Omit<SeoProps, 'locales'> & { locales?: readonly LocaleLink[] };

const { locales = pageLocales(Astro.url.pathname), ...seo } = Astro.props;
const lang = localeFromPath(normalizePath(Astro.url.pathname));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} locales={locales} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>

