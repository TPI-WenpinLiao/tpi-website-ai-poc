---
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'zh-TW' } = Astro.props;
// build.format 'file' makes pathname end in .html; canonical URLs have no extension or trailing slash (ADR 0002)
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '') || '/';
const canonical = new URL(pathname, Astro.site).href;
const ogLocale = lang.replace('-', '_');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="TPIsoftware 昕力資訊" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
    color: var(--color-text);
    background: var(--color-bg);
  }
</style>
