---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import { localeFromPath, normalizePath } from '../lib/i18n/paths';

interface OgImage {
  // Site-relative path or absolute URL
  src: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  // Falls back to the site-wide default (content-model.md `ogImage`), rendered by
  // scripts/design/og-image.mjs
  image?: OgImage;
}

const DEFAULT_IMAGE: OgImage = { src: '/og/default.png', width: 1200, height: 630, alt: 'TPIsoftware 昕力資訊' };

const { title, description, image = DEFAULT_IMAGE } = Astro.props;
// canonical URLs have no .html, /index or trailing slash; the locale comes from the URL prefix (ADR 0002)
const pathname = normalizePath(Astro.url.pathname);
const lang = localeFromPath(pathname);
const canonical = new URL(pathname, Astro.site).href;
const ogLocale = lang.replace('-', '_');
const imageUrl = new URL(image.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="TPIsoftware 昕力資訊" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Sizes include padding and border. Without this, <a> buttons and text inputs (content-box)
     outgrow <button> and <select> (border-box in the UA stylesheet) with the same min-height. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
    color: var(--color-text);
    background: var(--color-bg);
  }

  /* Short display text breaks Chinese only at spaces and punctuation, never inside a word
     (數位轉／型, 與能／源): headings, and lead text or labels marked .text-phrase. A run too long for
     the line still breaks anywhere instead of overflowing; a line-start full-width opening bracket
     drops its blank half where the font supports it (PingFang TC, Noto Sans TC). Not for body
     paragraphs, where breaks only at punctuation would leave ragged lines. */
  :is(h1, h2, h3, h4, h5, h6),
  .text-phrase {
    word-break: keep-all;
    overflow-wrap: anywhere;
    text-spacing-trim: trim-start;
  }

  /* Semantic tokens switch on any data-surface="dark" element; give it the matching paint */
  [data-surface='dark'] {
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* One focus style for every interactive element; the offset keeps the ring on the surrounding
     surface, which is what scripts/design/contrast.mjs checks it against. data-preview-state="focus"
     draws it statically on the /design-system page. */
  :focus-visible,
  [data-preview-state='focus'] {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .sr-only {
    position: absolute;
    width: var(--border-width);
    height: var(--border-width);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
