---
// Layout for the M3-01 wireframe pages: a yellow annotation bar (what this page is, which nodes
// use the template), then the page as it would be laid out: header, main, footer.
import BaseLayout from './BaseLayout.astro';
import WfHeader from '../components/wireframe/WfHeader.astro';
import WfFooter from '../components/wireframe/WfFooter.astro';
import { templates } from '../lib/wireframe/ia';

interface Props {
  title: string;
  description: string;
  // templates.csv id; lists the nodes that use it in the annotation bar
  template?: string;
}

const { title, description, template } = Astro.props;
const tpl = template ? templates.find((t) => t.id === template) : undefined;
if (template && !tpl) throw new Error(`templates.csv has no template ${template}`);
---

<BaseLayout title={`${title}｜wireframe｜TPIsoftware 昕力資訊`} description={description}>
  <a class="skip" href="#main">跳到主要內容</a>
  <div class="annotation">
    <div class="inner">
      <p class="crumb"><a href="/wireframes">M3-01 wireframe</a>（低保真，只確認區塊與層級）</p>
      <h1>{title}</h1>
      <p>{description}</p>
      {
        tpl && (
          <details>
            <summary>使用此模板的節點（{tpl.nodes.length}）</summary>
            <ul>
              {tpl.nodes.map((n) => (
                <li>
                  {n.title}（<code>{n.id}</code>，<code>{n.path}</code>）
                </li>
              ))}
            </ul>
          </details>
        )
      }
      <slot name="notes" />
    </div>
  </div>
  <WfHeader />
  <main id="main">
    <slot />
  </main>
  <WfFooter />
</BaseLayout>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: calc(-1 * var(--wf-space-12));
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .skip:focus {
    inset-block-start: var(--space-2);
  }

  .annotation {
    border-block-end: var(--wf-line-width) solid var(--wf-color-note-line);
    background: var(--wf-color-note-bg);
    font-size: var(--wf-font-size-sm);
  }

  .inner {
    box-sizing: content-box;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-4);
  }

  .inner p,
  .inner ul {
    margin: 0 0 var(--space-2);
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-h1);
  }

  a {
    color: var(--color-text);
  }

  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-sizing: content-box;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-4);
  }
</style>
