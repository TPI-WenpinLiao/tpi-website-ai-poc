---
// Layout of every site page (M4-04, #23): header, scroll progress, <main id="main"> and footer
// around the page content. The page's locale versions are decided here once (pageLocales) and go
// to both the <head> (hreflang) and the header's language menu. Pages built through a dynamic route
// pass their other locale versions as `translations`.
// The `nav` slot sits between the header and <main>, for an in-page table of contents (InPageNav).
// On internal pages (the /templates previews) a bar says the page shows sample data, and the
// title and description say so too, so they don't repeat those of the real page.
// Pages passing `searchTrail` go into the Pagefind index (src/integrations/pagefind.ts): <main> gets
// data-pagefind-body, and pages below a first-level page are labelled with their parent's name in
// the search results (部落格, 新聞中心, a product family). Pages without it (home, listings, utility, internal pages) are left out.
// Builds with PUBLIC_GTM_ID get the cookie consent banner after the footer, at body level, and the
// footer's Cookie 設定 button (src/lib/consent/page.ts, ADR 0007), except on internal pages; without
// it neither is rendered.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import type { Props as SeoProps } from '../components/seo/Seo.astro';
import { pageLocales } from '../lib/i18n/routes';
import { isInternal } from '../lib/seo/indexing';
import { consentProps } from '../lib/consent/page';
import { localeFromPath, normalizePath } from '../lib/i18n/paths';
import type { TrailNode } from '../lib/ia/navigation';

type Props = Omit<SeoProps, 'locales'> & {
  // URL paths of this page's other locale versions (dynamic routes only; static pages are found
  // in staticRoutes)
  translations?: readonly string[];
  // The page's breadcrumb trail, for pages that are found through the site search
  searchTrail?: readonly TrailNode[];
};

const { translations, searchTrail, title, description, ...seo } = Astro.props;
const locales = pageLocales(Astro.url.pathname, translations);
const preview = isInternal(Astro.url.pathname);
// Template previews show sample data, so they stay out of the index like the other internal pages
const indexed = searchTrail !== undefined && !preview;
const section = indexed && searchTrail.length > 2 ? searchTrail.at(-2)?.title : undefined;
const PREVIEW = '模板預覽';
// Not on the template previews: their sample data must not reach the GTM container
const consent = preview ? undefined : consentProps(localeFromPath(normalizePath(Astro.url.pathname)));
// Imported only when the build has a GTM ID: a static import would add the banner's CSS to every page
const ConsentBanner = import.meta.env.PUBLIC_GTM_ID ? (await import('../components/ui/ConsentBanner.astro')).default : undefined;
---

<BaseLayout
  {...seo}
  title={preview ? `${PREVIEW}：${title}` : title}
  description={preview ? `${PREVIEW}（範例資料）：${title}。${description}` : description}
  locales={locales}
>
  <SiteHeader locales={locales} />
  <!-- After the header: same z-index, so the later one paints the bar on top of the header -->
  <ScrollProgress />
  <!-- Below the header: above it, the notice would uncover the skip link hidden above the header -->
  {preview && <p class="preview-notice">{PREVIEW}：範例資料，包含不會發布的 draft 內容；不在導覽與 sitemap 裡。</p>}
  <slot name="nav" />
  <main id="main" data-pagefind-body={indexed ? '' : undefined} data-pagefind-meta={section && `section:${section}`}>
    <slot />
  </main>
  <SiteFooter consentSettings={consent?.footer} />
  {consent && ConsentBanner && <ConsentBanner id={consent.id} config={consent.config} categories={consent.categories} copy={consent.copy} />}
</BaseLayout>

<style>
  .preview-notice {
    margin: 0;
    padding: var(--space-2) var(--space-gutter);
    background: var(--color-bg-accent-subtle);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    text-align: center;
  }
</style>
