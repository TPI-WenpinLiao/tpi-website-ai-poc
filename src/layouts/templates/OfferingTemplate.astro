---
// offering template (M4-04, #23): products, solutions and services, from an offering entry. Built
// from the approved digiRunner page (M3-05, #18), whose structure follows the M3-01 offering wireframe (#14).
// Copy comes from the entry; names, paths and parents from docs/ia (src/lib/ia/navigation.ts).
// Blocks without data are left out, so is their anchor.
// Light paper throughout (ribbon-route, #167): no 3D scene on offering pages (ADR 0003「ribbon-route」).
// An entry with `sections` is laid out by its brief, section by section (#187, PageSections); other
// entries keep the older fields: features and use cases as claims with their facts (FactRow). Cases
// are rows (CaseList), related offerings, downloads and posts are index rows (IndexList); no cards.
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import FactRow from '../../components/ui/FactRow.astro';
import Surface from '../../components/ui/Surface.astro';
import CaseList from '../../components/ui/CaseList.astro';
import IndexList from '../../components/ui/IndexList.astro';
import MapPicture from '../../components/ui/MapPicture.astro';
import PageSections from '../../components/ui/PageSections.astro';
import Link from '../../components/ui/Link.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import InPageNav from '../../components/ui/InPageNav.astro';
import Faq from '../../components/ui/Faq.astro';
import ContactCta from '../../components/ui/ContactCta.astro';
import { breadcrumb, children, contactAction, hasPage, localeHref, localNode, node, nodeHref } from '../../lib/ia/navigation';
import type { PictureName } from '../../lib/scene/ribbon/labels';
import { linkedNodes } from '../../lib/content/sections';
import { entryLocale, isPublished } from '../../lib/content/entries';
import { COLLECTION_NODES, entryPath } from '../../lib/content/urls';
import { offeringJsonLd } from '../../lib/seo/jsonld/offering';
import { canonicalUrl, titleSeparator } from '../../lib/seo/meta';
import { defaultOgImage } from '../../lib/seo/og';
import { caseLinkLabel, postCard } from '../../lib/content/cards';
import { newest } from '../../lib/content/listings';
import { strings } from '../../data/strings';

interface Props {
  entry: CollectionEntry<'offering'>;
  translations?: readonly string[];
}

const { entry, translations } = Astro.props;
const { data } = entry;
const locale = entryLocale(entry.id);
const t = strings(locale);
const href = localeHref(locale);
const self = localNode(data.node, locale);

const title = data.seoTitle ?? data.title;
// Main call to action by the entry's cta (content-model.md); 預約演示 is the current site's wording
const ctaLabel = data.cta === 'demo' ? t.offering.demo : contactAction(locale);

const sections = data.sections ?? [];
const heroPoints = (data.heroPoints ?? []).map((p) => (typeof p === 'string' ? { text: p } : p));
// An entry without a hero picture shows its product family's (the family hub's heroImage, #187), so
// the first screen of every product page has a picture without each entry naming one
const familyOf = (id: string | undefined): string | undefined =>
  !id ? undefined : id.startsWith('family-') ? id : familyOf(node(id).parent);
const familyId = data.heroImage ? undefined : familyOf(self.parent);
const familyImage = familyId
  ? (await getCollection('hub', (h) => h.data.node === familyId && entryLocale(h.id) === locale))[0]?.data.heroImage
  : undefined;
const heroImage = data.heroImage ?? familyImage;
// The hero picture's labels need the picture's name in pictures.json: the file's base name
const heroPicture = data.heroImage && data.heroLabels ? (data.heroImage.src.split('/').pop()?.split('.')[0] as PictureName | undefined) : undefined;
const features = (sections.length ? [] : (data.features ?? [])).map((f) => ({ ...f, href: f.link ? href(node(f.link.node)) : undefined }));
const secondary = data.secondaryCta && { label: data.secondaryCta.label, href: href(node(data.secondaryCta.node)) };
// The use cases block sits after this many features (useCasesAfter, #167), else after all of them
const splitAt = Math.min(data.useCasesAfter ?? features.length, features.length);
const useCasesTitle = data.useCasesTitle ?? t.offering.useCases;
const INDUSTRY_NODES = { finance: 'industry-finance', government: 'industry-government', manufacturing: 'industry-manufacturing' } as const;
const useCases = (sections.length ? [] : (data.useCases ?? [])).map((u) => {
  const hub = u.industry ? localNode(INDUSTRY_NODES[u.industry], locale) : undefined;
  return { ...u, hub, href: hub && hasPage(hub) ? href(hub) : undefined };
});
// The features, split around the use cases block: one list of blocks so a feature is written once
type Feature = (typeof features)[number];
const blocks: ({ kind: 'features'; items: Feature[]; start: number; first: boolean } | { kind: 'use-cases' })[] = [
  ...(splitAt > 0 ? [{ kind: 'features' as const, items: features.slice(0, splitAt), start: 0, first: true }] : []),
  ...(useCases.length > 0 ? [{ kind: 'use-cases' as const }] : []),
  ...(features.length > splitAt ? [{ kind: 'features' as const, items: features.slice(splitAt), start: splitAt, first: splitAt === 0 }] : []),
];
// Fourth-level pages under this offering (navigation.md: linked from here, not from the header)
// Fourth-level pages a section already links to (digiRunner on Cloud from 先試用再決定) aren't listed again
const linkedInSections = linkedNodes(sections);
const related = children(self.id, locale).flatMap((n) => {
  const to = n.kind === 'page' && !linkedInSections.has(n.id) ? href(n) : undefined;
  return to ? [{ title: n.title, href: to }] : [];
});
// Whitepapers point at their offering (whitepaper.offeringNode); drafts have no page
const whitepapers = (
  await getCollection('whitepaper', (w) => entryLocale(w.id) === locale && isPublished(w) && w.data.offeringNode === self.id)
).flatMap((w) => {
  const to = href(node(w.data.node));
  return to ? [{ title: w.data.title, cover: w.data.coverImage, href: to }] : [];
});
const downloads = data.downloads ?? [];
// People whose collection node sits under this offering (the ESG advisors under esg-advisory), in
// the current site's team order
const team =
  node(COLLECTION_NODES.person).parent === self.id
    ? (await getCollection('person', (p) => entryLocale(p.id) === locale && isPublished(p)))
        .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || a.data.title.localeCompare(b.data.title))
        .map((p) => ({ title: p.data.title, role: [p.data.jobTitle, p.data.affiliation].filter(Boolean).join(titleSeparator(locale)), href: entryPath('person', p) }))
    : [];
// Blog posts whose relatedOfferings name this offering; relatedPosts, when set, picks and orders
// them, else newest first (content-model.md「offering」: relatedPosts only lists linked posts, so
// another post fails the build). None filled yet, so the block stays out until the content owner
// fills them (overrides.yaml)
const linked = await getCollection('blog', (b) => entryLocale(b.id) === locale && !!b.data.relatedOfferings?.some((r) => r.id === entry.id));
const unlinked = (data.relatedPosts ?? []).filter((r) => !linked.some((b) => b.id === r.id)).map((r) => r.id);
if (unlinked.length) throw new Error(`${entry.id}: relatedPosts lists posts whose relatedOfferings don't name it: ${unlinked.join(', ')}`);
const posts = (data.relatedPosts?.length ? data.relatedPosts.flatMap((r) => linked.filter((b) => b.id === r.id)) : linked.toSorted(newest))
  .filter(isPublished)
  .slice(0, 3)
  .map(postCard);
// Case studies whose offerings name this offering; relatedCaseStudies, when set, picks and orders
// them (content-model.md「offering」), else the case-study order
const linkedCases = await getCollection(
  'case-study',
  (c) => entryLocale(c.id) === locale && isPublished(c) && !!c.data.offerings?.some((o) => o.id === entry.id),
);
const caseStudies = (
  data.relatedCaseStudies?.length
    ? data.relatedCaseStudies.flatMap((r) => linkedCases.filter((c) => c.id === r.id))
    : linkedCases.toSorted((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
);
// Rows of cases: the brief's caseNotes when the entry has them (client, work, result, award; a case
// without a client, the fraud platform, is headed by its work), else
// the linked case studies with their client and title
const caseHref = async (id: string) => {
  const c = linkedCases.find((e) => e.id === id) ?? (await getCollection('case-study', (e) => e.id === id))[0];
  return c && { label: caseLinkLabel(c), href: entryPath('case-study', c) };
};
const caseRows = data.caseNotes
  ? await Promise.all(
      data.caseNotes.map(async (n) => ({ title: n.client ?? n.work, work: n.client ? n.work : undefined, result: n.result, award: n.award, fragment: n.fragment, link: n.caseStudy ? await caseHref(n.caseStudy.id) : undefined })),
    )
  : caseStudies.map((c) => ({ title: c.data.client.disclosed ? c.data.client.name : c.data.clientDescription, link: { label: caseLinkLabel(c), href: entryPath('case-study', c) } }));
const successStories = localNode('success-stories', locale);
const faq = data.faq ?? [];
const hasDownloads = whitepapers.length + downloads.length > 0;
// Related offerings and downloads share a row on wide screens when both are there; alone, related
// offerings take the three-column card grid
const split = related.length > 0 && hasDownloads;

const anchors = [
  { href: '#features', label: t.offering.features, show: features.length > 0 },
  { href: '#use-cases', label: useCasesTitle, show: useCases.length > 0 },
  ...sections.flatMap((sec) => (sec.id ? [{ href: `#${sec.id}`, label: sec.heading, show: true }] : [])),
  { href: '#cases', label: successStories.title, show: caseRows.length > 0 },
  { href: '#team', label: t.offering.team, show: team.length > 0 },
  { href: '#related', label: t.offering.related, show: related.length > 0 },
  { href: '#downloads', label: t.offering.downloads, show: hasDownloads },
  { href: '#faq', label: t.offering.faq, show: faq.length > 0 },
  { href: '#posts', label: t.relatedPosts, show: posts.length > 0 },
].filter((a) => a.show);

// Structured data (content-model.md「offering」): the entry, its nodes.csv trail and the
// organization data file of this page's locale
const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
// Page image: heroImage, else ogImage, else the site default (content-model.md「共用欄位」)
const pageImage = data.heroImage ?? data.ogImage;
const ogImage = pageImage && { src: pageImage.src, width: pageImage.width, height: pageImage.height, alt: data.title };
const trail = breadcrumb(self.id, locale);
const jsonLd = offeringJsonLd({
  offering: data,
  org: org.data,
  site: Astro.site,
  url: canonicalUrl(Astro.url.pathname, Astro.site),
  imageUrl: new URL((ogImage ?? defaultOgImage(locale)).src, Astro.site).href,
  trail,
  inLanguage: locale,
});

const blog = localNode('blog', locale);
---

<PageLayout searchTrail={trail} title={title} description={data.description} image={ogImage} jsonLd={jsonLd} translations={translations}>
  <InPageNav slot="nav" label={t.toc} items={anchors} />
  <PageHero title={data.title} description={data.tagline} lead={data.heroLead} points={heroPoints}>
    <Breadcrumb slot="breadcrumb" node={self.id} />
    <Fragment slot="actions">
      <Button href={nodeHref('contact', locale)} size="lg">{ctaLabel}</Button>
      {
        secondary ? (
          <Button href={secondary.href} size="lg" variant="secondary">
            {secondary.label}
          </Button>
        ) : (
          features.length > 0 && (
            <Button href="#features" size="lg" variant="secondary">
              {t.offering.seeFeatures}
            </Button>
          )
        )
      }
    </Fragment>
    {
      heroImage &&
        (heroPicture && data.heroImage ? (
          <MapPicture slot="visual" image={data.heroImage} picture={heroPicture} labels={data.heroLabels} priority />
        ) : (
          <Image slot="visual" class="hero-image" src={heroImage} widths={[640, 960, 1280]} sizes="(width >= 64rem) 36rem, 100vw" alt="" priority />
        ))
    }
  </PageHero>

  <PageSections sections={sections} locale={locale} />

  {
    blocks.map((block) =>
      block.kind === 'features' ? (
        <Surface tone="light" id={block.first ? 'features' : undefined} class:list={{ 'anchor-target': block.first }}>
          {/* Every block of features has its heading, so features after the use cases aren't read as part of them */}
          <h2 class="sr-only">{t.offering.features}</h2>
          <ul class="features">
            {block.items.map((f) => (
              <li>
                <FactRow level={3} title={f.title} description={f.body} link={f.link && f.href ? { label: f.link.label, href: f.href } : undefined}>
                  {f.points?.map((p) => (
                    <li>{p}</li>
                  ))}
                </FactRow>
              </li>
            ))}
          </ul>
        </Surface>
      ) : (
        <Surface tone="light" fill="subtle" id="use-cases" class="anchor-target">
          <SectionHeading title={useCasesTitle} />
          <ul class="use-cases">
            {useCases.map((u) => (
              <li>
                <h3 class="use-case-title">{u.title}</h3>
                <p class="use-case-body">{u.body}</p>
                {u.href && (
                  <Link href={u.href} variant="standalone">
                    {u.hub?.title}
                  </Link>
                )}
              </li>
            ))}
          </ul>
        </Surface>
      ),
    )
  }

  {
    caseRows.length > 0 && (
      <Surface tone="light" id="cases" class="anchor-target">
        <SectionHeading title={successStories.title} description={data.caseNotes ? undefined : data.casesIntro} />
        <CaseList items={caseRows} linkHeading mark={t.layout.mark} more={{ label: t.layout.allCases, href: nodeHref('success-stories', locale) }} />
      </Surface>
    )
  }

  {
    team.length > 0 && (
      <Surface tone="light" id="team" class="anchor-target">
        <SectionHeading title={t.offering.team} />
        <IndexList items={team.map((p) => ({ title: p.title, body: p.role, href: p.href }))} />
      </Surface>
    )
  }

  {
    (related.length > 0 || hasDownloads) && (
      <Surface tone="light">
        <div class:list={['pair', { split }]}>
          {related.length > 0 && (
            <div id="related" class="anchor-target minor">
              <SectionHeading title={t.offering.related} weight="secondary" />
              <IndexList items={related} />
            </div>
          )}
          {hasDownloads && (
            <div id="downloads" class="anchor-target minor">
              <SectionHeading title={t.offering.downloads} weight="secondary" />
              <IndexList
                items={[...whitepapers.map((w) => ({ title: w.title, href: w.href, image: w.cover })), ...downloads.map((d) => ({ title: d.label, href: d.file }))]}
              />
            </div>
          )}
        </div>
      </Surface>
    )
  }

  {
    faq.length > 0 && (
      <Surface tone="light" width="reading" id="faq" class="anchor-target">
        <SectionHeading title={t.offering.faq} />
        <div class="faq">
          <Faq items={faq} />
        </div>
      </Surface>
    )
  }

  {
    posts.length > 0 && (
      <Surface tone="light" id="posts" class="anchor-target">
        <div class="minor">
          <SectionHeading title={t.relatedPosts} weight="secondary">
            <Button slot="action" href={nodeHref('blog', locale)} variant="text">
              {blog.title}
            </Button>
          </SectionHeading>
          <IndexList items={posts.map((p) => ({ title: p.title, href: p.href, image: p.image?.src, date: p.date }))} />
        </div>
      </Surface>
    )
  }

  <ContactCta label={ctaLabel} />
</PageLayout>

<style>
  @import '../../styles/media.css';

  /* Features down the page (FactRow), set apart by space */
  .features {
    display: grid;
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .use-cases {
    display: grid;
    gap: var(--space-8) var(--grid-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .use-cases li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .use-case-title {
    margin: 0;
    font-size: var(--font-size-text);
    line-height: var(--line-height-snug);
  }

  .use-case-body {
    margin: 0;
  }

  .hero-image {
    inline-size: 100%;
    block-size: auto;
  }

  .minor {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Related offerings and downloads side by side on wide screens, when both are there */
  .pair {
    display: grid;
    gap: var(--space-section);
  }

  .faq {
    margin-block-start: var(--space-10);
  }

  @media (--bp-sm-up) {
    .use-cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (--bp-lg-up) {
    .pair.split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
