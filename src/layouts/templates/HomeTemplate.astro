---
// Home page, direction B Modular Stack (M3-04, #17; built from the M3-07 prototype). Structure
// follows the approved M3-01 home wireframe (#14).
// The hero and the product-family chapters form the scene track: the static hero image is the LCP
// and the complete fallback, and the 3D scene (Scene3D, ADR 0003) plays behind the chapters as
// they scroll. Names, paths and order come from docs/ia (src/lib/ia/navigation.ts); copy comes
// from the current site through src/data/home/<locale>.ts. src/pages/index.astro draws the zh-TW
// home, src/pages/[locale]/index.astro the others.
import PageLayout from '../PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import Scene3D from '../../components/ui/Scene3D.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';
import Surface from '../../components/ui/Surface.astro';
import Card from '../../components/ui/Card.astro';
import Tag from '../../components/ui/Tag.astro';
import LayerStack from '../../components/ui/LayerStack.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SceneChapter from '../../components/ui/SceneChapter.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import ContactCta from '../../components/ui/ContactCta.astro';
import { children, localeHref, localizedNav, localNode, node, nodeHref, type NavItem } from '../../lib/ia/navigation';
import { latest } from '../../lib/latest-posts';
import { SCENE_FAMILIES } from '../../lib/scene/families';
import { homeJsonLd } from '../../lib/seo/jsonld/home';
import { siteName } from '../../lib/seo/meta';
import type { Locale } from '../../lib/i18n/locales';
import { getEntry } from 'astro:content';
import { home } from '../../data/home';
import image from '../../assets/design/hero-modular-stack.webp';
import mobile from '../../assets/design/hero-modular-stack-mobile.webp';
import coverData from '../../assets/design/cover-data.webp';
import coverIntegration from '../../assets/design/cover-integration.webp';
import coverPlatform from '../../assets/design/cover-platform.webp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta, hero, familyLines, orientAi, industryLines, cases, labels } = home(locale);
const href = localeHref(locale);

// Products are the ones the header lists, in its order (navigation.csv, e.g. OrientAI first).
// Products left out of the navigation are 待確認 whether they are still sold (nodes.csv note,
// sitemap.md decision 2), so the home page doesn't show them either.
const flatten = (items: NavItem[]): string[] => items.flatMap((i) => [i.key, ...flatten(i.children)]);
const navOrder = flatten(localizedNav('header', locale));
// Card headings drop the brand in brackets: nodes.csv titles such as 「AI（SysTalk.ai）」 show as 「AI」
// One chapter per family, in the scene's module order
const families = SCENE_FAMILIES.map((id) => {
  const family = localNode(id, locale);
  return {
    id,
    heading: family.title.replace(/（[^）]*）$/, ''),
    brand: /（([^）]*)）$/.exec(family.title)?.[1],
    href: nodeHref(id, locale),
    line: familyLines[id]?.text,
    products: children(id, locale)
      .filter((p) => navOrder.includes(p.id))
      .toSorted((a, b) => navOrder.indexOf(a.id) - navOrder.indexOf(b.id)),
  };
});
const contact = localNode('contact', locale);
const products = localNode('products', locale);

const orient = node(orientAi.node);
const industries = children('industries', locale).map((n) => ({ ...n, line: industryLines[n.id]?.text }));
const services = children('services', locale);
const successStories = localNode('success-stories', locale);
const caseCards = cases.map((c) => ({ ...c, href: href(node(c.node)) }));
// Wireframe: two blog posts and one news item. Covers are the abstract placeholders until M5
// migrates the posts with their own images; decorative, so alt is empty.
const COVERS = [coverData, coverIntegration, coverPlatform];
const posts = [...latest('blog', 2, locale), ...latest('news', 1, locale)].map((p, i) => ({ ...p, cover: COVERS[i % COVERS.length] }));
const blog = localNode('blog', locale);
const news = localNode('media-center', locale);
// Structured data from the organization data file of this page's locale
const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
const jsonLd = homeJsonLd({
  org: org.data,
  site: Astro.site,
  logoUrl: new URL(org.data.logo.src, Astro.site).href,
  inLanguage: locale,
});

// Reveal staggers each row of a three-column grid
const stagger = (i: number) => (i % 3) as 0 | 1 | 2;
---

<PageLayout title={meta.title} titleSuffix={false} description={meta.description} jsonLd={jsonLd}>
  <div class="track" data-scene-track>
    <PageHero eyebrow={siteName(locale)} title={hero.title.text} description={hero.description.text}>
      <Backdrop slot="backdrop" image={image} mobile={mobile} fade="hero" focus="end" priority />
      <Scene3D slot="backdrop" direction="modular-stack" />
      <Fragment slot="actions">
        <Button href={href(contact)} size="lg">{contact.title}</Button>
        <Button href={href(products)} size="lg" variant="secondary">{products.title}</Button>
      </Fragment>
    </PageHero>

    <section aria-labelledby="families-title">
      <h2 id="families-title" class="sr-only">{labels.families}</h2>
      {
        families.map((f, i) => (
          <SceneChapter>
            <SectionHeading
              level={3}
              index={String(i + 1).padStart(2, '0')}
              eyebrow={f.brand ?? 'Product family'}
              title={f.heading}
              description={f.line}
            />
            <ul class="items">
              {f.products.map((p) => (
                <li class="text-phrase">
                  <a href={href(p)}>{p.title}</a>
                </li>
              ))}
            </ul>
            <Link href={f.href}>{labels.familyLink(f.heading)}</Link>
          </SceneChapter>
        ))
      }
    </section>
  </div>

  <Surface tone="dark" pattern="grid">
    <div class="spotlight">
      <div class="spotlight-copy">
        <SectionHeading eyebrow={orientAi.eyebrow.text} title={orientAi.title.text} />
        <ul class="features" aria-label={labels.orientFeatures}>
          {
            orientAi.features.map((f) => (
              <li>
                <Tag tone="node">{f.text}</Tag>
              </li>
            ))
          }
        </ul>
        <Button href={href(orient)} size="lg">{orientAi.action.text}</Button>
      </div>
      <LayerStack layers={5} />
    </div>
  </Surface>

  <!-- The wireframe's three entry points (industries, services, success stories) share one surface -->
  <Surface tone="dark">
    <div class="blocks">
      <div>
        <SectionHeading eyebrow="Industries" title={localNode('industries', locale).title} />
        <CardGrid>
          {
            industries.map((n, i) => (
              <li>
                <Reveal delay={stagger(i)}>
                  <Card title={n.title} href={href(n)} description={n.line} />
                </Reveal>
              </li>
            ))
          }
        </CardGrid>
      </div>

      <div>
        <SectionHeading eyebrow="Services" title={localNode('services', locale).title} />
        <CardGrid compact>
          {
            services.map((n, i) => (
              <li>
                <Reveal delay={stagger(i)}>
                  <Card title={n.title} href={href(n)} size="sm" />
                </Reveal>
              </li>
            ))
          }
        </CardGrid>
      </div>

      <div>
        <SectionHeading eyebrow="Success stories" title={successStories.title}>
          <Button slot="action" href={href(successStories)} variant="secondary">{labels.all(successStories.title)}</Button>
        </SectionHeading>
        <CardGrid>
          {
            caseCards.map((c, i) => (
              <li>
                <Reveal delay={stagger(i)}>
                  <Card title={c.title.text} href={c.href} eyebrow={successStories.title} description={c.summary.text} />
                </Reveal>
              </li>
            ))
          }
        </CardGrid>
      </div>
    </div>
  </Surface>

  <Surface tone="light">
    <SectionHeading eyebrow="Insights" title={labels.latest}>
      <Fragment slot="action">
        <Button href={href(blog)} variant="text">{blog.title}</Button>
        <Button href={href(news)} variant="text">{news.title}</Button>
      </Fragment>
    </SectionHeading>
    <CardGrid>
      {
        posts.map((p, i) => (
          <li>
            <Reveal delay={stagger(i)}>
              <Card title={p.title} href={p.href} eyebrow={p.label} image={{ src: p.cover, alt: '' }} date={p.published} />
            </Reveal>
          </li>
        ))
      }
    </CardGrid>
  </Surface>

  <ContactCta />
</PageLayout>

<style>
  @import '../../styles/media.css';

  /* One product per row: equal-width rows on a hairline grid, so long names wrap under their own
     first line instead of making uneven pills */
  /* Two columns keep the panel short: the AI family has ten products, and on narrow screens the
     panel must leave the upper part of the viewport to the scene */
  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
    align-self: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .items li {
    display: grid;
    grid-template-columns: var(--space-2) minmax(0, 1fr);
    gap: var(--space-2);
    align-items: center;
    /* Every row draws both lines and overlaps the one above */
    border-block: var(--border-width) solid var(--glass-border);
    margin-block-start: calc(var(--border-width) * -1);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-snug);
  }

  .items li::before {
    content: '';
    block-size: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    box-shadow: var(--glow-accent);
  }

  .items a {
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: var(--color-text);
    text-decoration: none;
  }

  .items a:hover {
    color: var(--color-link-hover);
  }

  /* OrientAI spotlight: copy on the start side, the CSS 3D stack on the end side */
  .spotlight {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .spotlight-copy {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-8);
  }

  .features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-section);
  }

  @media (--bp-lg-up) {
    .spotlight {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .items {
      column-gap: var(--space-6);
    }

    .items li {
      font-size: var(--font-size-sm);
    }
  }
</style>
