---
// case-study template (M4-04, #23): a success story, from a case-study entry. Structure follows
// the M3-01 case-study wireframe (#14): title block with the client (or, when not disclosed, only its
// description and industry: content-model.md「case-study」) beside the cover, results, challenge,
// approach with the Markdown body, the offerings used, other cases (same industry first), contact.
// The current site has no case pages yet (nodes.csv note), so this is the layout's place.
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Surface from '../../components/ui/Surface.astro';
import Card from '../../components/ui/Card.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import Reveal from '../../components/ui/Reveal.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Prose from '../../components/ui/Prose.astro';
import ContactCta from '../../components/ui/ContactCta.astro';
import { entryTrail } from '../../lib/ia/navigation';
import { entryLocale, isPublished } from '../../lib/content/entries';
import { caseCard, industryTitle } from '../../lib/content/cards';
import { entryPath, nodeEntryPath } from '../../lib/content/urls';
import { caseStudyJsonLd } from '../../lib/seo/jsonld/article';
import { canonicalUrl } from '../../lib/seo/meta';
import { strings } from '../../data/strings';

interface Props {
  entry: CollectionEntry<'case-study'>;
  translations?: readonly string[];
}

const { entry, translations } = Astro.props;
const { data } = entry;
const locale = entryLocale(entry.id);
const t = strings(locale);
const inLocale = (e: { id: string; data: { draft: boolean } }) => entryLocale(e.id) === locale && isPublished(e);
const trail = entryTrail('case-study', { title: data.title, path: entryPath('case-study', entry) }, locale);
const { Content } = await render(entry);
const client = data.client.disclosed ? data.client.name : data.clientDescription;
const results = data.results ?? [];

// Drafts are left out of the offerings list (content-model.md「Astro 實作」); JSON-LD names the same ones
const used = new Set((data.offerings ?? []).map((r) => r.id));
const offerings = await getCollection('offering', (o) => inLocale(o) && used.has(o.id));
const others = (await getCollection('case-study', (c) => inLocale(c) && c.id !== entry.id))
  .toSorted((a, b) => Number(b.data.industry === data.industry) - Number(a.data.industry === data.industry))
  .slice(0, 3)
  .map(caseCard);

const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
const site = Astro.site;
const image = data.ogImage ?? data.coverImage;
const jsonLd = caseStudyJsonLd({
  caseStudy: data,
  org: org.data,
  site,
  url: canonicalUrl(Astro.url.pathname, site),
  inLanguage: locale,
  trail,
  ...(image ? { imageUrl: new URL(image.src, site).href } : {}),
  offerings: offerings.map((o) => ({ kind: o.data.kind, name: o.data.title, url: new URL(nodeEntryPath(o), site).href })),
});
const stagger = (i: number) => (i % 3) as 0 | 1 | 2;
// Migrated cases have only the Markdown body (M5-03, #28), so the challenge part is left out and
// the approach part is numbered 01
const approachIndex = data.challenge ? '02' : '01';
---

<PageLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  type="article"
  image={image && { src: image.src, width: image.width, height: image.height, alt: data.title }}
  jsonLd={jsonLd}
  translations={translations}
>
  <PageHero eyebrow={industryTitle(data.industry, locale)} title={data.title} description={client}>
    <Breadcrumb slot="breadcrumb" node="case-study" current={data.title} />
    {
      data.client.disclosed && data.client.logo && (
        <Image slot="actions" class="logo" src={data.client.logo} alt={data.client.name} height={48} />
      )
    }
    {data.coverImage && <Image slot="visual" class="cover" src={data.coverImage} alt="" widths={[560, 1120]} sizes="(width >= 64rem) 34rem, 100vw" loading="eager" />}
  </PageHero>

  {
    results.length > 0 && (
      <Surface tone="dark" pattern="grid">
        <SectionHeading eyebrow="Results" title={t.caseStudy.results} />
        <CardGrid>
          {results.map((r, i) => (
            <li>
              <Reveal delay={stagger(i)}>
                <Card title={r.value} description={r.label} />
              </Reveal>
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  <Surface tone="light" width="reading">
    {
      data.challenge && (
        <section class="part">
          <SectionHeading index="01" eyebrow="Challenge" title={t.caseStudy.challenge} />
          <Prose><p>{data.challenge}</p></Prose>
        </section>
      )
    }
    <section class="part">
      <SectionHeading index={approachIndex} eyebrow="Approach" title={t.caseStudy.solution} />
      <Prose>
        {data.solution && <p>{data.solution}</p>}
        <Content />
      </Prose>
    </section>
  </Surface>

  {
    offerings.length > 0 && (
      <Surface tone="dark">
        <SectionHeading eyebrow="Used" title={t.caseStudy.offerings} />
        <CardGrid>
          {offerings.map((o) => (
            <li>
              <Card title={o.data.title} href={nodeEntryPath(o)} description={o.data.description} />
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  {
    others.length > 0 && (
      <Surface tone="dark" pattern="grid">
        <SectionHeading eyebrow="More stories" title={t.caseStudy.others} />
        <CardGrid>
          {others.map((c, i) => (
            <li>
              <Reveal delay={stagger(i)}>
                <Card title={c.title} href={c.href} eyebrow={c.eyebrow} description={c.description} image={c.image} />
              </Reveal>
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  <ContactCta />
</PageLayout>

<style>
  .logo {
    inline-size: auto;
    block-size: var(--logo-height-lg);
  }

  .cover {
    max-inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .part + .part {
    margin-block-start: var(--space-16);
  }

  .part {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
