---
// person template (M4-04, #23): an ESG advisor, from a person entry. Structure follows
// the M3-01 person wireframe (#14): photo beside name, job title and affiliation; expertise tags; experience,
// education and certifications side by side; back to the ESG advisory page and contact.
// Photos need a usage permit before M5 (wireframe note), so a person without one has no visual.
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Surface from '../../components/ui/Surface.astro';
import TagList from '../../components/ui/TagList.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ContactCta from '../../components/ui/ContactCta.astro';
import { entryTrail, localNode, node, nodeHref } from '../../lib/ia/navigation';
import { entryLocale } from '../../lib/content/entries';
import { entryPath } from '../../lib/content/urls';
import { personJsonLd } from '../../lib/seo/jsonld/person';
import { canonicalUrl, titleSeparator } from '../../lib/seo/meta';
import { strings } from '../../data/strings';

interface Props {
  entry: CollectionEntry<'person'>;
  translations?: readonly string[];
}

const { entry, translations } = Astro.props;
const { data } = entry;
const locale = entryLocale(entry.id);
const t = strings(locale);
const trail = entryTrail('esg-advisor', { title: data.title, path: entryPath('person', entry) }, locale);
const team = localNode(node('esg-advisor').parent, locale);
const lists = [
  { title: t.person.experience, items: data.experience ?? [] },
  { title: t.person.education, items: data.education ?? [] },
  { title: t.person.certifications, items: data.certifications ?? [] },
].filter((l) => l.items.length > 0);
const role = [data.jobTitle, data.affiliation].filter(Boolean).join(titleSeparator(locale));

const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
const site = Astro.site;
const image = data.ogImage ?? data.photo;
const jsonLd = personJsonLd({
  person: data,
  org: org.data,
  site,
  url: canonicalUrl(Astro.url.pathname, site),
  inLanguage: locale,
  trail,
  ...(data.photo ? { imageUrl: new URL(data.photo.src, site).href } : {}),
});
---

<PageLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  image={image && { src: image.src, width: image.width, height: image.height, alt: data.title }}
  jsonLd={jsonLd}
  translations={translations}
>
  <PageHero eyebrow={team.title} title={data.title} description={role}>
    <Breadcrumb slot="breadcrumb" node="esg-advisor" current={data.title} />
    {data.photo && <Image slot="visual" class="photo" src={data.photo} alt={data.title} widths={[320, 640]} sizes="20rem" loading="eager" />}
  </PageHero>

  <Surface tone="light">
    {
      data.expertise && (
        <section class="expertise">
          <SectionHeading eyebrow="Expertise" title={t.person.expertise} />
          <TagList items={data.expertise} tone="node" />
        </section>
      )
    }
    {
      lists.length > 0 && (
        <div class="lists">
          {lists.map((l) => (
            <section>
              <h2 class="list-title">{l.title}</h2>
              <ul>
                {l.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
    <div class="back">
      <Button href={nodeHref(team.id, locale)} variant="secondary">{t.person.backToTeam}</Button>
    </div>
  </Surface>

  <ContactCta />
</PageLayout>

<style>
  @import '../../styles/media.css';

  .photo {
    inline-size: 100%;
    max-inline-size: var(--portrait-max-width);
    block-size: auto;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .expertise {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .lists {
    display: grid;
    gap: var(--space-10);
    margin-block-start: var(--space-16);
  }

  .list-title {
    margin: 0 0 var(--space-4);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-width) solid var(--color-border-brand);
    font-size: var(--font-size-h4);
    line-height: var(--line-height-snug);
  }

  .lists ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding-inline-start: var(--space-6);
    color: var(--color-text-muted);
  }

  .back {
    margin-block-start: var(--space-16);
  }

  @media (--bp-lg-up) {
    .lists {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
