---
// hub template (M4-04, #23): products overview, product families, industries, services overview and
// resources, from a hub entry. Structure follows the M3-01 hub wireframe (#14): intro, highlights (industry hubs),
// child page cards from nodes.csv, whitepapers, case studies, related posts, contact.
// A dark narrative page like the offering template, with the static hero image and no 3D scene.
// Child cards take their description from the child's own entry when it has one.
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Surface from '../../components/ui/Surface.astro';
import Card from '../../components/ui/Card.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import Reveal from '../../components/ui/Reveal.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ContactCta from '../../components/ui/ContactCta.astro';
import { breadcrumb, children, localeHref, localNode, node } from '../../lib/ia/navigation';
import { entryLocale, isPublished } from '../../lib/content/entries';
import { caseCard, postCard } from '../../lib/content/cards';
import { hubJsonLd } from '../../lib/seo/jsonld/hub';
import { canonicalUrl } from '../../lib/seo/meta';
import { strings } from '../../data/strings';
import image from '../../assets/design/hero-modular-stack.webp';
import mobile from '../../assets/design/hero-modular-stack-mobile.webp';

interface Props {
  entry: CollectionEntry<'hub'>;
  translations?: readonly string[];
}

const { entry, translations } = Astro.props;
const { data } = entry;
const locale = entryLocale(entry.id);
const t = strings(locale);
const href = localeHref(locale);
const self = localNode(data.node, locale);
const inLocale = (e: { id: string; data: { draft: boolean } }) => entryLocale(e.id) === locale && isPublished(e);

// Child cards: pages and external entries (the resources hub lists 昕力大學), not groups or assets
const described = new Map(
  [...(await getCollection('offering', inLocale)), ...(await getCollection('hub', inLocale))].map((e) => [e.data.node, e.data.description]),
);
const parts = children(self.id, locale)
  .filter((n) => n.kind === 'page' || n.kind === 'external')
  .map((n) => ({ ...n, href: href(n), description: described.get(n.id) }));
const highlights = data.highlights ?? [];
const whitepapers = (await getCollection('whitepaper', (w) => inLocale(w) && w.data.offeringNode === self.id)).map((w) => ({
  title: w.data.title,
  cover: w.data.coverImage,
  href: href(node(w.data.node)),
}));
// featuredCaseStudies, else (industry hubs) the case studies of the hub's industry; drafts left out
const featured = new Set(data.featuredCaseStudies?.map((r) => r.id));
const cases = (
  await getCollection('case-study', (c) => inLocale(c) && (featured.size ? featured.has(c.id) : !!data.industry && c.data.industry === data.industry))
).map(caseCard);
const featuredPosts = new Set(data.featuredPosts?.map((r) => r.id));
const posts = (await getCollection('blog', (b) => inLocale(b) && featuredPosts.has(b.id))).map(postCard);

const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
const site = Astro.site;
const pageImage = data.heroImage ?? data.ogImage;
const ogImage = pageImage && { src: pageImage.src, width: pageImage.width, height: pageImage.height, alt: data.title };
const jsonLd = hubJsonLd({
  hub: data,
  org: org.data,
  site,
  url: canonicalUrl(Astro.url.pathname, site),
  inLanguage: locale,
  trail: breadcrumb(self.id, locale),
  parts: parts.flatMap((p) => (p.href && p.kind === 'page' ? [{ name: p.title, url: new URL(p.href, site).href }] : [])),
});

const stagger = (i: number) => (i % 3) as 0 | 1 | 2;
---

<PageLayout title={data.seoTitle ?? data.title} description={data.description} image={ogImage} jsonLd={jsonLd} translations={translations}>
  <PageHero eyebrow={localNode(self.parent, locale).title} title={data.title} description={data.tagline ?? data.description}>
    <Breadcrumb slot="breadcrumb" node={self.id} />
    <Backdrop slot="backdrop" image={image} mobile={mobile} fade="hero" focus="end" priority />
  </PageHero>

  {
    highlights.length > 0 && (
      <Surface tone="dark" pattern="grid">
        <SectionHeading eyebrow="Highlights" title={t.hub.highlights} />
        <CardGrid>
          {highlights.map((h, i) => (
            <li>
              <Reveal delay={stagger(i)}>
                <Card title={h.title} index={String(i + 1).padStart(2, '0')} description={h.body} />
              </Reveal>
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  {
    parts.length > 0 && (
      <Surface tone="dark">
        <SectionHeading eyebrow="Explore" title={t.hub.parts} />
        <CardGrid>
          {parts.map((p, i) => (
            <li>
              <Reveal delay={stagger(i)}>
                <Card title={p.title} href={p.href} eyebrow={self.title} description={p.description} size={p.description ? 'md' : 'sm'} />
              </Reveal>
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  {
    whitepapers.length > 0 && (
      <Surface tone="dark">
        <SectionHeading eyebrow="Whitepapers" title={t.hub.whitepapers} />
        <CardGrid>
          {whitepapers.map((w) => (
            <li>
              <Card title={w.title} href={w.href} eyebrow={localNode('resources', locale).title} image={{ src: w.cover, alt: '' }} />
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  {
    cases.length > 0 && (
      <Surface tone="dark" pattern="grid">
        <SectionHeading eyebrow="Success stories" title={localNode('success-stories', locale).title} />
        <CardGrid>
          {cases.map((c, i) => (
            <li>
              <Reveal delay={stagger(i)}>
                <Card title={c.title} href={c.href} eyebrow={c.eyebrow} description={c.description} image={c.image} />
              </Reveal>
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  {
    posts.length > 0 && (
      <Surface tone="light">
        <SectionHeading eyebrow="Insights" title={t.relatedPosts} />
        <CardGrid>
          {posts.map((p, i) => (
            <li>
              <Reveal delay={stagger(i)}>
                <Card title={p.title} href={p.href} eyebrow={p.eyebrow} image={p.image} date={p.date} />
              </Reveal>
            </li>
          ))}
        </CardGrid>
      </Surface>
    )
  }

  <ContactCta />
</PageLayout>
