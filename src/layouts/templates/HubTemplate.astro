---
// hub template (M4-04, #23): products overview, product families, industries, services overview and
// resources, from a hub entry. Structure follows the M3-01 hub wireframe (#14): intro, highlights (industry hubs),
// child page cards from nodes.csv, whitepapers, case studies, related posts, contact.
// Light paper like every page (ribbon-route, #167). A hub whose brief asks for more than highlights
// gives `sections` (heading, body, fact items linking to pages, a link on); an industry hub also lists
// the offerings whose use cases name its industry (content-model.md「hub」).
// Child cards take their description from the child's own entry when it has one.
// An entry with `sections` is laid out by its brief, section by section (#187, PageSections), and
// leaves out the products-by-industry list (its sections link to the offerings). No cards (#187):
// highlights are claims with their facts, child pages, whitepapers and posts index rows, cases rows.
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Surface from '../../components/ui/Surface.astro';
import Button from '../../components/ui/Button.astro';
import CaseList from '../../components/ui/CaseList.astro';
import IndexList from '../../components/ui/IndexList.astro';
import MapPicture from '../../components/ui/MapPicture.astro';
import PageSections from '../../components/ui/PageSections.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ContactCta from '../../components/ui/ContactCta.astro';
import FactRow from '../../components/ui/FactRow.astro';
import Link from '../../components/ui/Link.astro';
import InPageNav from '../../components/ui/InPageNav.astro';
import { breadcrumb, children, contactAction, localeHref, localNode, node, nodeHref } from '../../lib/ia/navigation';
import type { PictureName } from '../../lib/scene/ribbon/labels';
import { entryPath } from '../../lib/content/urls';
import { linkedNodes } from '../../lib/content/sections';
import { nodes } from '../../lib/ia/nodes';
import { entryLocale, isPublished } from '../../lib/content/entries';
import { postCard } from '../../lib/content/cards';
import { hubJsonLd } from '../../lib/seo/jsonld/hub';
import { canonicalUrl } from '../../lib/seo/meta';
import { strings } from '../../data/strings';

interface Props {
  entry: CollectionEntry<'hub'>;
  translations?: readonly string[];
}

const { entry, translations } = Astro.props;
const { data } = entry;
const locale = entryLocale(entry.id);
const t = strings(locale);
const href = localeHref(locale);
const self = localNode(data.node, locale);
const inLocale = (e: { id: string; data: { draft: boolean } }) => entryLocale(e.id) === locale && isPublished(e);

// Child cards: pages and external entries (the resources hub lists 昕力大學), not groups or assets
const described = new Map(
  [...(await getCollection('offering', inLocale)), ...(await getCollection('hub', inLocale))].map((e) => [e.data.node, e.data.description]),
);
const sections = data.sections ?? [];
const heroPoints = (data.heroPoints ?? []).map((p) => (typeof p === 'string' ? { text: p } : p));
const heroPicture = data.heroImage && data.heroLabels ? (data.heroImage.src.split('/').pop()?.split('.')[0] as PictureName | undefined) : undefined;
// Pages a section already links to aren't listed again as child pages
const linkedInSections = linkedNodes(sections);
// The child pages (content-model.md「hub」: hasPart is every child page, whether or not a section
// already links to it); the index rows leave out the ones a section links to
const childPages = children(self.id, locale)
  .filter((n) => n.kind === 'page' || n.kind === 'external')
  .flatMap((n) => {
    const to = href(n);
    return to ? [{ ...n, href: to, description: described.get(n.id) }] : [];
  });
const omitted = new Set(data.omitParts);
const parts = childPages.filter((n) => !linkedInSections.has(n.id) && !omitted.has(n.id));
// The sub-pages are the page's main entry until it is laid out by sections, which then lead (#226)
const partsWeight = sections.length ? 'secondary' : 'primary';
// Industry hubs: the offerings whose use cases name the industry, in nodes.csv order
const industryOfferings =
  data.industry && !sections.length
  ? (await getCollection('offering', (o) => inLocale(o) && !!o.data.useCases?.some((u) => u.industry === data.industry)))
      .map((o) => localNode(o.data.node, locale))
      .toSorted((a, b) => nodes.findIndex((n) => n.id === a.id) - nodes.findIndex((n) => n.id === b.id))
      .flatMap((n) => {
        const to = href(n);
        return to ? [{ title: n.title, href: to, body: described.get(n.id) }] : [];
      })
  : [];
const highlights = (data.highlights ?? []).map((h) => ({ ...h, href: h.link ? href(node(h.link.node)) : undefined }));
const whitepapers = (await getCollection('whitepaper', (w) => inLocale(w) && w.data.offeringNode === self.id)).flatMap((w) => {
  const to = href(node(w.data.node));
  return to ? [{ title: w.data.title, image: w.data.coverImage, href: to }] : [];
});
// featuredCaseStudies, else (industry hubs) the case studies of the hub's industry; drafts left out
const featured = new Set(data.featuredCaseStudies?.map((r) => r.id));
const caseEntries = await getCollection(
  'case-study',
  (c) => inLocale(c) && (featured.size ? featured.has(c.id) : !!data.industry && c.data.industry === data.industry),
);
// featuredCaseStudies order, when given
const ordered = featured.size ? [...featured].flatMap((id) => caseEntries.filter((c) => c.id === id)) : caseEntries;
// Rows of cases: the brief's caseNotes when the entry has them (client, work, result, award), else
// the case studies. A row's title is its client and its link's label the case's or news article's own
// title: CaseList puts the two on two lines of one heading link (design-principles.md「案例列」, #210)
const allCases = await getCollection('case-study');
const caseLink = (id: string) => {
  const c = allCases.find((e) => e.id === id);
  return c && { label: c.data.title, href: entryPath('case-study', c) };
};
// A case told in a news article (#202): linked by the article's title
const allNews = data.caseNotes?.some((n) => n.news) ? await getCollection('news') : [];
const newsLink = (id: string) => {
  const n = allNews.find((e) => e.id === id);
  return n && { label: n.data.title, href: entryPath('news', n) };
};
const caseRows = data.caseNotes
  ? data.caseNotes.map((n) => ({ title: n.client ?? n.work, work: n.client ? n.work : undefined, result: n.result, award: n.award, fragment: n.fragment, link: n.caseStudy ? caseLink(n.caseStudy.id) : n.news ? newsLink(n.news.id) : undefined }))
  : ordered.map((c) => ({ title: c.data.client.disclosed ? c.data.client.name : c.data.clientDescription, link: { label: c.data.title, href: entryPath('case-study', c) } }));
const featuredPosts = new Set(data.featuredPosts?.map((r) => r.id));
const posts = (await getCollection('blog', (b) => inLocale(b) && featuredPosts.has(b.id))).map(postCard);

// A hub laid out by sections gets the in-page bar (design-principles.md「內頁共用的規則」頁內導覽)
const anchors = sections.length
  ? [
      ...sections.flatMap((sec) => (sec.id ? [{ href: `#${sec.id}`, label: sec.heading }] : [])),
      ...(caseRows.length ? [{ href: '#cases', label: localNode('success-stories', locale).title }] : []),
    ]
  : [];

const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
const site = Astro.site;
const pageImage = data.heroImage ?? data.ogImage;
const ogImage = pageImage && { src: pageImage.src, width: pageImage.width, height: pageImage.height, alt: data.title };
const trail = breadcrumb(self.id, locale);
const jsonLd = hubJsonLd({
  hub: data,
  org: org.data,
  site,
  url: canonicalUrl(Astro.url.pathname, site),
  inLanguage: locale,
  trail,
  parts: childPages.flatMap((p) => (p.kind === 'page' ? [{ name: p.title, url: new URL(p.href, site).href }] : [])),
});

---

<PageLayout searchTrail={trail} title={data.seoTitle ?? data.title} description={data.description} image={ogImage} jsonLd={jsonLd} translations={translations}>
  {anchors.length > 0 && <InPageNav slot="nav" label={t.toc} items={anchors} />}
  <PageHero title={data.title} description={data.tagline ?? data.description} lead={data.heroLead} points={heroPoints}>
    <Breadcrumb slot="breadcrumb" node={self.id} />
    {
      data.heroCta && (
        <Fragment slot="actions">
          <Button href={nodeHref('contact', locale)} size="lg">
            {contactAction(locale)}
          </Button>
        </Fragment>
      )
    }
    {
      data.heroImage &&
        (heroPicture ? (
          <MapPicture slot="visual" image={data.heroImage} picture={heroPicture} labels={data.heroLabels} priority />
        ) : (
          <Image slot="visual" class="hero-image" src={data.heroImage} widths={[640, 960, 1280]} sizes="(width >= 64rem) 36rem, 100vw" alt="" priority />
        ))
    }
  </PageHero>

  <PageSections sections={sections} locale={locale} />

  {
    highlights.length > 0 && (
      <Surface tone="light">
        <FactRow title={t.hub.highlights}>
          {highlights.map((h) => (
            <li>
              <h3 class="item-title">{h.title}</h3>
              <p class="item-body">{h.body}</p>
              {h.link && h.href && (
                <p class="item-link">
                  <Link href={h.href} variant="standalone">
                    {h.link.label}
                  </Link>
                </p>
              )}
            </li>
          ))}
        </FactRow>
      </Surface>
    )
  }

  {
    industryOfferings.length > 0 && (
      <Surface tone="light">
        <SectionHeading title={localNode('products', locale).title} weight="secondary" />
        <IndexList items={industryOfferings} />
      </Surface>
    )
  }

  {
    parts.length > 0 && (
      <Surface tone="light">
        <SectionHeading title={data.partsTitle ?? t.hub.parts} weight={partsWeight} />
        <IndexList weight={partsWeight} items={parts.map((p) => ({ title: p.title, href: p.href, body: p.description }))} />
      </Surface>
    )
  }

  {
    whitepapers.length > 0 && (
      <Surface tone="light">
        <SectionHeading title={t.hub.whitepapers} weight="secondary" />
        <IndexList items={whitepapers} />
      </Surface>
    )
  }

  {
    caseRows.length > 0 && (
      <Surface tone="light" id="cases" class="anchor-target">
        <SectionHeading title={localNode('success-stories', locale).title} description={data.caseNotes ? undefined : data.casesIntro} />
        <CaseList items={caseRows} linkHeading words={t.layout} more={{ label: t.layout.allCases, href: nodeHref('success-stories', locale) }} />
        {
          data.testimonial && (
            <figure class="testimonial">
              <blockquote>
                <p>{data.testimonial.quote}</p>
              </blockquote>
              <figcaption>{data.testimonial.speaker}</figcaption>
            </figure>
          )
        }
      </Surface>
    )
  }

  {
    posts.length > 0 && (
      <Surface tone="light">
        <SectionHeading title={t.relatedPosts} weight="secondary" />
        <IndexList items={posts.map((p) => ({ title: p.title, href: p.href, image: p.image?.src, date: p.date }))} />
      </Surface>
    )
  }

  <ContactCta title={data.contactTitle} />
</PageLayout>

<style>
  .item-title {
    margin: 0 0 var(--space-1);
    font-size: var(--font-size-base);
    line-height: var(--line-height-snug);
  }

  .item-body {
    margin: 0;
  }

  .item-link {
    margin: var(--space-2) 0 0;
  }

  .hero-image {
    inline-size: 100%;
    block-size: auto;
  }

  /* A customer's words after the cases, quieter than the cases themselves (new-finance D3, #187): body
     text in the lead size and the full text colour (#208), the speaker under it as muted meta, no
     portrait */
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-inline-size: var(--reading-max-width);
    margin: var(--space-8) 0 0;
  }

  .testimonial blockquote {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-snug);
  }

  .testimonial p {
    margin: 0;
  }

  figcaption {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
