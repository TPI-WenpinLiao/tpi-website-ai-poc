---
// content template (M4-04, #23): 關於我們, 合作夥伴 and the legal pages, from a page entry. A light
// reading page (design-system「設計方向」). Structure follows the M3-01 content wireframe (#14): title block, the
// sections' table of contents, then the Markdown body and the sections with their items. Legal
// pages show their effective date and the PDF under the title.
// The table of contents is the in-page bar (InPageNav), as on offering pages, listed only with two
// sections or more.
import type { CollectionEntry } from 'astro:content';
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Surface from '../../components/ui/Surface.astro';
import Card from '../../components/ui/Card.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import InPageNav from '../../components/ui/InPageNav.astro';
import Button from '../../components/ui/Button.astro';
import Prose from '../../components/ui/Prose.astro';
import { breadcrumb, localNode } from '../../lib/ia/navigation';
import { entryLocale } from '../../lib/content/entries';
import { pageJsonLd } from '../../lib/seo/jsonld/page';
import { isoDate } from '../../lib/seo/jsonld/shared';
import { canonicalUrl } from '../../lib/seo/meta';
import { strings } from '../../data/strings';

interface Props {
  entry: CollectionEntry<'page'>;
  translations?: readonly string[];
}

const { entry, translations } = Astro.props;
const { data } = entry;
const locale = entryLocale(entry.id);
const t = strings(locale);
const self = localNode(data.node, locale);
const { Content } = await render(entry);
const sections = (data.sections ?? []).map((s, i) => ({ ...s, id: `section-${i + 1}`, paragraphs: s.body.split(/\n\s*\n/) }));
const anchors = sections.length > 1 ? sections.map((s) => ({ href: `#${s.id}`, label: s.heading })) : [];
const effective = data.effectiveDate && isoDate(data.effectiveDate);

const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
const pageImage = data.heroImage ?? data.ogImage;
const ogImage = pageImage && { src: pageImage.src, width: pageImage.width, height: pageImage.height, alt: data.title };
const trail = breadcrumb(self.id, locale);
const jsonLd = pageJsonLd({
  page: data,
  org: org.data,
  site: Astro.site,
  url: canonicalUrl(Astro.url.pathname, Astro.site),
  inLanguage: locale,
  trail,
  logoUrl: new URL(org.data.logo.src, Astro.site).href,
});
---

<PageLayout searchTrail={trail} title={data.seoTitle ?? data.title} description={data.description} image={ogImage} jsonLd={jsonLd} translations={translations}>
  {anchors.length > 0 && <InPageNav slot="nav" label={t.toc} items={anchors} />}
  <PageHero tone="light" size="compact" title={data.title} description={data.description}>
    <Breadcrumb slot="breadcrumb" node={self.id} />
    {
      (effective || data.pdf) && (
        <Fragment slot="actions">
          {effective && (
            <p class="meta">
              {t.content.effectiveDate}
              <time datetime={effective}>{effective.replaceAll('-', '/')}</time>
            </p>
          )}
          {data.pdf && (
            <Button href={data.pdf} variant="secondary">
              {t.content.pdf}
            </Button>
          )}
        </Fragment>
      )
    }
    {data.heroImage && <Image slot="visual" class="hero-image" src={data.heroImage} alt="" loading="eager" />}
  </PageHero>

  <Surface tone="light" width="reading">
    {
      entry.body?.trim() && (
        <Prose>
          <Content />
        </Prose>
      )
    }
    {
      sections.map((s) => (
        <section id={s.id} class="section anchor-target">
          <SectionHeading title={s.heading} />
          <Prose>
            {s.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </Prose>
          {s.items && (
            <CardGrid cols={2}>
              {s.items.map((item) => (
                <li>
                  <Card title={item.title} description={item.body} image={item.image && { src: item.image, alt: '' }} />
                </li>
              ))}
            </CardGrid>
          )}
        </section>
      ))
    }
  </Surface>
</PageLayout>

<style>
  .meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: 0;
    color: var(--color-text-muted);
  }

  .hero-image {
    max-inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Space between sections, not above the first */
  .section:not(:first-child) {
    margin-block-start: var(--space-16);
  }

</style>
