---
// Home page, direction B Modular Stack (M3-04, #17; built from the M3-07 prototype). Structure
// follows the approved home wireframe (/wireframes/home).
// The hero and the product-family chapters form the scene track: the static hero image is the LCP
// and the complete fallback, and the 3D scene (Scene3D, ADR 0003) plays behind the chapters as
// they scroll. Names, paths and order come from docs/ia (src/lib/ia/navigation.ts); copy comes
// from the current site through src/data/home.ts.
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import Scene3D from '../components/ui/Scene3D.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import Surface from '../components/ui/Surface.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import LayerStack from '../components/ui/LayerStack.astro';
import Reveal from '../components/ui/Reveal.astro';
import SceneChapter from '../components/ui/SceneChapter.astro';
import ContactCta from '../components/ui/ContactCta.astro';
import { children, header, node, type NavItem } from '../lib/ia/navigation';
import { latest } from '../lib/latest-posts';
import { SCENE_FAMILIES } from '../lib/scene/families';
import { homeJsonLd } from '../lib/seo/jsonld/home';
import { localeFromPath, normalizePath } from '../lib/i18n/paths';
import { getEntry } from 'astro:content';
import { cases, familyLines, hero, industryLines, orientAi } from '../data/home';
import image from '../assets/design/hero-modular-stack.webp';
import mobile from '../assets/design/hero-modular-stack-mobile.webp';
import coverData from '../assets/design/cover-data.webp';
import coverIntegration from '../assets/design/cover-integration.webp';
import coverPlatform from '../assets/design/cover-platform.webp';

const title = 'TPIsoftware 昕力資訊｜以頂尖科技為企業賦能';
const description =
  '昕力資訊以客戶利益為導向，致力於提供創新技術及軟體解決方案：AI、數位轉型、資安、ESG 與能源四個產品家族，以及委外、雲端整合、UI/UX 設計與 ESG 顧問等服務。';

// Products are the ones the header lists, in its order (navigation.csv, e.g. OrientAI first).
// Products left out of the navigation are 待確認 whether they are still sold (nodes.csv note,
// sitemap.md decision 2), so the home page doesn't show them either.
const flatten = (items: NavItem[]): string[] => items.flatMap((i) => [i.key, ...flatten(i.children)]);
const navOrder = flatten(header);
// Card headings drop the brand in brackets: nodes.csv titles such as 「AI（SysTalk.ai）」 show as 「AI」
// One chapter per family, in the scene's module order
const families = SCENE_FAMILIES.map((id) => {
  const family = node(id);
  return {
    id,
    heading: family.title.replace(/（[^）]*）$/, ''),
    brand: /（([^）]*)）$/.exec(family.title)?.[1],
    href: family.path,
    line: familyLines[id]?.text,
    products: children(id)
      .filter((p) => navOrder.includes(p.id))
      .toSorted((a, b) => navOrder.indexOf(a.id) - navOrder.indexOf(b.id)),
  };
});
// A space between Chinese and an adjoining Latin letter, on that side only (「看 AI 產品家族」,
// 「看 ESG 與能源產品家族」)
const spaced = (word: string) => `${/^[A-Za-z]/.test(word) ? ' ' : ''}${word}${/[A-Za-z]$/.test(word) ? ' ' : ''}`;
const contact = node('contact');
const products = node('products');

const orient = node(orientAi.node);
const industries = children('industries').map((n) => ({ ...n, line: industryLines[n.id]?.text }));
const services = children('services');
const successStories = node('success-stories');
const caseCards = cases.map((c) => ({ ...c, href: node(c.node).path }));
// Wireframe: two blog posts and one news item. Covers are the abstract placeholders until M5
// migrates the posts with their own images; decorative, so alt is empty.
const COVERS = [coverData, coverIntegration, coverPlatform];
const posts = [...latest('blog', 2), ...latest('news', 1)].map((p, i) => ({ ...p, cover: COVERS[i % COVERS.length] }));
const blog = node('blog');
const news = node('media-center');
// Structured data from the organization data file of this page's locale
const locale = localeFromPath(normalizePath(Astro.url.pathname));
const org = await getEntry('organization', locale);
if (!org) throw new Error(`src/content/organization/${locale}.yaml is missing`);
if (!Astro.site) throw new Error('astro.config.mjs must set site for JSON-LD URLs');
const jsonLd = homeJsonLd({
  org: org.data,
  site: Astro.site,
  logoUrl: new URL(org.data.logo.src, Astro.site).href,
  inLanguage: locale,
});

// Reveal staggers each row of a three-column grid
const stagger = (i: number) => (i % 3) as 0 | 1 | 2;
---

<PageLayout title={title} titleSuffix={false} description={description} jsonLd={jsonLd}>
  <div class="track" data-scene-track>
    <PageHero eyebrow="TPIsoftware 昕力資訊" title={hero.title.text} description={hero.description.text}>
      <Backdrop slot="backdrop" image={image} mobile={mobile} fade="hero" focus="end" priority />
      <Scene3D slot="backdrop" direction="modular-stack" />
      <Fragment slot="actions">
        <Button href={contact.path} size="lg">{contact.title}</Button>
        <Button href={products.path} size="lg" variant="secondary">{products.title}</Button>
      </Fragment>
    </PageHero>

    <section aria-labelledby="families-title">
      <h2 id="families-title" class="sr-only">產品家族</h2>
      {
        families.map((f, i) => (
          <SceneChapter>
            <SectionHeading
              level={3}
              index={String(i + 1).padStart(2, '0')}
              eyebrow={f.brand ?? 'Product family'}
              title={f.heading}
              description={f.line}
            />
            <ul class="items">
              {f.products.map((p) => (
                <li class="text-phrase">
                  <a href={p.path}>{p.title}</a>
                </li>
              ))}
            </ul>
            <Link href={f.href}>看{spaced(f.heading)}產品家族</Link>
          </SceneChapter>
        ))
      }
    </section>
  </div>

  <Surface tone="dark" pattern="grid">
    <div class="spotlight">
      <div class="spotlight-copy">
        <SectionHeading eyebrow={orientAi.eyebrow.text} title={orientAi.title.text} />
        <ul class="features" aria-label="OrientAI 特色">
          {
            orientAi.features.map((f) => (
              <li>
                <Tag tone="node">{f.text}</Tag>
              </li>
            ))
          }
        </ul>
        <Button href={orient.path} size="lg">{orientAi.action.text}</Button>
      </div>
      <LayerStack layers={5} />
    </div>
  </Surface>

  <!-- The wireframe's three entry points (industries, services, success stories) share one surface -->
  <Surface tone="dark">
    <div class="blocks">
      <div>
        <SectionHeading eyebrow="Industries" title={node('industries').title} />
        <ul class="cards cols-3">
          {
            industries.map((n, i) => (
              <li>
                <Reveal delay={stagger(i)}>
                  <Card title={n.title} href={n.path} description={n.line} />
                </Reveal>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <SectionHeading eyebrow="Services" title={node('services').title} />
        <ul class="cards cols-3 compact">
          {
            services.map((n, i) => (
              <li>
                <Reveal delay={stagger(i)}>
                  <Card title={n.title} href={n.path} size="sm" />
                </Reveal>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <div class="section-head">
          <SectionHeading eyebrow="Success stories" title={successStories.title} />
          <Button href={successStories.path} variant="secondary">所有{successStories.title}</Button>
        </div>
        <ul class="cards cols-3">
          {
            caseCards.map((c, i) => (
              <li>
                <Reveal delay={stagger(i)}>
                  <Card title={c.title.text} href={c.href} eyebrow={successStories.title} description={c.summary.text} />
                </Reveal>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Surface>

  <Surface tone="light">
    <div class="section-head">
      <SectionHeading eyebrow="Insights" title="最新文章與新聞" />
      <div class="section-links">
        <Button href={blog.path} variant="text">{blog.title}</Button>
        <Button href={news.path} variant="text">{news.title}</Button>
      </div>
    </div>
    <ul class="cards cols-3">
      {
        posts.map((p, i) => (
          <li>
            <Reveal delay={stagger(i)}>
              <Card title={p.title} href={p.href} eyebrow={p.label} image={{ src: p.cover, alt: '' }}>
                {p.published && (
                  <time slot="meta" datetime={p.published}>
                    {p.published.replaceAll('-', '/')}
                  </time>
                )}
              </Card>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </Surface>

  <ContactCta />
</PageLayout>

<style>
  @import '../styles/media.css';

  /* One product per row: equal-width rows on a hairline grid, so long names wrap under their own
     first line instead of making uneven pills */
  /* Two columns keep the panel short: the AI family has ten products, and on narrow screens the
     panel must leave the upper part of the viewport to the scene */
  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
    align-self: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .items li {
    display: grid;
    grid-template-columns: var(--space-2) minmax(0, 1fr);
    gap: var(--space-2);
    align-items: center;
    /* Every row draws both lines and overlaps the one above */
    border-block: var(--border-width) solid var(--glass-border);
    margin-block-start: calc(var(--border-width) * -1);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-snug);
  }

  .items li::before {
    content: '';
    block-size: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    box-shadow: var(--glow-accent);
  }

  .items a {
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: var(--color-text);
    text-decoration: none;
  }

  .items a:hover {
    color: var(--color-link-hover);
  }

  /* OrientAI spotlight: copy on the start side, the CSS 3D stack on the end side */
  .spotlight {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .spotlight-copy {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-8);
  }

  .features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-section);
  }

  /* Card grids: one column on phones; compact (services) keeps two short cards per row */
  .cards {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Cards in a row share the tallest one's height, through Reveal's wrapper */
  .cards > li,
  .cards > li > :global(*),
  .cards :global(.card) {
    block-size: 100%;
  }

  .compact {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: end;
    justify-content: space-between;
  }

  .section-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }


  @media (--bp-sm-up) {
    .cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .compact {
      gap: var(--space-6);
    }
  }

  @media (--bp-lg-up) {
    .cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .spotlight {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .items {
      column-gap: var(--space-6);
    }

    .items li {
      font-size: var(--font-size-sm);
    }
  }
</style>
