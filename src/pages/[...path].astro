---
// Every page built from content or from nodes.csv, other than the home and 404 pages (ADR 0002):
// - one per published collection entry, in the entry's locale. Node-based entries (offering, hub,
//   page, whitepaper) live at their nodes.csv path and the node's template picks the layout; blog,
//   news, case-study and person entries fill their collection node's path (src/lib/content/urls.ts)
// - listing, contact and utility nodes in every locale with interface copy (src/data/strings);
//   listings are split into pages at {path}/page/{n}. The contact page takes the locale's `page`
//   entry for its node when there is one
// - a download page per offering with downloads (/download/{product})
// Static pages in src/pages win over this route.
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { node } from '../lib/ia/navigation';
import { duplicates, entryLocale, isPublished, translationPaths } from '../lib/content/entries';
import OfferingTemplate from '../layouts/templates/OfferingTemplate.astro';
import HubTemplate from '../layouts/templates/HubTemplate.astro';
import ContentTemplate from '../layouts/templates/ContentTemplate.astro';
import GatedDownloadTemplate from '../layouts/templates/GatedDownloadTemplate.astro';
import ArticleTemplate from '../layouts/templates/ArticleTemplate.astro';
import CaseStudyTemplate from '../layouts/templates/CaseStudyTemplate.astro';
import PersonTemplate from '../layouts/templates/PersonTemplate.astro';
import ListingTemplate from '../layouts/templates/ListingTemplate.astro';
import ContactTemplate from '../layouts/templates/ContactTemplate.astro';
import UtilityTemplate from '../layouts/templates/UtilityTemplate.astro';
import { nodes } from '../lib/ia/nodes';
import { isUtilityPage, UTILITY_ELSEWHERE, type UtilityPage } from '../lib/ia/utility';
import { LOCALES, type Locale } from '../lib/i18n/locales';
import { localizePath } from '../lib/i18n/paths';
import { listing } from '../lib/content/listings';
import { pagePath, paginate } from '../lib/content/entries';
import type { EntryCard } from '../lib/content/cards';
import { hasStrings } from '../data/strings';
import { entryPath, nodeEntryPath } from '../lib/content/urls';

type Page =
  | { kind: 'offering'; entry: CollectionEntry<'offering'> }
  | { kind: 'hub'; entry: CollectionEntry<'hub'> }
  | { kind: 'page'; entry: CollectionEntry<'page'> }
  | { kind: 'whitepaper'; entry: CollectionEntry<'whitepaper'> }
  | { kind: 'blog'; entry: CollectionEntry<'blog'> }
  | { kind: 'news'; entry: CollectionEntry<'news'> }
  | { kind: 'case-study'; entry: CollectionEntry<'case-study'> }
  | { kind: 'person'; entry: CollectionEntry<'person'> }
  | { kind: 'listing'; id: string; locale: Locale; items: EntryCard[]; featured: EntryCard | undefined; page: number; pages: number }
  | { kind: 'contact'; locale: Locale; entry: CollectionEntry<'page'> | undefined }
  | { kind: 'utility'; id: UtilityPage; locale: Locale }
  | { kind: 'download'; entry: CollectionEntry<'offering'> };
type Props = Page & { translations: string[] };

export const getStaticPaths = (async () => {
  // Listing, contact and utility pages: no entry, so a locale has them once its interface copy exists
  async function nodePages() {
    const locales = LOCALES.filter(hasStrings);
    const versions = (path: string, locale: Locale) => locales.filter((l) => l !== locale).map((l) => localizePath(path, l));
    const utilities = nodes.filter((n) => n.template === 'utility' && !(UTILITY_ELSEWHERE as readonly string[]).includes(n.id));
    const unknown = utilities.filter((n) => !isUtilityPage(n.id)).map((n) => n.id);
    if (unknown.length) throw new Error(`utility nodes without a UtilityTemplate page: ${unknown.join(', ')} (src/lib/ia/utility.ts)`);
    const out = [];
    for (const locale of locales) {
      for (const n of nodes.filter((n) => n.template === 'listing')) {
        const { items, featured } = await listing(n.id, locale);
        const pages = paginate(items);
        const listPath = localizePath(n.path, locale);
        out.push(
          ...pages.map((pageItems, i) => {
            const path = pagePath(listPath, i + 1);
            return {
              params: { path: path.slice(1) },
              props: {
                kind: 'listing',
                id: n.id,
                locale,
                items: pageItems,
                featured: i === 0 ? featured : undefined,
                page: i + 1,
                pages: pages.length,
                translations: versions(path, locale),
              } satisfies Props,
            };
          }),
        );
      }
      const contact = localizePath(node('contact').path, locale);
      const entry = (await getCollection('page', (e) => e.data.node === 'contact' && entryLocale(e.id) === locale && isPublished(e)))[0];
      out.push({ params: { path: contact.slice(1) }, props: { kind: 'contact', locale, entry, translations: versions(contact, locale) } satisfies Props });
      for (const id of utilities.map((n) => n.id).filter(isUtilityPage)) {
        const path = localizePath(node(id).path, locale);
        out.push({ params: { path: path.slice(1) }, props: { kind: 'utility', id, locale, translations: versions(path, locale) } satisfies Props });
      }
    }
    return out;
  }

  const route = <E extends { id: string; data: { translationKey: string; draft: boolean } }>(
    all: E[],
    pathOf: (e: E) => string,
    page: (e: E) => Page,
  ) =>
    all.filter(isPublished).map((e) => ({
      params: { path: pathOf(e).slice(1) },
      props: { ...page(e), translations: translationPaths(e, all, pathOf) } satisfies Props,
    }));
  const paths = [
    ...route(await getCollection('offering'), nodeEntryPath, (entry) => ({ kind: 'offering', entry })),
    ...route(await getCollection('hub'), nodeEntryPath, (entry) => ({ kind: 'hub', entry })),
    // The contact page is built with the other node pages below (nodePages), entry or not
    ...route(await getCollection('page', (e) => node(e.data.node).template === 'content'), nodeEntryPath, (entry) => ({ kind: 'page', entry })),
    ...route(await getCollection('whitepaper'), nodeEntryPath, (entry) => ({ kind: 'whitepaper', entry })),
    ...route(await getCollection('blog'), (e) => entryPath('blog', e), (entry) => ({ kind: 'blog', entry })),
    ...route(await getCollection('news'), (e) => entryPath('news', e), (entry) => ({ kind: 'news', entry })),
    ...route(await getCollection('case-study'), (e) => entryPath('case-study', e), (entry) => ({ kind: 'case-study', entry })),
    ...route(await getCollection('person'), (e) => entryPath('person', e), (entry) => ({ kind: 'person', entry })),
    ...(await nodePages()),
    ...route(
      await getCollection('offering', (o) => (o.data.downloads ?? []).length > 0),
      (e) => localizePath(node('download').path.replace('{product}', e.data.node), entryLocale(e.id)),
      (entry) => ({ kind: 'download', entry }),
    ),
  ];
  // Two pages on one URL would leave only one built (a blog slug named like a category, say)
  const clashes = duplicates(paths.map((p) => p.params.path));
  if (clashes.length) throw new Error(`more than one page builds to: /${clashes.join(', /')}`);
  return paths;
}) satisfies GetStaticPaths;

const page = Astro.props;
---

{page.kind === 'offering' && <OfferingTemplate entry={page.entry} translations={page.translations} />}
{page.kind === 'hub' && <HubTemplate entry={page.entry} translations={page.translations} />}
{page.kind === 'page' && <ContentTemplate entry={page.entry} translations={page.translations} />}
{page.kind === 'whitepaper' && <GatedDownloadTemplate entry={page.entry} translations={page.translations} />}
{page.kind === 'blog' && <ArticleTemplate kind="blog" entry={page.entry} translations={page.translations} />}
{page.kind === 'news' && <ArticleTemplate kind="news" entry={page.entry} translations={page.translations} />}
{page.kind === 'case-study' && <CaseStudyTemplate entry={page.entry} translations={page.translations} />}
{page.kind === 'person' && <PersonTemplate entry={page.entry} translations={page.translations} />}
{
  page.kind === 'listing' && (
    <ListingTemplate id={page.id} locale={page.locale} items={page.items} featured={page.featured} page={page.page} pages={page.pages} translations={page.translations} />
  )
}
{page.kind === 'contact' && <ContactTemplate locale={page.locale} entry={page.entry} translations={page.translations} />}
{page.kind === 'utility' && <UtilityTemplate kind={page.id} locale={page.locale} translations={page.translations} />}
{page.kind === 'download' && <UtilityTemplate kind="download" offering={page.entry} translations={page.translations} />}
