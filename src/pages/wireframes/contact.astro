---
import WfLayout from '../../layouts/WfLayout.astro';
import WfSection from '../../components/wireframe/WfSection.astro';
import WfBlock from '../../components/wireframe/WfBlock.astro';
import WfGrid from '../../components/wireframe/WfGrid.astro';
import WfBreadcrumb from '../../components/wireframe/WfBreadcrumb.astro';
---

<WfLayout
  template="contact"
  title="contact 模板"
  description="聯絡我們 wireframe：本站主要轉換。桌機左側聯絡表單、右側據點與聯絡資訊；行動版表單在前。"
>
  <p slot="notes">表單欄位取自 <code>docs/research/features.md</code>「聯絡我們」；據點資料來自 <code>organization</code> 資料檔。防垃圾機制與端點由 M6 決定。</p>

  <WfBreadcrumb node="contact" />

  <WfBlock size="sm" label="標題區" fields={['title（h1）', 'description']} />

  <WfGrid cols={2} mobile={1}>
    <WfBlock
      size="hero"
      label="聯絡表單"
      fields={['姓名*', '電話*', 'Email*', '公司*', '諮詢產品（複選）*', '主旨*', '需求說明', '個資同意']}
      note="送出後到感謝頁"
    />
    <div class="stack">
      <WfSection title="據點">
        {[1, 2].map(() => <WfBlock size="sm" label="據點" fields={['organization：地址', '電話']} />)}
      </WfSection>
      <WfBlock size="sm" label="其他聯絡方式" fields={['organization：contactPoint']} note="地圖嵌入是否保留待確認" />
    </div>
  </WfGrid>
</WfLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stack :global(.wf-section) {
    margin-block-start: 0;
  }
</style>
