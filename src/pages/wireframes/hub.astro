---
import WfLayout from '../../layouts/WfLayout.astro';
import WfSection from '../../components/wireframe/WfSection.astro';
import WfBlock from '../../components/wireframe/WfBlock.astro';
import WfGrid from '../../components/wireframe/WfGrid.astro';
import WfBreadcrumb from '../../components/wireframe/WfBreadcrumb.astro';
import { children } from '../../lib/wireframe/ia';

const sample = children('family-dx');
---

<WfLayout
  template="hub"
  title="hub 模板"
  description="總覽頁 wireframe：產品總覽、產品家族、產業方案、服務總覽與資源頁共用。介紹區之後是由 nodes.csv 推出的子頁卡片，再接相關案例與文章。"
>
  <p slot="notes">範例節點：數位轉型（DigiLism）。子頁卡片由 <code>nodes.csv</code> 的 parent 推出，不在 frontmatter 列。</p>

  <WfBreadcrumb node="family-dx" />

  <WfBlock size="hero" label="介紹區" fields={['title（h1）', 'tagline', 'description', 'heroImage']} />

  <WfSection title="重點" note="產業頁才有（金融、政府頁承接開放銀行、開放政府的內容）；其他 hub 沒填就不顯示">
    <WfGrid cols={3} mobile={1}>
      {[1, 2, 3].map(() => <WfBlock size="sm" label="重點" fields={['highlights[].title', 'highlights[].body']} />)}
    </WfGrid>
  </WfSection>

  <WfSection title="子頁卡片" note="家族頁列產品，產品總覽列家族，產業方案總覽列產業，資源頁列部落格、白皮書、活動、昕力大學">
    <WfGrid cols={3} mobile={1}>
      {sample.map((n) => <WfBlock label={n.title} fields={['title', 'description']} note="連到產品頁" />)}
    </WfGrid>
  </WfSection>

  <WfSection title="白皮書" note="由 whitepaper.offeringNode 反查，有才顯示">
    <WfBlock size="sm" label="白皮書卡片" fields={['coverImage', 'title']} />
  </WfSection>

  <WfSection title="成功案例" note="featuredCaseStudies；產業頁沒填時用 industry 反查">
    <WfGrid cols={3} mobile={1}>
      {[1, 2, 3].map(() => <WfBlock label="案例卡片" fields={['client', 'industry', 'title']} />)}
    </WfGrid>
  </WfSection>

  <WfSection title="相關文章">
    <WfGrid cols={3} mobile={1}>
      {[1, 2, 3].map(() => <WfBlock label="文章卡片" fields={['coverImage', 'title', 'publishedAt']} />)}
    </WfGrid>
  </WfSection>

  <WfSection title="CTA">
    <WfBlock label="聯絡業務" note="連到聯絡我們" />
  </WfSection>
</WfLayout>
