---
import WfLayout from '../../layouts/WfLayout.astro';
import WfSection from '../../components/wireframe/WfSection.astro';
import WfBlock from '../../components/wireframe/WfBlock.astro';
import WfGrid from '../../components/wireframe/WfGrid.astro';
import WfBreadcrumb from '../../components/wireframe/WfBreadcrumb.astro';
---

<WfLayout
  template="content"
  title="content 模板"
  description="文字為主的頁面 wireframe：關於我們、合作夥伴與 4 個法務頁共用。標題區、桌機側邊目錄與分段內文；法務頁另有生效日與 PDF 下載。"
>
  <p slot="notes">範例節點：關於我們。法務頁沒有 heroImage，標題區下方顯示 <code>effectiveDate</code> 與 <code>pdf</code> 下載連結。</p>

  <WfBreadcrumb node="about" />

  <WfBlock size="hero" label="標題區" fields={['title（h1）', 'description', 'heroImage']} />

  <div class="layout">
    <WfBlock size="lg" label="頁內目錄" fields={['sections[].heading']} note="桌機固定在側邊；行動版收在標題區下方" />
    <div class="body">
      {
        [1, 2, 3].map(() => (
          <WfSection title="段落標題（sections[].heading）">
            <WfBlock label="段落內文" fields={['sections[].body']} />
            <WfGrid cols={3} mobile={1}>
              {[1, 2, 3].map(() => (
                <WfBlock size="sm" label="項目" fields={['items[].title', 'items[].body', 'items[].image']} />
              ))}
            </WfGrid>
          </WfSection>
        ))
      }
    </div>
  </div>
</WfLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--space-8);
    align-items: start;
  }

  /* 64rem breakpoint, see tokens.css */
  @media (max-width: 63.99rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
