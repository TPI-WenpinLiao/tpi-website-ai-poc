---
import WfLayout from '../../layouts/WfLayout.astro';
import WfSection from '../../components/wireframe/WfSection.astro';
import WfBlock from '../../components/wireframe/WfBlock.astro';
import WfGrid from '../../components/wireframe/WfGrid.astro';
import WfBreadcrumb from '../../components/wireframe/WfBreadcrumb.astro';
---

<WfLayout
  template="offering"
  title="offering 模板"
  description="產品、解決方案與服務頁 wireframe：hero 與主要 CTA，接功能、應用情境、成功案例、下載、FAQ 與相關文章。"
>
  <p slot="notes">範例節點：digiRunner API 管理平台。各區塊對應的欄位沒填時整區不顯示。</p>

  <WfBreadcrumb node="digirunner" />

  <WfGrid cols={2} mobile={1}>
    <WfBlock
      size="hero"
      label="Hero 文字"
      fields={['title（h1）', 'tagline', 'description']}
      note="主要 CTA 依 cta 欄位：contact →「聯絡業務」、demo →「預約 demo」；次要 CTA 捲到功能區"
    />
    <WfBlock size="hero" label="Hero 圖" fields={['heroImage']} />
  </WfGrid>

  <WfBlock size="sm" label="頁內錨點列" note="功能／應用情境／案例／FAQ。捲動時是否固定在 header 下方，待確認" />

  <WfSection title="功能">
    <WfGrid cols={3} mobile={1}>
      {[1, 2, 3, 4, 5, 6].map(() => <WfBlock size="sm" label="功能" fields={['features[].icon', 'features[].title', 'features[].body']} />)}
    </WfGrid>
  </WfSection>

  <WfSection title="應用情境" note="industry 有值時顯示產業標籤，並連到對應的產業頁">
    <WfGrid cols={2} mobile={1}>
      {[1, 2].map(() => <WfBlock label="情境" fields={['useCases[].title', 'useCases[].body', 'useCases[].industry']} />)}
    </WfGrid>
  </WfSection>

  <WfSection title="相關產品" note="第四層子頁（例如 digiRunner on Cloud）從這裡連結，不進 header">
    <WfBlock size="sm" label="子頁連結" fields={['nodes.csv 子節點']} />
  </WfSection>

  <WfSection title="成功案例" note="relatedCaseStudies；留空時由 case-study.offerings 反查">
    <WfGrid cols={3} mobile={1}>
      {[1, 2, 3].map(() => <WfBlock label="案例卡片" fields={['client', 'industry', 'title']} />)}
    </WfGrid>
  </WfSection>

  <WfSection title="下載">
    <WfGrid cols={2} mobile={1}>
      <WfBlock size="sm" label="下載檔" fields={['downloads[].label', 'downloads[].file']} />
      <WfBlock size="sm" label="白皮書" fields={['whitepaper.offeringNode 反查']} />
    </WfGrid>
  </WfSection>

  <WfSection title="常見問題" note="手風琴；有 faq 時另輸出 FAQPage JSON-LD">
    {[1, 2, 3].map(() => <WfBlock size="sm" label="問題 ▾" fields={['faq[].question', 'faq[].answer']} />)}
  </WfSection>

  <WfSection title="相關文章" note="relatedPosts；留空時由 blog.relatedOfferings 反查">
    <WfGrid cols={3} mobile={1}>
      {[1, 2, 3].map(() => <WfBlock label="文章卡片" fields={['coverImage', 'title', 'publishedAt']} />)}
    </WfGrid>
  </WfSection>

  <WfSection title="CTA">
    <WfBlock label="聯絡業務／預約 demo" fields={['cta']} note="表單直接放在頁面、彈窗，或連到聯絡我們，由 M6 決定" />
  </WfSection>
</WfLayout>
