---
// Design-system showcase (M3-03, #16): every design token and every base component with its
// states. Not in navigation.csv or the sitemap.
// Tokens, their grouping (scripts/design/token-groups.mjs) and contrast ratios are read from
// tokens.css at build time, so they can't drift; showcase.mjs fails when a token is in no group.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Surface from '../../components/ui/Surface.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Reveal from '../../components/ui/Reveal.astro';
import ScrollProgress from '../../components/ui/ScrollProgress.astro';
import LayerStack from '../../components/ui/LayerStack.astro';
import Scene3D from '../../components/ui/Scene3D.astro';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';
import Tag from '../../components/ui/Tag.astro';
import LocaleSwitcher from '../../components/ui/LocaleSwitcher.astro';
import Card from '../../components/ui/Card.astro';
import SiteHeader from '../../components/ui/SiteHeader.astro';
import SiteFooter from '../../components/ui/SiteFooter.astro';
import FormField from '../../components/ui/FormField.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import InPageNav from '../../components/ui/InPageNav.astro';
import Faq from '../../components/ui/Faq.astro';
import SceneChapter from '../../components/ui/SceneChapter.astro';
import { Image } from 'astro:assets';
import tokensCss from '../../styles/tokens.css?raw';
import { parseSurfaces, resolveColor, checkPairs, contrastRatio, PAIRS } from '../../../scripts/design/contrast.mjs';
import { groupTokens, tokenNames, type Group } from '../../../scripts/design/token-groups.mjs';
import TokenGroup, { type Row } from './_TokenGroup.astro';
import heroDataFlow from '../../assets/design/hero-data-flow.webp';
import heroDataFlowMobile from '../../assets/design/hero-data-flow-mobile.webp';
import heroModularStack from '../../assets/design/hero-modular-stack.webp';
import heroModularStackMobile from '../../assets/design/hero-modular-stack-mobile.webp';
import ambientGlow from '../../assets/design/ambient-glow-1.webp';
import readingHeader from '../../assets/design/reading-header.webp';
import coverPlatform from '../../assets/design/cover-platform.webp';
import coverIntegration from '../../assets/design/cover-integration.webp';
import coverData from '../../assets/design/cover-data.webp';
import coverSecurity from '../../assets/design/cover-security.webp';

const surfaces = parseSurfaces(tokensCss);
const light = surfaces[0].tokens;
const { groups } = groupTokens(tokenNames(tokensCss));
const byLayer = (layer: Group['layer']) => groups.filter((g) => g.layer === layer);
const white = resolveColor(light, '--ink-0');
const black = resolveColor(light, '--ink-950');

/** Rows for one group on one surface; colors also get their literal value. */
const rows = (group: (typeof groups)[number], tokens: Map<string, string>, primitive = false): Row[] =>
  group.tokens.map(({ name, kind }) => {
    const value = tokens.get(name) ?? '';
    if (kind !== 'color') return { name, kind, value };
    const resolved = resolveColor(tokens, name);
    return primitive
      ? { name, kind, value, ratios: { light: contrastRatio(resolved, white), dark: contrastRatio(resolved, black) } }
      : { name, kind, value, resolved };
  });

// Dark first: it is the scene surface the narrative pages open on
const semantic = [...surfaces].reverse().map(({ name, tokens }) => ({
  name,
  tone: name === 'dark' ? ('dark' as const) : ('light' as const),
  groups: byLayer('semantic').map((g) => ({ ...g, rows: rows(g, tokens) })),
}));
const contrast = surfaces.flatMap(({ name, tokens }) => checkPairs(tokens, PAIRS).map((r) => ({ surface: name, ...r })));
const failed = contrast.filter((r) => !r.ok).length;

const principles = [
  { title: '場景與圖層', body: '深色 surface 是 3D 捲動場景的舞台，內容是浮在上面的玻璃圖層。閱讀為主的頁面改用亮色 surface。' },
  { title: '光標示資料與互動', body: '紫、品紅、橘的能量漸層與光點只用來標示流動、焦點與 hover，不當文字的底色。' },
  { title: '動態跟著捲動', body: '進場、圖層分離與進度條都由捲動驅動，不需要 client JS；偏好減少動態時全部靜止。' },
];

// States drawn statically with data-preview-state; components have no :active style to show
type PreviewState = 'hover' | 'focus' | undefined;
const linkStates: { label: string; preview: PreviewState }[] = [
  { label: '預設', preview: undefined },
  { label: 'Hover', preview: 'hover' },
  { label: 'Focus', preview: 'focus' },
];
const buttonStates: { label: string; preview: PreviewState; disabled?: boolean }[] = [
  ...linkStates,
  { label: 'Disabled', preview: undefined, disabled: true },
];
const buttonVariants = [
  { variant: 'primary', label: '主要按鈕' },
  { variant: 'secondary', label: '次要按鈕' },
  { variant: 'text', label: '文字按鈕' },
] as const;
const linkVariants = [
  { name: 'inline', variant: 'inline', label: '內文連結', external: false },
  { name: 'standalone', variant: 'standalone', label: '獨立連結', external: false },
  { name: 'inline + external', variant: 'inline', label: '外部連結', external: true },
] as const;
// zh-TW is the current page, en has this page, vi only has its home; hover and focus go on en
const localeDemo = (tone: 'dark' | 'light', preview?: PreviewState) => [
  { locale: 'zh-TW' as const, href: `#components-${tone}`, target: 'page' as const, current: true },
  { locale: 'en' as const, href: `#components-${tone}`, target: 'page' as const, current: false, preview },
  { locale: 'vi' as const, href: `#components-${tone}`, target: 'home' as const, current: false },
];
const tagTones = [
  { tone: 'neutral', label: '中性標籤' },
  { tone: 'brand', label: '品牌標籤' },
  { tone: 'node', label: 'Node label' },
] as const;

const toc = [
  { id: 'principles', label: '原則' },
  { id: 'tokens', label: '色階' },
  { id: 'tokens-dark', label: '語意（深）' },
  { id: 'tokens-light', label: '語意（亮）' },
  { id: 'tokens-scale', label: '尺度' },
  { id: 'components-dark', label: '元件（深）' },
  { id: 'components-light', label: '元件（亮）' },
  { id: 'chrome', label: '頁首與頁尾' },
  { id: 'imagery', label: '影像' },
  { id: 'reading', label: '長文' },
];

const title = 'Design system｜TPIsoftware 昕力資訊';
const description =
  'TPIsoftware 網站的 design tokens 與元件參考：原始色階、亮暗兩種 surface 的語意色彩、字體與間距等尺度，以及按鈕、連結、標籤、卡片、表單欄位的各種狀態。';
---

<BaseLayout title={title} description={description}>
  <ScrollProgress />
  <PageHero
    eyebrow="Design system"
    title="有景深的設計系統"
    description="為 3D 捲動場景設計的 tokens 與元件。本頁的標題區就是 PageHero，背後是方向 A 的靜態主視覺，3D 場景載入前與減少動態時都顯示這張圖。"
  >
    <Backdrop slot="backdrop" image={heroDataFlow} mobile={heroDataFlowMobile} fade="hero" focus="end" priority />
    <Fragment slot="actions">
      <Button href="#components-dark" size="lg">看元件</Button>
      <Button href="#tokens" size="lg" variant="secondary">看 tokens</Button>
    </Fragment>
  </PageHero>

  <InPageNav label="本頁目錄" stick="top" items={toc.map((t) => ({ href: `#${t.id}`, label: t.label }))} />

  <main>
    <Surface tone="dark" id="principles">
      <Backdrop slot="backdrop" image={ambientGlow} fade="bottom" strength="soft" />
      <SectionHeading index="01" eyebrow="Principles" title="三個設計原則" />
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li>
              <Reveal delay={i as 0 | 1 | 2}>
                <div class="panel">
                  <span class="panel-index">0{i + 1}</span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </Surface>

    <Surface tone="light" id="tokens">
      <SectionHeading
        index="02"
        eyebrow="Tokens · Primitives"
        title="Tokens：原始色階"
        description="tokens.css 的三層：primitive 是原始色值，只在 tokens.css 內被引用；元件用 semantic 與 scale。本頁的 token 清單在 build 時從 tokens.css 讀出。"
      />
      {byLayer('primitive').map((g) => <TokenGroup title={g.title} note={g.note} rows={rows(g, light, true)} layout="swatches" />)}
    </Surface>

    {
      semantic.map((s) => (
        <Surface tone={s.tone} pattern={s.tone === 'dark' ? 'grid' : 'none'} id={`tokens-${s.name}`}>
          <SectionHeading
            index={s.tone === 'dark' ? '03' : undefined}
            eyebrow={`Tokens · Semantic · ${s.name} surface`}
            title={s.tone === 'dark' ? 'Tokens：語意（深色 surface）' : 'Tokens：語意（亮色 surface）'}
            description={
              s.tone === 'dark'
                ? '敘事頁（首頁、產品、方案）的場景底色。同一組語意 token 名稱，在 data-surface="dark" 底下換成這些值。'
                : '閱讀頁（blog、法務、長文）的底色，也是 :root 的預設值。'
            }
          />
          {s.groups.map((g) => (
            <TokenGroup title={g.title} note={g.note} rows={g.rows} />
          ))}
          {s.tone === 'light' && (
            <details class="contrast">
              <summary>
                對比檢查（WCAG 2.2 AA）：{contrast.length - failed}/{contrast.length} 組通過
              </summary>
              <p class="note">
                文字 4.5:1、UI 元件與 focus ring 3:1。glass 以該 surface 最不利的背景（<code>--scene-worst</code>）合成後計算。與{' '}
                <code>npm run check:design</code> 同一份清單，任何一組不過 build 就失敗。
              </p>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Surface</th>
                      <th scope="col">前景</th>
                      <th scope="col">背景</th>
                      <th scope="col">對比</th>
                      <th scope="col">門檻</th>
                    </tr>
                  </thead>
                  <tbody>
                    {contrast.map((r) => (
                      <tr>
                        <td>{r.surface}</td>
                        <td><code>{r.fg}</code></td>
                        <td><code>{r.over ? `${r.bg} over ${r.over}` : r.bg}</code></td>
                        <td>{r.ratio.toFixed(2)}</td>
                        <td>{r.min}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
        </Surface>
      ))
    }

    <Surface tone="dark" id="tokens-scale">
      <SectionHeading
        index="04"
        eyebrow="Tokens · Scale"
        title="Tokens：尺度"
        description="字體、間距、圓角、線寬、動態、3D 場景與版面。兩個 surface 共用；偏好減少動態時，動態與傾斜相關的值歸零。"
      />
      {byLayer('scale').map((g) => <TokenGroup title={g.title} note={g.note} rows={rows(g, light)} />)}
    </Surface>


    {
      (['dark', 'light'] as const).map((tone) => (
        <Surface tone={tone} pattern={tone === 'dark' ? 'grid' : 'none'} id={`components-${tone}`}>
          <SectionHeading
            index={tone === 'dark' ? '05' : undefined}
            eyebrow={`Components · ${tone} surface`}
            title={tone === 'dark' ? '元件：深色 surface' : '元件：亮色 surface'}
            description="同一組元件，不需要變體，顏色跟著 surface 切換。hover 與 focus 欄是靜態畫出的狀態（data-preview-state），樣式和實際操作時同一份；示意欄不能操作，請用「預設」欄實際操作。範例文字只用來看版面，不是網站內容。"
          />

          <h3>Button</h3>
          <div class="table-wrap">
            <table class="matrix">
              <caption class="sr-only">Button 各 variant 的狀態。Hover、Focus 欄是靜態示意，不能操作。</caption>
              <thead>
                <tr>
                  <th scope="col">Variant</th>
                  {buttonStates.map((st) => <th scope="col">{st.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {buttonVariants.map((v) => (
                  <tr>
                    <th scope="row"><code>{v.variant}</code></th>
                    {buttonStates.map((st) => (
                      <td inert={st.preview !== undefined}>
                        <Button variant={v.variant} data-preview-state={st.preview} disabled={st.disabled}>
                          {v.label}
                        </Button>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note">尺寸 sm／md／lg，以及有 href 時輸出的連結（連結不能 disabled）：</p>
          <div class="row">
            <Button size="sm">小型</Button>
            <Button>中型</Button>
            <Button size="lg">大型</Button>
            <Button href={`#components-${tone}`} variant="secondary">
              連結樣式的按鈕
            </Button>
          </div>

          <h3>Link</h3>
          <div class="table-wrap">
            <table class="matrix">
              <caption class="sr-only">Link 各 variant 的狀態。Hover、Focus 欄是靜態示意，不能操作。</caption>
              <thead>
                <tr>
                  <th scope="col">Variant</th>
                  {linkStates.map((st) => <th scope="col">{st.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {linkVariants.map((v) => (
                  <tr>
                    <th scope="row"><code>{v.name}</code></th>
                    {linkStates.map((st) => (
                      <td inert={st.preview !== undefined}>
                        <Link href={v.external ? 'https://www.tpisoftware.com' : `#components-${tone}`} variant={v.variant} external={v.external} data-preview-state={st.preview}>
                          {v.label}
                        </Link>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3>Tag</h3>
          <div class="table-wrap">
            <table class="matrix">
              <caption class="sr-only">Tag 各 tone 的狀態。Hover、Focus 欄是靜態示意，不能操作。</caption>
              <thead>
                <tr>
                  <th scope="col">Tone</th>
                  {linkStates.map((st) => <th scope="col">{st.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {tagTones.map((t) => (
                  <tr>
                    <th scope="row"><code>{t.tone}</code></th>
                    <td><Tag tone={t.tone}>{t.label}</Tag></td>
                    <td colspan="2" class="muted">沒有 href 時不能互動</td>
                  </tr>
                ))}
                {tagTones.map((t) => (
                  <tr>
                    <th scope="row"><code>{t.tone}</code> + href</th>
                    {linkStates.map((st) => (
                      <td inert={st.preview !== undefined}>
                        <Tag href={`#components-${tone}`} tone={t.tone} data-preview-state={st.preview}>
                          {t.label}
                        </Tag>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3>LocaleSwitcher</h3>
          <div class="table-wrap">
            <table class="matrix">
              <caption class="sr-only">LocaleSwitcher 的狀態，以 English 示範。Hover、Focus 欄是靜態示意，不能操作。</caption>
              <thead>
                <tr>
                  {linkStates.map((st) => <th scope="col">{st.label}</th>)}
                </tr>
              </thead>
              <tbody>
                <tr>
                  {linkStates.map((st) => (
                    <td inert={st.preview !== undefined}>
                      <LocaleSwitcher label={`語言（${tone === 'dark' ? '深色' : '亮色'} surface 範例，${st.label}）`} links={localeDemo(tone, st.preview)} />
                    </td>
                  ))}
                </tr>
              </tbody>
            </table>
          </div>
          <p class="note">
            目前語系（中文）不用連結色。實際頁面上，該語系沒有這一頁時連到該語系首頁，連首頁都沒有的語系不列出；只剩目前語系時整個元件不輸出。
          </p>

          <h3>SectionHeading</h3>
          <div class="demo">
            <SectionHeading level={3} index="07" eyebrow="Eyebrow" title="編號式區塊標題" description="標題層級由呼叫端指定，避免跳級。" />
          </div>
          <div class="demo">
            <SectionHeading level={3} title="沒有編號與 eyebrow 的區塊標題" />
          </div>

          <h3>Card</h3>
          <ul class="cards">
            {linkStates.map((st, i) => (
              <li class="state" inert={st.preview !== undefined}>
                <span class="state-label">{st.label}</span>
                <Card
                  level={4}
                  href={`#components-${tone}`}
                  index={`0${i + 1}`}
                  eyebrow="分類"
                  title="有圖片的卡片標題"
                  description="hover 與 focus 時往前傾、亮起漸層外框。整張卡可點，但只有標題一個連結。"
                  image={{ src: coverIntegration, alt: '' }}
                  data-preview-state={st.preview}
                >
                  <Fragment slot="meta">
                    <Tag tone="node">Tag one</Tag>
                    <Tag tone="node">Tag two</Tag>
                  </Fragment>
                </Card>
              </li>
            ))}
            <li class="state">
              <span class="state-label">沒有圖片</span>
              <Card level={4} href={`#components-${tone}`} index="04" title="沒有圖片的卡片" description="玻璃面板，背景的格線與 3D 場景會透出來。" />
            </li>
            <li class="state">
              <span class="state-label">size="sm"</span>
              <Card level={4} href={`#components-${tone}`} title="只有標題的短卡片" size="sm" />
            </li>
            <li class="state">
              <span class="state-label">沒有 href</span>
              <Card level={4} index="06" title="不能點的卡片" description="功能、應用情境等不是連結的項目：沒有 hover 與 focus，meta 裡的標籤連結各自可點。">
                <Tag slot="meta" href={`#components-${tone}`} tone="brand">產業標籤連結</Tag>
              </Card>
            </li>
            <li class="state">
              <span class="state-label">長標題</span>
              <Card
                level={4}
                href={`#components-${tone}`}
                index="05"
                eyebrow="分類"
                title="標題較長時換行的卡片標題範例，用來確認行高與間距"
                image={{ src: coverData, alt: '' }}
              />
            </li>
          </ul>

          <h3>Breadcrumb</h3>
          <div class="demo">
            <Breadcrumb node="digirunner" label={`麵包屑（${tone === 'dark' ? '深色' : '亮色'} surface 範例）`} />
          </div>
          <p class="note">項目由 nodes.csv 的 parent 推出，group 節點略過；最後一項是目前頁面，不是連結。</p>

          <h3>Faq</h3>
          <ul class="faq-states">
            {[
              { label: '預設', preview: undefined },
              { label: 'Hover', preview: 'hover' as const },
              { label: 'Focus', preview: 'focus' as const },
            ].map((st) => (
              <li class="state" inert={st.preview !== undefined}>
                <span class="state-label">{st.label}</span>
                <Faq
                  data-preview-state={st.preview}
                  items={[
                    { question: '問題的標題，點一下展開答案', answer: '答案是純文字，來自內容檔的 faq 欄位。' },
                    { question: '第二個問題', answer: '每一題各自展開，不需要 client JS。' },
                  ]}
                />
              </li>
            ))}
          </ul>

          <h3>FormField</h3>
          <div class="fields">
            <FormField id={`${tone}-default`} name={`${tone}-default`} label="預設" kind="text" />
            <div inert>
              <FormField id={`${tone}-hover`} name={`${tone}-hover`} label="Hover（示意）" kind="text" data-preview-state="hover" />
            </div>
            <div inert>
              <FormField id={`${tone}-focus`} name={`${tone}-focus`} label="Focus（示意）" kind="text" data-preview-state="focus" />
            </div>
            <FormField id={`${tone}-filled`} name={`${tone}-filled`} label="已填寫" kind="email" value="name@example.com" />
            <FormField id={`${tone}-required`} name={`${tone}-required`} label="必填" kind="text" required />
            <FormField id={`${tone}-hint`} name={`${tone}-hint`} label="有說明文字" kind="email" hint="我們會寄送確認信到這個信箱。" />
            <FormField id={`${tone}-error`} name={`${tone}-error`} label="錯誤" kind="tel" value="abc" error="電話格式不正確，請只輸入數字。" />
            <FormField
              id={`${tone}-select`}
              name={`${tone}-select`}
              label="下拉選單"
              kind="select"
              placeholder="請選擇"
              options={[
                { value: 'a', label: '選項一' },
                { value: 'b', label: '選項二' },
              ]}
            />
            <FormField id={`${tone}-textarea`} name={`${tone}-textarea`} label="多行文字" kind="textarea" rows={3} />
            <FormField id={`${tone}-checkbox`} name={`${tone}-checkbox`} label="核取方塊" kind="checkbox" />
            <FormField id={`${tone}-checked`} name={`${tone}-checked`} label="已勾選的核取方塊" kind="checkbox" checked />
            <FormField id={`${tone}-checkbox-error`} name={`${tone}-checkbox-error`} label="核取方塊錯誤" kind="checkbox" required error="請勾選後再送出。" />
          </div>
          <p class="note">FormField 沒有 disabled 狀態；送出按鈕的 disabled 見 Button。</p>
        </Surface>
      ))
    }

    <Surface tone="dark" id="chrome">
      <SectionHeading
        eyebrow="Site chrome"
        title="頁首與頁尾"
        description="選單是原生的 details 展開，共用同一個 name，一次只開一個；點選單外或按 Esc 會收起（一小段 script）。寬度小於 64rem 時第一層收進「選單」。"
      />
      <h3>SiteHeader</h3>
      <div class="chrome-demo">
        <SiteHeader navLabel="主選單（展示：預設）" skipTo={false} />
      </div>
