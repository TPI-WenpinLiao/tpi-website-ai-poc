---
// M3-02 review page for the design tokens and base components. Not in navigation.csv or the
// sitemap; M3-03 (#16) extends this page into the full design-system showcase.
// Token lists and contrast ratios are read from tokens.css at build time, so they can't drift.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Surface from '../../components/ui/Surface.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Reveal from '../../components/ui/Reveal.astro';
import ScrollProgress from '../../components/ui/ScrollProgress.astro';
import LayerStack from '../../components/ui/LayerStack.astro';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';
import Tag from '../../components/ui/Tag.astro';
import Card from '../../components/ui/Card.astro';
import FormField from '../../components/ui/FormField.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import { Image } from 'astro:assets';
import tokensCss from '../../styles/tokens.css?raw';
import { parseSurfaces, resolveColor, checkPairs, PAIRS } from '../../../scripts/design/contrast.mjs';
import heroDataFlow from '../../assets/design/hero-data-flow.webp';
import heroDataFlowMobile from '../../assets/design/hero-data-flow-mobile.webp';
import heroModularStack from '../../assets/design/hero-modular-stack.webp';
import heroModularStackMobile from '../../assets/design/hero-modular-stack-mobile.webp';
import ambientGlow from '../../assets/design/ambient-glow-1.webp';
import readingHeader from '../../assets/design/reading-header.webp';
import coverPlatform from '../../assets/design/cover-platform.webp';
import coverIntegration from '../../assets/design/cover-integration.webp';
import coverData from '../../assets/design/cover-data.webp';
import coverSecurity from '../../assets/design/cover-security.webp';

const surfaces = parseSurfaces(tokensCss);
const light = surfaces[0].tokens;
const names = [...light.keys()];
const byPrefix = (prefix: string) => names.filter((n) => n.startsWith(prefix));
const colorNames = [...byPrefix('--color-'), '--glass-bg', '--glass-border'];
// Dark first: it is the scene surface the narrative pages open on
const swatches = [...surfaces].reverse().map(({ name, tokens }) => ({
  name,
  tone: name === 'dark' ? ('dark' as const) : ('light' as const),
  colors: colorNames.map((n) => ({ name: n, value: resolveColor(tokens, n) })),
}));
const contrast = surfaces.flatMap(({ name, tokens }) => checkPairs(tokens, PAIRS).map((r) => ({ surface: name, ...r })));
const failed = contrast.filter((r) => !r.ok).length;
const headingSizes = ['--font-size-display', '--font-size-h1', '--font-size-h2', '--font-size-h3', '--font-size-h4'];
const spaces = byPrefix('--space-');

const principles = [
  { title: '場景與圖層', body: '深色 surface 是 3D 捲動場景的舞台，內容是浮在上面的玻璃圖層。閱讀為主的頁面改用亮色 surface。' },
  { title: '光標示資料與互動', body: '紫、品紅、橘的能量漸層與光點只用來標示流動、焦點與 hover，不當文字的底色。' },
  { title: '動態跟著捲動', body: '進場、圖層分離與進度條都由捲動驅動，不需要 client JS；偏好減少動態時全部靜止。' },
];

const title = 'Design system 審核｜TPIsoftware 昕力資訊';
const description =
  'M3-02 design tokens 與基礎元件審核頁：亮暗兩種 surface、光與景深、字體與間距，以及按鈕、連結、卡片、表單與捲動動態的各種狀態。';
---

<BaseLayout title={title} description={description}>
  <ScrollProgress />
  <PageHero
    eyebrow="M3-02 · Design system"
    title="有景深的設計系統"
    description="為 3D 捲動場景設計的 tokens 與元件。本頁的標題區就是 PageHero，背後是方向 A 的靜態主視覺，3D 場景載入前與減少動態時都顯示這張圖。"
  >
    <Backdrop slot="backdrop" image={heroDataFlow} mobile={heroDataFlowMobile} fade="hero" focus="end" priority />
    <Fragment slot="actions">
      <Button href="#components-dark" size="lg">看元件</Button>
      <Button href="#color" size="lg" variant="secondary">看色彩</Button>
    </Fragment>
  </PageHero>

  <main>
    <Surface tone="dark">
      <Backdrop slot="backdrop" image={ambientGlow} fade="bottom" strength="soft" />
      <SectionHeading index="01" eyebrow="Principles" title="三個設計原則" />
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li>
              <Reveal delay={i as 0 | 1 | 2}>
                <div class="panel">
                  <span class="panel-index">0{i + 1}</span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </Surface>

    {
      swatches.map((s) => (
        <Surface tone={s.tone} id={s.tone === 'dark' ? 'color' : undefined}>
          <SectionHeading
            index={s.tone === 'dark' ? '02' : undefined}
            eyebrow={`Color · ${s.name} surface`}
            title={s.tone === 'dark' ? '色彩：深色 surface' : '色彩：亮色 surface'}
            description={
              s.tone === 'dark'
                ? '敘事頁（首頁、產品、方案）的場景底色。同一組語意 token 名稱，在 data-surface="dark" 底下換成這些值。'
                : '閱讀頁（blog、法務、長文）的底色，也是 :root 的預設值。'
            }
          />
          <ul class="swatches">
            {s.colors.map((c) => (
              <li class="swatch">
                <span class="chip" style={`background: var(${c.name})`} />
                <code>{c.name}</code>
                <span class="value">{c.value}</span>
              </li>
            ))}
          </ul>
          {s.tone === 'light' && (
            <details class="contrast">
              <summary>
                對比檢查（WCAG 2.2 AA）：{contrast.length - failed}/{contrast.length} 組通過
              </summary>
              <p class="note">
                文字 4.5:1、UI 元件與 focus ring 3:1。glass 以該 surface 最不利的背景（<code>--scene-worst</code>）合成後計算。與{' '}
                <code>npm run check:design</code> 同一份清單，任何一組不過 build 就失敗。
              </p>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Surface</th>
                      <th scope="col">前景</th>
                      <th scope="col">背景</th>
                      <th scope="col">對比</th>
                      <th scope="col">門檻</th>
                    </tr>
                  </thead>
                  <tbody>
                    {contrast.map((r) => (
                      <tr>
                        <td>{r.surface}</td>
                        <td><code>{r.fg}</code></td>
                        <td><code>{r.over ? `${r.bg} over ${r.over}` : r.bg}</code></td>
                        <td>{r.ratio.toFixed(2)}</td>
                        <td>{r.min}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
        </Surface>
      ))
    }

    <Surface tone="dark" pattern="grid">
      <SectionHeading index="03" eyebrow="Typography" title="字體" />
      <p class="note">
        Inter 做 display 與內文（大字級收緊字距），中文用系統字；JetBrains Mono 只用在編號、eyebrow 與資料標籤。
      </p>
      <ul class="type-scale">
        {
          headingSizes.map((name) => (
            <li>
              <code>{name}</code>
              <span class="type-sample" style={`font-size: var(${name})`}>
                昕力資訊 TPIsoftware
              </span>
            </li>
          ))
        }
        <li>
          <code>--font-size-lg / --font-size-base</code>
          <span class="lead">內文範例：中英混排的行距與字距，Latin text such as API management, Vietnamese such as giải pháp số.</span>
        </li>
        <li>
          <code>--font-mono</code>
          <span class="mono">01 · API GATEWAY · DATA FLOW · 2026</span>
        </li>
      </ul>
    </Surface>

    <Surface tone="dark">
      <SectionHeading index="04" eyebrow="Depth & light" title="景深與光" />
      <h3>三層景深</h3>
      <div class="depths">
        <div class="depth" style="box-shadow: var(--shadow-sm)"><code>--shadow-sm</code></div>
        <div class="depth" style="box-shadow: var(--shadow-md)"><code>--shadow-md</code></div>
        <div class="depth" style="box-shadow: var(--shadow-lg)"><code>--shadow-lg</code></div>
        <div class="depth" style="box-shadow: var(--glow-brand)"><code>--glow-brand</code></div>
        <div class="depth" style="box-shadow: var(--glow-accent)"><code>--glow-accent</code></div>
      </div>
      <h3>能量漸層</h3>
      <div class="energy" role="img" aria-label="紫、品紅、橘的能量漸層"></div>
      <h3>間距</h3>
      <ul class="spaces">
        {
          spaces.map((name) => (
            <li>
              <code>{name}</code>
              <span class="bar" style={`inline-size: var(${name})`} />
            </li>
          ))
        }
      </ul>
    </Surface>

    <Surface tone="dark" pattern="grid" id="imagery">
      <SectionHeading
        index="05"
        eyebrow="Imagery"
        title="影像"
        description="抽象 3D 渲染，只用品牌色，不放文字、人物或真實產品。素材與提示詞見 docs/design/image-prompts.md。"
      />
      <h3>主視覺：兩個 3D 方向的靜態版本</h3>
      <div class="directions">
        {
          [
            { title: '方向 A：Data Flow', image: heroDataFlow, mobile: heroDataFlowMobile, alt: '紫色與橘色光束連成的資料網路，光點沿著光束流向幾個發光節點' },
            { title: '方向 B：Modular Stack', image: heroModularStack, mobile: heroModularStackMobile, alt: '四片帶格線的霧面玻璃板上下堆疊，一道紫到橘的光束垂直穿過中心' },
          ].map((d) => (
            <figure class="direction">
              <Image src={d.image} alt={d.alt} widths={[640, 960, 1280]} sizes="(width >= 64rem) 36rem, 100vw" />
              <figcaption>
                <strong>{d.title}</strong>
                <span>桌機 16:9，手機改用 4:5 構圖（主體在上半部）。M3-07 選定方向後，這張圖是 3D 場景的 LCP 與減少動態時的版本。</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <h3>卡片封面</h3>
      <ul class="covers">
        {
          [
            { name: 'cover-platform', image: coverPlatform },
            { name: 'cover-integration', image: coverIntegration },
            { name: 'cover-data', image: coverData },
            { name: 'cover-security', image: coverSecurity },
          ].map((c) => (
            <li>
              <Image src={c.image} alt="" widths={[400, 800]} sizes="(width >= 64rem) 17rem, 50vw" />
              <code>{c.name}</code>
            </li>
          ))
        }
      </ul>
      <p class="note">封面是抽象意象，不代表特定產品功能，當作卡片沒有真實素材時的預設圖；裝飾用，alt 留空。</p>
      <h3>CSS 3D 圖層（LayerStack）</h3>
      <p class="note">同一個等角視角的 CSS 版本，不需要圖片，捲出畫面時圖層分開。用在不值得放一張大圖的區塊。</p>
      <LayerStack />
    </Surface>

    {
      (['dark', 'light'] as const).map((tone) => (
        <Surface tone={tone} pattern={tone === 'dark' ? 'grid' : 'none'} id={`components-${tone}`}>
          <SectionHeading
            index={tone === 'dark' ? '06' : undefined}
            eyebrow={`Components · ${tone} surface`}
            title={tone === 'dark' ? '元件：深色 surface' : '元件：亮色 surface'}
            description="同一組元件，不需要變體，顏色跟著 surface 切換。範例文字只用來看版面，不是網站內容。"
          />

          <h3>Button</h3>
          <div class="row">
            <Button>主要按鈕</Button>
            <Button variant="secondary">次要按鈕</Button>
            <Button variant="text">文字按鈕</Button>
            <Button disabled>停用</Button>
          </div>
          <div class="row">
            <Button size="sm">小型主要</Button>
            <Button size="sm" variant="secondary">小型次要</Button>
            <Button href={`#components-${tone}`} size="sm" variant="text">
              連結樣式的按鈕
            </Button>
          </div>

          <h3>Link 與 Tag</h3>
          <div class="row">
            <Link href={`#components-${tone}`}>內文連結</Link>
            <Link href={`#components-${tone}`} variant="standalone">獨立連結</Link>
            <Link href="https://www.tpisoftware.com" external>外部連結</Link>
          </div>
          <div class="row">
            <Tag>中性標籤</Tag>
            <Tag tone="brand">品牌標籤</Tag>
            <Tag tone="node">Node label</Tag>
            <Tag href={`#components-${tone}`} tone="brand">可點的標籤</Tag>
          </div>

          <h3>SectionHeading</h3>
          <div class="demo">
            <SectionHeading level={3} index="07" eyebrow="Eyebrow" title="編號式區塊標題" description="標題層級由呼叫端指定，避免跳級。" />
          </div>

          <h3>Card</h3>
          <div class="cards">
            <Reveal>
              <Card
                level={4}
                href={`#components-${tone}`}
                index="01"
                eyebrow="分類"
                title="有圖片的卡片標題"
                description="hover 時往前傾、亮起漸層外框。整張卡可點，但只有標題一個連結。"
                image={{ src: coverIntegration, alt: '' }}
              >
                <Fragment slot="meta">
                  <Tag tone="node">Tag one</Tag>
                  <Tag tone="node">Tag two</Tag>
                </Fragment>
              </Card>
            </Reveal>
            <Reveal delay={1}>
              <Card level={4} href={`#components-${tone}`} index="02" title="沒有圖片的卡片" description="玻璃面板，背景的格線與 3D 場景會透出來。" />
            </Reveal>
            <Reveal delay={2}>
              <Card
                level={4}
                href={`#components-${tone}`}
                index="03"
                eyebrow="分類"
                title="標題較長時換行的卡片標題範例，用來確認行高與間距"
                image={{ src: coverData, alt: '' }}
              />
            </Reveal>
          </div>

          <h3>FormField</h3>
          <form class="form" action="#" method="post">
            <FormField id={`${tone}-name`} name="name" label="姓名" kind="text" autocomplete="name" required />
            <FormField id={`${tone}-email`} name="email" label="Email" kind="email" autocomplete="email" required hint="我們會寄送確認信到這個信箱。" />
            <FormField
              id={`${tone}-topic`}
              name="topic"
              label="洽詢主題"
              kind="select"
              placeholder="請選擇"
              options={[
                { value: 'a', label: '選項一' },
                { value: 'b', label: '選項二' },
              ]}
            />
            <FormField id={`${tone}-phone`} name="phone" label="電話" kind="tel" autocomplete="tel" value="abc" error="電話格式不正確，請只輸入數字。" />
            <FormField id={`${tone}-message`} name="message" label="需求說明" kind="textarea" rows={4} />
            <FormField id={`${tone}-agree`} name="agree" label="我同意隱私權政策" kind="checkbox" required />
            <div class="row">
              <Button type="submit" disabled>送出（審核頁不送出）</Button>
            </div>
          </form>
        </Surface>
      ))
    }

    <Surface tone="light" width="reading">
      <Backdrop slot="backdrop" image={readingHeader} fade="bottom" focus="top" />
      <SectionHeading eyebrow="Reading" title="長文閱讀" />
      <div class="prose">
        <p>
          這是一段內文範例，用來檢視亮色 surface 的閱讀節奏：<code>--line-height-base</code> 下中英混排的行距、
          <code>--reading-max-width</code> 的行長，以及內文中的<Link href="#components-light">連結樣式</Link>。
        </p>
        <p>blog、法務與其他長文頁面使用這個 surface，不放 3D 場景，讓注意力留在文字上。</p>
      </div>
    </Surface>
  </main>
</BaseLayout>

<style>
  @import '../../styles/media.css';

  h3 {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-h4);
  }

  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  code {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .note {
    max-width: var(--reading-max-width);
    margin: 0;
    color: var(--color-text-muted);
  }

  .principles {
    display: grid;
    gap: var(--space-6);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    block-size: 100%;
    padding: var(--space-8);
    border: var(--border-width) solid var(--glass-border);
    border-radius: var(--radius-xl);
    background: var(--glass-bg);
    box-shadow: var(--shadow-md);
  }

  .panel h3 {
    margin: 0;
    font-size: var(--font-size-h3);
  }

  .panel p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .panel-index {
    color: var(--color-text-accent);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .swatches {
    display: grid;
    gap: var(--space-3);
  }

  .swatch {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-3);
  }

  .chip {
    grid-row: span 2;
    inline-size: var(--space-12);
    block-size: var(--space-12);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .value {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .contrast summary {
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
  }

  .contrast .note {
    margin-block: var(--space-3);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3);
    border-block-end: var(--border-width) solid var(--color-border);
    text-align: start;
    white-space: nowrap;
  }

  .type-scale li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .type-scale code {
    color: var(--color-text-muted);
  }

  .type-sample {
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
  }

  .lead {
    max-width: var(--reading-max-width);
    font-size: var(--font-size-lg);
  }

  .mono {
    color: var(--color-text-brand);
    font-family: var(--font-mono);
    letter-spacing: var(--letter-spacing-mono);
  }

  .depths {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .depth {
    display: grid;
    place-items: center;
    inline-size: var(--space-24);
    block-size: var(--space-24);
    padding: var(--space-2);
    border: var(--border-width) solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    text-align: center;
  }

  .energy {
    block-size: var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--gradient-energy);
    box-shadow: var(--glow-brand);
  }

  .spaces li {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    padding-block: var(--space-1);
  }

  .bar {
    block-size: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--gradient-energy);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .demo {
    padding: var(--space-6);
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .cards {
    display: grid;
    gap: var(--space-6);
  }

  .directions {
    display: grid;
    gap: var(--space-6);
  }

  .direction {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .direction img,
  .covers img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: var(--border-width) solid var(--glass-border);
    border-radius: var(--radius-lg);
  }

  .direction figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }

  .direction strong {
    color: var(--color-text);
  }

  .covers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .covers li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--reading-max-width);
  }

  .prose p {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-lg);
  }

  @media (--bp-sm-up) {
    .swatches,
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (--bp-lg-up) {
    .directions {
