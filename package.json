{
  "name": "tpi-website-ai-poc",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run check:ia && npm run test:scripts && astro check && astro build && npm run validate:html && npm run lighthouse",
    "check:ia": "node scripts/ia/sitemap.mjs --check && node scripts/ia/navigation.mjs --check",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "lighthouse": "node scripts/lhci-prepare.mjs && lhci autorun"
  },
  "dependencies": {
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@lhci/cli": "^0.15.1",
    "html-validate": "^11.16.4",
    "node-html-parser": "^9.0.5",
    "puppeteer-core": "^24.43.1",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
